// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: c0c0a1a1 at both session counts.
//
// A model of the end-to-end encryption scheme of Userbase, a database
// service in which the server stores ciphertext. Two users each derive a
// hierarchy from a password and add a device that reconstructs it.
//
// The items remain confidential, but this model admits a salt-substitution
// attack even at one session. The login token and seed-wrapping key use the
// same HKDF output and info. Replacing the wrapping salt with the public
// token salt makes the receiving device use the exposed login token as its
// decryption key. The attacker then supplies its own seed, database key and
// item, satisfying all three checked decryptions. This is a finding about
// this model; it does not establish how the deployed service separates keys.
// At two sessions, replaying another run's hierarchy is also possible.
//
// The password is declared `knows private`, an unguessable secret. Verifpal
// has no notion of a low-entropy value, so the model assumes the real
// scheme's slow password hashing (scrypt) has done its job; everything below
// descends from HASH(pass, salt) on that assumption.
//
// The hierarchy, top to bottom:
//
//   password ──HASH──► passwordHkdfKey ──┬─► passwordToken   (server sees)
//                                        └─► passwordBasedEncryptionKey
//   seed (random) ──HKDF──► masterKey ──┬─► encryptionKey  (wraps dbKey)
//                                       ├─► dhPrivateKey
//                                       └─► hmacKey
//   dbKey (random) encrypts the actual items.
//
// The distinct salts in the honest run do not enforce key separation at
// the receiving device, which accepts both salts from the wire. Binding a
// distinct purpose into HKDF's info would prevent this salt substitution;
// hkdf_salt_domain_separation.vp pins that counterweight.

attacker[active]

principal Server[]
principal UserA[]
principal UserA_OtherDevice[]
principal UserB[]
principal UserB_OtherDevice[]

principal UserA[
	// The password — see the header.
	knows private passA
	// The TRUE cryptographic root: a random seed. The password's only
	// job is to wrap and unwrap it.
	generates seedA
	generates passwordSaltA
	generates passwordTokenSaltA
	generates passwordBasedEncryptionKeySaltA
	passwordHashA = HASH(passA, passwordSaltA)
	passwordHkdfKeyA = HKDF(passwordHashA, nil, nil)
	// Two siblings with opposite destinies: the token is SENT to the
	// server as a login credential; the encryption key never leaves.
	passwordTokenA = HKDF(passwordHkdfKeyA, passwordTokenSaltA, nil)
	passwordBasedEncryptionKeyA = HKDF(passwordHkdfKeyA, passwordBasedEncryptionKeySaltA, nil)
	// Key wrapping: the seed, sealed under a password-derived key, safe
	// to park on an untrusted server.
	generates n_passwordEncryptedSeedA
	passwordEncryptedSeedA = AEAD_ENC(passwordBasedEncryptionKeyA, n_passwordEncryptedSeedA, seedA, nil)
]

principal UserA[
	// From the seed, a master key fans out into per-purpose keys. (The
	// DH and HMAC keys exist in Userbase for sharing and integrity; they
	// are derived here to model the full hierarchy.)
	masterKeyA = HKDF(seedA, nil, nil)
	generates encryptionKeySaltA
	generates dhKeySaltA
	generates hmacKeySaltA
	encryptionKeyA = HKDF(masterKeyA, encryptionKeySaltA, nil)
	dhPrivateKeyA = HKDF(masterKeyA, dhKeySaltA, nil)
	hmacKeyA = HKDF(masterKeyA, hmacKeySaltA, nil)
	publicKeyA = PUBKEY(dhPrivateKeyA)
]

// Signup: everything the server ever learns. Note what is in this list —
// the token, the salts (public by nature), and wrapped ciphertext — and
// what is not: no password, no seed, no encryption key.
UserA -> Server: passwordTokenA, publicKeyA, passwordSaltA, passwordTokenSaltA, encryptionKeySaltA, dhKeySaltA, hmacKeySaltA, passwordBasedEncryptionKeySaltA, n_passwordEncryptedSeedA, passwordEncryptedSeedA

principal UserB[
	knows private passB
	generates seedB
	generates passwordSaltB
	generates passwordTokenSaltB
	generates passwordBasedEncryptionKeySaltB
	passwordHashB = HASH(passB, passwordSaltB)
	passwordHkdfKeyB = HKDF(passwordHashB, nil, nil)
	passwordTokenB = HKDF(passwordHkdfKeyB, passwordTokenSaltB, nil)
	passwordBasedEncryptionKeyB = HKDF(passwordHkdfKeyB, passwordBasedEncryptionKeySaltB, nil)
	generates n_passwordEncryptedSeedB
	passwordEncryptedSeedB = AEAD_ENC(passwordBasedEncryptionKeyB, n_passwordEncryptedSeedB, seedB, nil)
]

principal UserB[
	masterKeyB = HKDF(seedB, nil, nil)
	generates encryptionKeySaltB
	generates dhKeySaltB
	generates hmacKeySaltB
	encryptionKeyB = HKDF(masterKeyB, encryptionKeySaltB, nil)
	dhPrivateKeyB = HKDF(masterKeyB, dhKeySaltB, nil)
	hmacKeyB = HKDF(masterKeyB, hmacKeySaltB, nil)
	publicKeyB = PUBKEY(dhPrivateKeyB)
]

UserB -> Server: passwordTokenB, publicKeyB, passwordSaltB, passwordTokenSaltB, encryptionKeySaltB, dhKeySaltB, hmacKeySaltB, passwordBasedEncryptionKeySaltB, n_passwordEncryptedSeedB, passwordEncryptedSeedB

// Storing data: a per-database key, itself wrapped under the hierarchy
// (another level of key wrapping), then the item under the database key.
principal UserA[
	generates dbKeyA
	generates n_encryptedDbKeyA
	encryptedDbKeyA = AEAD_ENC(encryptionKeyA, n_encryptedDbKeyA, dbKeyA, nil)
]

UserA -> Server: n_encryptedDbKeyA, encryptedDbKeyA

principal UserA[
	knows private itemA
	generates n_encryptedItemA
	encryptedItemA = AEAD_ENC(dbKeyA, n_encryptedItemA, itemA, nil)
]

UserA -> Server: n_encryptedItemA, encryptedItemA

principal UserB[
	generates dbKeyB
	generates n_encryptedDbKeyB
	encryptedDbKeyB = AEAD_ENC(encryptionKeyB, n_encryptedDbKeyB, dbKeyB, nil)
]

UserB -> Server: n_encryptedDbKeyB, encryptedDbKeyB

principal UserB[
	knows private itemB
	generates n_encryptedItemB
	encryptedItemB = AEAD_ENC(dbKeyB, n_encryptedItemB, itemB, nil)
]

UserB -> Server: n_encryptedItemB, encryptedItemB

// Adding a device: the server relays the stored blobs and public salts.
// Nothing in these two messages is sensitive on its own.
Server -> UserA_OtherDevice: n_encryptedItemA, encryptedItemA, n_encryptedDbKeyA, encryptedDbKeyA, n_passwordEncryptedSeedA, passwordEncryptedSeedA, passwordSaltA, passwordTokenSaltA, encryptionKeySaltA, passwordBasedEncryptionKeySaltA

Server -> UserB_OtherDevice: n_encryptedItemB, encryptedItemB, n_encryptedDbKeyB, encryptedDbKeyB, n_passwordEncryptedSeedB, passwordEncryptedSeedB, passwordSaltB, passwordTokenSaltB, encryptionKeySaltB, passwordBasedEncryptionKeySaltB

// The new device knows exactly one secret — the password — and re-derives
// the entire hierarchy: unwrap the seed, rebuild the master key, unwrap
// the database key, decrypt the item. Every unwrap is a checked (`?`)
// AEAD_DEC. These checks verify the supplied blobs under the derived keys;
// they cannot detect that an attacker-selected salt made a key public.
principal UserA_OtherDevice[
	knows private passA
	passwordHashA_ = HASH(passA, passwordSaltA)
	passwordHkdfKeyA_ = HKDF(passwordHashA_, nil, nil)
	passwordTokenA_ = HKDF(passwordHkdfKeyA_, passwordTokenSaltA, nil)
	passwordBasedEncryptionKeyA_ = HKDF(passwordHkdfKeyA_, passwordBasedEncryptionKeySaltA, nil)
	seedA_ = AEAD_DEC(passwordBasedEncryptionKeyA_, n_passwordEncryptedSeedA, passwordEncryptedSeedA, nil)?
	masterKeyA_ = HKDF(seedA_, nil, nil)
	encryptionKeyA_ = HKDF(masterKeyA_, encryptionKeySaltA, nil)
	dbKeyA_ = AEAD_DEC(encryptionKeyA_, n_encryptedDbKeyA, encryptedDbKeyA, nil)?
	itemA_ = AEAD_DEC(dbKeyA_, n_encryptedItemA, encryptedItemA, nil)?
]

principal UserB_OtherDevice[
	knows private passB
	passwordHashB_ = HASH(passB, passwordSaltB)
	passwordHkdfKeyB_ = HKDF(passwordHashB_, nil, nil)
	passwordTokenB_ = HKDF(passwordHkdfKeyB_, passwordTokenSaltB, nil)
	passwordBasedEncryptionKeyB_ = HKDF(passwordHkdfKeyB_, passwordBasedEncryptionKeySaltB, nil)
	seedB_ = AEAD_DEC(passwordBasedEncryptionKeyB_, n_passwordEncryptedSeedB, passwordEncryptedSeedB, nil)?
	masterKeyB_ = HKDF(seedB_, nil, nil)
	encryptionKeyB_ = HKDF(masterKeyB_, encryptionKeySaltB, nil)
	dbKeyB_ = AEAD_DEC(encryptionKeyB_, n_encryptedDbKeyB, encryptedDbKeyB, nil)?
	itemB_ = AEAD_DEC(dbKeyB_, n_encryptedItemB, encryptedItemB, nil)?
]

queries[
	confidentiality? itemA
	confidentiality? itemB
	authentication? Server -> UserA_OtherDevice: encryptedItemA
	authentication? Server -> UserB_OtherDevice: encryptedItemB
]

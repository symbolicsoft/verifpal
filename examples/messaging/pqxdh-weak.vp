// SPDX-License-Identifier: GPL-3.0-only
//
// Signal PQXDH, with the harvest-now-decrypt-later adversary written as a
// declared weakening assumption rather than as a list of leaks.
//
// pqxdh.vp says "hand the attacker these five private values in phase 1".
// This model says "discrete logarithm falls in phase 1" by annotating every
// Diffie-Hellman public key with PUBKEY[weak from phase 1], and leaks
// nothing at all. A capability annotation goes between the primitive name
// and its arguments: `[weak]` declares that the primitive's confidentiality
// fails — for PUBKEY, that holding the public key yields the private key,
// i.e. discrete log is broken — and `from phase 1` delays the breakage
// until phase 1, modeling "the cryptography falls later".
//
// The KEM encapsulation key ekb is deliberately NOT annotated: that is the
// whole hybrid argument, and it is what the message survives on.
//
// Both models report c0a0. The difference is what they claim. A leaks list
// enumerates values and is silently wrong if you forget one; the annotation
// states the assumption itself, and any key derived through an annotated
// PUBKEY is covered whether or not you thought of it.
//
// The protocol body below is identical to pqxdh.vp — see that file for the
// line-by-line commentary. Only the annotations and the empty phase 1
// differ.

attacker[active]

principal Alice[
	knows public c1, c2, c3
	knows private alongterm
	galongterm = PUBKEY[weak from phase 1](alongterm)
]

principal Bob[
	knows public c1, c2, c3
	knows private blongterm, bs
	generates bo, dkb
	gblongterm = PUBKEY[weak from phase 1](blongterm)
	gbs = PUBKEY[weak from phase 1](bs)
	gbo = PUBKEY[weak from phase 1](bo)
	// The one un-annotated key: the KEM stays unbroken by assumption.
	ekb = PUBKEY(dkb)
	gbssig = SIGN(blongterm, HASH(c2, gbs))
	ekbsig = SIGN(blongterm, HASH(c3, ekb))
]

Bob -> Alice: [gblongterm], gbs, gbssig, gbo, ekb, ekbsig

principal Alice[
	generates m1, ae1, r
	gae1 = PUBKEY[weak from phase 1](ae1)
	valid = SIGNVERIF(gblongterm, HASH(c2, gbs), gbssig)?
	kvalid = SIGNVERIF(gblongterm, HASH(c3, ekb), ekbsig)?
	ss, ct = KEM_ENCAP(ekb, r)
	amaster = HASH(DH_KEX(gbs, alongterm), DH_KEX(gblongterm, ae1), DH_KEX(gbs, ae1), DH_KEX(gbo, ae1), ss)
	akenc = HKDF(amaster, c1, nil)
	generates n_e1
	e1 = AEAD_ENC(akenc, n_e1, m1, HASH(galongterm, gblongterm, gae1))
]

Alice -> Bob: [galongterm], gae1, ct, n_e1, e1

principal Bob[
	bss = KEM_DECAP(dkb, ct)
	bmaster = HASH(DH_KEX(galongterm, bs), DH_KEX(gae1, blongterm), DH_KEX(gae1, bs), DH_KEX(gae1, bo), bss)
	bkenc = HKDF(bmaster, c1, nil)
	m1_d = AEAD_DEC(bkenc, n_e1, e1, HASH(galongterm, gblongterm, gae1))?
]

// Phase 1 contains no leaks at all: the annotations above are the entire
// adversary model. When this phase is reached, discrete log falls.
phase[1]

queries[
	confidentiality? m1
	authentication? Alice -> Bob: e1
]

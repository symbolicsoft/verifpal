// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: c0a1e0 at one session and at two.
//
// SimpleX File Transfer Protocol (XFTP), from xftp.md. Files do not travel
// over messaging queues: the sender encrypts the whole file under a random
// symmetric key, splits it into fixed-size packets, uploads the packets to
// routers it chooses, and sends the recipient a "file description" — the
// file key and nonce, the digests, and one private Ed25519 key per packet
// per recipient — over an existing SMP connection. The routers hold
// addressed blobs and know nothing else.
//
// The design puts every security property in the description and none of it
// in the transport, and the three queries take that apart.
//
//   confidentiality? filedata  HOLDS — the router stores a packet encrypted
//     under a key that only ever exists in the description, which travels
//     out-of-band over an already-established SMP connection. A router that
//     keeps every packet forever learns nothing.
//   authentication? XRouter -> Recipient: out  FAILS — and it is supposed
//     to. The download leg carries no end-to-end authentication at all: the
//     packet is re-encrypted on the way out under an ephemeral
//     Diffie-Hellman agreed in the FGET/FILE exchange, purely so that the
//     bytes uploaded and the bytes downloaded have nothing in common inside
//     TLS. Anyone in that exchange can re-wrap the packet. That is not a
//     break; it is the layer doing exactly and only its stated job.
//   equivalence? filedata, data_r  HOLDS — and this is why the line above
//     is not a break. The recipient checks the packet against the SHA-256
//     digest carried in the description before it decrypts, so a router
//     that hands over anything other than the packet the sender uploaded is
//     caught. Integrity comes from the out-of-band description, not from
//     the connection. Delete the digest check and this flips.
//
// Two properties the model states without testing, because they are about
// who holds what rather than about what can be derived. The per-recipient
// download keys are generated by the SENDER, so the sender retains the
// ability to download and to acknowledge — that is, delete — any
// recipient's copy; xftp.md notes clients do not send FACK, which limits
// the consequence to what the router's own expiry would do anyway. And the
// file key is one key for all recipients, so any recipient can open any
// other recipient's packets; the redundant recipient IDs exist to hide how
// many recipients there are from the router, not from each other.
//
// Modelling notes. One packet stands for the whole file: additional packets
// repeat the same structure under the same file key with their own digests,
// and add nothing to derive. Packet and replica IDs are omitted for the
// reason queue IDs are omitted elsewhere — they are addressing metadata,
// and Verifpal's attacker sees every value that crosses a wire. The upload
// leg is guarded, since it runs inside TLS with the router certificate
// fingerprint pinned from the router URI and an attacker rewriting an
// upload is a separate and duller question; the download leg is left open,
// because an untrusted router serving whatever it likes is the subject.

attacker[active]

principal Sender[
	knows public tag_file, tag_pkt, tag_desc
	// The file, and the random key and nonce that seal it. NaCl secret_box
	// over the padded file, with the name in the padded header.
	knows private filedata
	generates fkey, fnonce
	chunk = AEAD_ENC(fkey, fnonce, filedata, tag_file)
	// The digest that will travel in the description. This is the only
	// integrity the recipient will have.
	cdigest = HASH(chunk)
	// The sender's own key for FNEW and FDEL, and one recipient key. Both
	// are generated here: the recipient never chooses its own.
	generates sndkey
	gsndkey = PUBKEY(sndkey)
	generates rcvkey
	grcvkey = PUBKEY(rcvkey)
	reg = SIGN(sndkey, HASH(gsndkey, cdigest))
	// The description travels inside the double ratchet of an SMP
	// connection the two already have; this key stands for that ratchet's
	// message key.
	knows private smpkey
	generates n_desc
	desc = AEAD_ENC(smpkey, n_desc, CONCAT(fkey, fnonce, cdigest, rcvkey), tag_desc)
]

principal Recipient[
	knows public tag_file, tag_pkt, tag_desc
	knows private smpkey
]

// FNEW and FPUT, inside TLS with the router certificate pinned.
Sender -> XRouter: [gsndkey], [grcvkey], [cdigest], [reg], [chunk]

principal XRouter[
	knows public tag_file, tag_pkt, tag_desc
	_ = SIGNVERIF(gsndkey, HASH(gsndkey, cdigest), reg)?
	// The router validates the uploaded body against the size and digest
	// it was registered with.
	_ = ASSERT(HASH(chunk), cdigest)?
]

// The file description, over an SMP connection the two already have. Every
// security property of the transfer is in this one message, which is why it
// goes inside the end-to-end encryption rather than beside it.
Sender -> Recipient: n_desc, desc

principal Recipient[
	descbody = AEAD_DEC(smpkey, n_desc, desc, tag_desc)?
	fkey_r, fnonce_r, cdigest_r, rcvkey_r = SPLIT(descbody)?
	generates rdh
	grdh = PUBKEY(rdh)
	// FGET, authorized with the key the description carried.
	getauth = SIGN(rcvkey_r, grdh)
]

Recipient -> XRouter: grdh, getauth

principal XRouter[
	_ = SIGNVERIF(grcvkey, grdh, getauth)?
	generates sdh
	gsdh = PUBKEY(sdh)
	pss = DH_KEX(grdh, sdh)
	generates cbnonce
	// The FILE response. This re-encryption exists so that the bytes that
	// went in and the bytes that come out cannot be correlated inside TLS.
	out = AEAD_ENC(pss, cbnonce, chunk, tag_pkt)
]

XRouter -> Recipient: gsdh, cbnonce, out

principal Recipient[
	pss_r = DH_KEX(gsdh, rdh)
	chunk_r = AEAD_DEC(pss_r, cbnonce, out, tag_pkt)?
	// The digest check, before anything is decrypted. This is what makes
	// the untrusted router harmless.
	_ = ASSERT(HASH(chunk_r), cdigest_r)?
	data_r = AEAD_DEC(fkey_r, fnonce_r, chunk_r, tag_file)?
]

queries[
	confidentiality? filedata
	authentication? XRouter -> Recipient: out
	equivalence? filedata, data_r
]

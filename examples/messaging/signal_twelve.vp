// This is examples/messaging/signal.vp extended from three messages to twelve.
// The X3DH handshake and the first three messages are unchanged; messages four
// through twelve simply continue the Double Ratchet: for each message the
// sender generates a fresh ratchet key, mixes it with the peer's most recent
// ratchet public key, and chains the root key onto the previous one with
// KDF_RK. Every block below is that same three-derivation step — DH_KEX with
// the newest peer ratchet key, HKDF(previous root key, DH share, nil) for the
// root chain, MAC-then-HKDF for the message key — applied twelve times; see
// signal.vp for the line-by-line commentary on one step, on the X3DH
// handshake, and for how each derivation maps onto the Signal specifications.
//
// All 24 queries hold (c0a0 twelve times over): as in signal.vp, phase 1 leaks
// both long-term identity keys, and every message survives because its key
// descends from ephemerals the attacker never obtains. The ratchet makes this
// compounding: each step folds a fresh DH secret into the chain, so the
// attacker would need an unbroken run of twelve ephemerals to follow along.
//
// This model doubles as the engine's heaviest benchmark: it is the slowest
// model in the tree (roughly 50 seconds) and exists precisely to keep the
// twelve-deep key schedule honest at scale. If you are editing the protocol
// itself, work on signal.vp instead.

attacker[active]

principal Alice[
	knows private alongterm
	galongterm = PUBKEY(alongterm)
]

principal Bob[
	knows private blongterm, bs
	generates bo
	gblongterm = PUBKEY(blongterm)
	gbs = PUBKEY(bs)
	gbo = PUBKEY(bo)
	gbssig = SIGN(blongterm, gbs)
]

Bob -> Alice: [gblongterm], gbssig, gbs, gbo

principal Alice[
	_ = SIGNVERIF(gblongterm, gbs, gbssig)?
	generates ae1
	gae1 = PUBKEY(ae1)
	amaster = HASH(DH_KEX(gbs, alongterm), DH_KEX(gblongterm, ae1), DH_KEX(gbs, ae1), DH_KEX(gbo, ae1))
]

principal Alice[
	generates m1, ae2
	gae2 = PUBKEY(ae2)
	akshared1 = DH_KEX(gbs, ae2)
	arkab1, ackab1 = HKDF(amaster, akshared1, nil)
	akenc1 = HKDF(nil, MAC(ackab1, nil), nil)
	e1 = AEAD_ENC(akenc1, m1, HASH(galongterm, gblongterm, gae2))
]

Alice -> Bob: [galongterm], gae1, gae2, e1

principal Bob[
	bmaster = HASH(DH_KEX(galongterm, bs), DH_KEX(gae1, blongterm), DH_KEX(gae1, bs), DH_KEX(gae1, bo))
]

principal Bob[
	bkshared1 = DH_KEX(gae2, bs)
	brkab1, bckab1 = HKDF(bmaster, bkshared1, nil)
	bkenc1 = HKDF(nil, MAC(bckab1, nil), nil)
	m1_d = AEAD_DEC(bkenc1, e1, HASH(galongterm, gblongterm, gae2))?
]

principal Bob[
	generates m2, be
	gbe = PUBKEY(be)
	bkshared2 = DH_KEX(gae2, be)
	brkba2, bckba2 = HKDF(brkab1, bkshared2, nil)
	bkenc2 = HKDF(nil, MAC(bckba2, nil), nil)
	e2 = AEAD_ENC(bkenc2, m2, HASH(galongterm, gblongterm, gbe))
]

Bob -> Alice: gbe, e2

principal Alice[
	akshared2 = DH_KEX(gbe, ae2)
	arkba2, ackba2 = HKDF(arkab1, akshared2, nil)
	akenc2 = HKDF(nil, MAC(ackba2, nil), nil)
	m2_d = AEAD_DEC(akenc2, e2, HASH(galongterm, gblongterm, gbe))?
]

principal Alice[
	generates m3, ae3
	gae3 = PUBKEY(ae3)
	akshared3 = DH_KEX(gbe, ae3)
	arkab3, ackab3 = HKDF(arkba2, akshared3, nil)
	akenc3 = HKDF(nil, MAC(ackab3, nil), nil)
	e3 = AEAD_ENC(akenc3, m3, HASH(galongterm, gblongterm, gae3))
]

Alice -> Bob: gae3, e3

principal Bob[
	bkshared3 = DH_KEX(gae3, be)
	brkab3, bckab3 = HKDF(brkba2, bkshared3, nil)
	bkenc3 = HKDF(nil, MAC(bckab3, nil), nil)
	m3_d = AEAD_DEC(bkenc3, e3, HASH(galongterm, gblongterm, gae3))?
]

principal Bob[
	generates m4, be2
	gbe2 = PUBKEY(be2)
	bkshared4 = DH_KEX(gae3, be2)
	brkba4, bckba4 = HKDF(brkab3, bkshared4, nil)
	bkenc4 = HKDF(nil, MAC(bckba4, nil), nil)
	e4 = AEAD_ENC(bkenc4, m4, HASH(galongterm, gblongterm, gbe2))
]

Bob -> Alice: gbe2, e4

principal Alice[
	akshared4 = DH_KEX(gbe2, ae3)
	arkba4, ackba4 = HKDF(arkab3, akshared4, nil)
	akenc4 = HKDF(nil, MAC(ackba4, nil), nil)
	m4_d = AEAD_DEC(akenc4, e4, HASH(galongterm, gblongterm, gbe2))?
]

principal Alice[
	generates m5, ae4
	gae4 = PUBKEY(ae4)
	akshared5 = DH_KEX(gbe2, ae4)
	arkab5, ackab5 = HKDF(arkba4, akshared5, nil)
	akenc5 = HKDF(nil, MAC(ackab5, nil), nil)
	e5 = AEAD_ENC(akenc5, m5, HASH(galongterm, gblongterm, gae4))
]

Alice -> Bob: gae4, e5

principal Bob[
	bkshared5 = DH_KEX(gae4, be2)
	brkab5, bckab5 = HKDF(brkba4, bkshared5, nil)
	bkenc5 = HKDF(nil, MAC(bckab5, nil), nil)
	m5_d = AEAD_DEC(bkenc5, e5, HASH(galongterm, gblongterm, gae4))?
]

principal Bob[
	generates m6, be3
	gbe3 = PUBKEY(be3)
	bkshared6 = DH_KEX(gae4, be3)
	brkba6, bckba6 = HKDF(brkab5, bkshared6, nil)
	bkenc6 = HKDF(nil, MAC(bckba6, nil), nil)
	e6 = AEAD_ENC(bkenc6, m6, HASH(galongterm, gblongterm, gbe3))
]

Bob -> Alice: gbe3, e6

principal Alice[
	akshared6 = DH_KEX(gbe3, ae4)
	arkba6, ackba6 = HKDF(arkab5, akshared6, nil)
	akenc6 = HKDF(nil, MAC(ackba6, nil), nil)
	m6_d = AEAD_DEC(akenc6, e6, HASH(galongterm, gblongterm, gbe3))?
]

principal Alice[
	generates m7, ae5
	gae5 = PUBKEY(ae5)
	akshared7 = DH_KEX(gbe3, ae5)
	arkab7, ackab7 = HKDF(arkba6, akshared7, nil)
	akenc7 = HKDF(nil, MAC(ackab7, nil), nil)
	e7 = AEAD_ENC(akenc7, m7, HASH(galongterm, gblongterm, gae5))
]

Alice -> Bob: gae5, e7

principal Bob[
	bkshared7 = DH_KEX(gae5, be3)
	brkab7, bckab7 = HKDF(brkba6, bkshared7, nil)
	bkenc7 = HKDF(nil, MAC(bckab7, nil), nil)
	m7_d = AEAD_DEC(bkenc7, e7, HASH(galongterm, gblongterm, gae5))?
]

principal Bob[
	generates m8, be4
	gbe4 = PUBKEY(be4)
	bkshared8 = DH_KEX(gae5, be4)
	brkba8, bckba8 = HKDF(brkab7, bkshared8, nil)
	bkenc8 = HKDF(nil, MAC(bckba8, nil), nil)
	e8 = AEAD_ENC(bkenc8, m8, HASH(galongterm, gblongterm, gbe4))
]

Bob -> Alice: gbe4, e8

principal Alice[
	akshared8 = DH_KEX(gbe4, ae5)
	arkba8, ackba8 = HKDF(arkab7, akshared8, nil)
	akenc8 = HKDF(nil, MAC(ackba8, nil), nil)
	m8_d = AEAD_DEC(akenc8, e8, HASH(galongterm, gblongterm, gbe4))?
]

principal Alice[
	generates m9, ae6
	gae6 = PUBKEY(ae6)
	akshared9 = DH_KEX(gbe4, ae6)
	arkab9, ackab9 = HKDF(arkba8, akshared9, nil)
	akenc9 = HKDF(nil, MAC(ackab9, nil), nil)
	e9 = AEAD_ENC(akenc9, m9, HASH(galongterm, gblongterm, gae6))
]

Alice -> Bob: gae6, e9

principal Bob[
	bkshared9 = DH_KEX(gae6, be4)
	brkab9, bckab9 = HKDF(brkba8, bkshared9, nil)
	bkenc9 = HKDF(nil, MAC(bckab9, nil), nil)
	m9_d = AEAD_DEC(bkenc9, e9, HASH(galongterm, gblongterm, gae6))?
]

principal Bob[
	generates m10, be5
	gbe5 = PUBKEY(be5)
	bkshared10 = DH_KEX(gae6, be5)
	brkba10, bckba10 = HKDF(brkab9, bkshared10, nil)
	bkenc10 = HKDF(nil, MAC(bckba10, nil), nil)
	e10 = AEAD_ENC(bkenc10, m10, HASH(galongterm, gblongterm, gbe5))
]

Bob -> Alice: gbe5, e10

principal Alice[
	akshared10 = DH_KEX(gbe5, ae6)
	arkba10, ackba10 = HKDF(arkab9, akshared10, nil)
	akenc10 = HKDF(nil, MAC(ackba10, nil), nil)
	m10_d = AEAD_DEC(akenc10, e10, HASH(galongterm, gblongterm, gbe5))?
]

principal Alice[
	generates m11, ae7
	gae7 = PUBKEY(ae7)
	akshared11 = DH_KEX(gbe5, ae7)
	arkab11, ackab11 = HKDF(arkba10, akshared11, nil)
	akenc11 = HKDF(nil, MAC(ackab11, nil), nil)
	e11 = AEAD_ENC(akenc11, m11, HASH(galongterm, gblongterm, gae7))
]

Alice -> Bob: gae7, e11

principal Bob[
	bkshared11 = DH_KEX(gae7, be5)
	brkab11, bckab11 = HKDF(brkba10, bkshared11, nil)
	bkenc11 = HKDF(nil, MAC(bckab11, nil), nil)
	m11_d = AEAD_DEC(bkenc11, e11, HASH(galongterm, gblongterm, gae7))?
]

principal Bob[
	generates m12, be6
	gbe6 = PUBKEY(be6)
	bkshared12 = DH_KEX(gae7, be6)
	brkba12, bckba12 = HKDF(brkab11, bkshared12, nil)
	bkenc12 = HKDF(nil, MAC(bckba12, nil), nil)
	e12 = AEAD_ENC(bkenc12, m12, HASH(galongterm, gblongterm, gbe6))
]

Bob -> Alice: gbe6, e12

principal Alice[
	akshared12 = DH_KEX(gbe6, ae7)
	arkba12, ackba12 = HKDF(arkab11, akshared12, nil)
	akenc12 = HKDF(nil, MAC(ackba12, nil), nil)
	m12_d = AEAD_DEC(akenc12, e12, HASH(galongterm, gblongterm, gbe6))?
]

phase[1]

principal Alice[leaks alongterm]
principal Bob[leaks blongterm]

queries[
	confidentiality? m1
	authentication? Alice -> Bob: e1
	confidentiality? m2
	authentication? Bob -> Alice: e2
	confidentiality? m3
	authentication? Alice -> Bob: e3
	confidentiality? m4
	authentication? Bob -> Alice: e4
	confidentiality? m5
	authentication? Alice -> Bob: e5
	confidentiality? m6
	authentication? Bob -> Alice: e6
	confidentiality? m7
	authentication? Alice -> Bob: e7
	confidentiality? m8
	authentication? Bob -> Alice: e8
	confidentiality? m9
	authentication? Alice -> Bob: e9
	confidentiality? m10
	authentication? Bob -> Alice: e10
	confidentiality? m11
	authentication? Alice -> Bob: e11
	confidentiality? m12
	authentication? Bob -> Alice: e12
]

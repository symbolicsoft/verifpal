//
// Expected: a0 at one session, a1 at two. As
// search_combined_secret_forgery_same_oracle.vp, but Dave leaks s after his
// check. Both routes to s still need Bob twice, and Dave's own leak comes
// only after he has checked m, so at one session the attacker cannot tag a
// value of its own in time. At two sessions it replays Alice's second m and t
// to the first Dave run, which accepts one emission twice.
attacker[active]

principal Alice[
	knows private kb, kc, s
	generates k1, k2, jb, jc
	w1 = ENC(kb, k1)
	w2 = ENC(kb, ENC(k1, s))
	w3 = ENC(kb, k2)
	w4 = ENC(kb, ENC(k2, s))
	xb = ENC(kb, jb)
	xc = ENC(kc, jc)
	leaks w1, w2, w3, w4
]
Alice -> Bob: xb
Alice -> Carol: xc

principal Bob[
	knows private kb
	y = DEC(kb, xb)
	leaks y
]

principal Carol[
	knows private kc
	z = DEC(kc, xc)
	leaks z
]

principal Alice[
	generates m
	t = MAC(s, m)
]
Alice -> Dave: m, t

principal Dave[
	knows private s
	_ = ASSERT(MAC(s, m), t)?
	leaks s
]

queries[
	authentication? Alice -> Dave: m
]

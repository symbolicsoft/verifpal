// Expected: error — one threshold per bracket.

attacker[passive]

principal Dealer[
	generates k
	s1, s2, s3 = THRESHOLD_SPLIT[2, 3](k)
	_ = HASH(s1, s2, s3)
]

queries[
	confidentiality? k
]

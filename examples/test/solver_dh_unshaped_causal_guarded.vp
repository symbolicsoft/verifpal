// Expected: c0. Guarding x prevents the attacker from supplying PUBKEY(b),
// so Bob cannot be steered into emitting the target MAC.
attacker[active]

principal Alice[
	knows public b, wrapping
	generates x
]

Alice -> Bob: [x]

principal Bob[
	knows public b, wrapping
	generates a
	leaks a
]

principal Alice[
	generates y
]

Alice -> Bob: y

principal Bob[
	knows private k
	tag = ENC(wrapping, MAC(k, DH_KEX(x, y)))
	secret = MAC(k, DH_KEX(PUBKEY(a), b))
]

Bob -> Carol: tag

principal Carol[]

queries[
	confidentiality? secret
]

//
// Expected: a1 — Carol receives m guarded from Bob, and Bob received it
// unguarded from Alice and forwards it to Carol *before* he verifies Alice's
// signature over it. The attacker substitutes m on the way to Bob; Bob's
// check fails afterwards, but by then the substituted m is already on its
// guarded way to Carol, who uses it. The halt comes too late to protect
// Carol, so the attack is genuine. Had Bob checked first, the substitution
// would halt him before he forwards anything; this model keeps that refusal
// from becoming a blanket one: what matters is whether the forwarder reaches
// its send, not whether it halts at all.

attacker[active]

principal Alice[
	knows private sk
	pk = PUBKEY(sk)
	generates m
	s = SIGN(sk, m)
]

Alice -> Bob: [pk], m, s

principal Bob[
	_ = HASH(m)
]

Bob -> Carol: [m]

principal Bob[
	_ = SIGNVERIF(pk, m, s)?
]

principal Carol[
	h = HASH(m)
]

queries[
	authentication? Bob -> Carol: m
]

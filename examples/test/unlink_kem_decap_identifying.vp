// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: u1u0 — the identifying-check witness, run through KEM_DECAP, and
// what it is really about: the key the two ciphertexts agree on, not the mere
// fact that a check exists. Bob's decapsulation key is leaked, so the attacker
// can actually run KEM_DECAP; the first pair is addressed to Bob twice and
// links, the second is split across Bob and Carol and does not, because the
// attacker has no key that opens both.
//
// Nothing about the encapsulations is shared — each uses its own generated
// randomness, so the pair has no common ancestor for origin_leaves to find.
// What the first pair shares is a recipient whose key the attacker holds.
//
// The leak is load-bearing and was not always here. This model used to say the
// check "needs only the PUBLIC key", and reported u1 with dk_one secret. That
// was the engine reading the identifier off the *producing* primitive — the
// encapsulation key at KEM_ENCAP's argument 0 — instead of off the position
// the *checking* primitive needs, which for KEM_DECAP is the private key. The
// two coincide for AEAD and differ by a PUBKEY the rule peels for signatures,
// so the KEM pair was the one that came out inverted: the engine claimed to
// have decapsulated both ciphertexts in the same run in which it reported the
// plaintexts confidential.

attacker[passive]

principal Bob[
	knows private dk_one
	ek_one = PUBKEY(dk_one)
	leaks dk_one
]

principal Carol[
	knows private dk_two
	ek_two = PUBKEY(dk_two)
]

Bob -> Alice: [ek_one]
Carol -> Alice: [ek_two]

principal Alice[
	generates r_one, r_two, r_three, r_four
	ss_one, tok_same_one = KEM_ENCAP(ek_one, r_one)
	ss_two, tok_same_two = KEM_ENCAP(ek_one, r_two)
	ss_three, tok_split_one = KEM_ENCAP(ek_one, r_three)
	ss_four, tok_split_two = KEM_ENCAP(ek_two, r_four)
]

Alice -> Bob: tok_same_one, tok_same_two, tok_split_one
Alice -> Carol: tok_split_two

principal Bob[
	_ = KEM_DECAP(dk_one, tok_same_one)?
	_ = KEM_DECAP(dk_one, tok_same_two)?
	_ = KEM_DECAP(dk_one, tok_split_one)?
]

principal Carol[
	_ = KEM_DECAP(dk_two, tok_split_two)?
]

queries[
	unlinkability? tok_same_one, tok_same_two
	unlinkability? tok_split_one, tok_split_two
]

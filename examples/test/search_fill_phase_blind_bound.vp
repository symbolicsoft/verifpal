//
// Expected: a0 at one session and at two. Counterweight to
// search_fill_phase_blind.vp: Bob checks y against HASH(s, sid) before he
// uses x, so with Alice silent nothing the attacker can supply in phase 0
// gets Bob as far as x.
attacker[active]

principal Bob[
	knows private k
	generates sid
]

Bob -> Alice: [sid]

Bob -> Carol: [sid]

principal Carol[
	knows private k, s
	z = MAC(k, sid)
	leaks z
]

principal Alice[
	knows private k, s
	x = MAC(k, sid)
	y = HASH(s, sid)
]

Alice -> Bob: x, y

principal Bob[
	knows private s
	_ = ASSERT(HASH(s, sid), y)?
	_ = ASSERT(MAC(k, sid), x)?
]

phase[1]

principal Carol[
	leaks s
]

queries[
	authentication? Alice -> Bob: x
]

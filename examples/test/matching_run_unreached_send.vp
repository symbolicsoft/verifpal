// Expected: a1 at one session and at two.
// Carol supplies MAC(k, nil), which Bob accepts with an installed nil nonce.
// Alice can compute that tag only on an input rejected by her guarded digest
// check before sending, so her computed slot cannot excuse the origin attack.

attacker[active]

principal Alice[
	knows private k
]
principal Bob[
	knows private k
]
principal Dave[]
principal Carol[
	knows private k
	generates n
	hn = HASH(n)
	other = MAC(k, nil)
]
Carol -> Dave: other
Carol -> Alice: n, [hn]
Carol -> Bob: n
principal Alice[
	tag = MAC(k, n)
	_ = ASSERT(hn, HASH(n))?
]
Alice -> Bob: tag
principal Bob[
	_ = ASSERT(tag, MAC(k, n))?
]
queries[
	authentication? Alice -> Bob: tag
]

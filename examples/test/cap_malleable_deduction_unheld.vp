// Expected: c0c0c0 at one and two sessions. A malleability assumption
// licenses no reshaping until the annotated ciphertext is held.

attacker[passive]

principal Alice[
	knows private k, secret
	knows public m
	c = ENC[malleable](k, m)
	key = ENC(k, nil)
	wrapped = ENC(HASH(key), secret)
]

Alice -> Bob: wrapped

principal Bob[
]

queries[
	confidentiality? secret
	confidentiality? key
	confidentiality? k
]

//
// Expected: c0 at one session and at two.
//
// Mallory's KEM is declared weak and Mallory leaks its ciphertext, so the
// attacker breaks ct for ss without dkb: the gpeer = gm scenario is a corrupt
// peer and only gpeer = ekb is honest. dkb never leaves Bob, so s encrypted
// to ekb stays confidential. The corruption inference once ignored weakening
// assumptions and the reveals of assignment outputs, labelled gm honest and
// reported s as disclosed in its scenario. The honesty profiles pinned in
// scenario.rs are the counterweight: without the weak annotation gm is honest,
// and with it from phase 1 gm is corrupt only from phase 1.
attacker[active]

principal Bob[
	knows private dkb
	ekb = PUBKEY(dkb)
]

principal Mallory[
	generates coins
]

Bob -> Mallory: [ekb]

principal Mallory[
	ss, ct = KEM_ENCAP[weak](ekb, coins)
	gm = PUBKEY(ss)
	leaks ct
]

Bob -> Alice: [ekb]
Mallory -> Alice: [gm]

principal Alice[
	knows public gpeer
	generates s
	e = PKE_ENC(gpeer, s)
]

Alice -> Bob: e

principal Bob[
	_ = PKE_DEC(dkb, e)
]

scenarios[
	Alice[gpeer = ekb]
	Alice[gpeer = gm]
]

queries[
	confidentiality? s
]

//
// Expected: c1u1 at one session and at two (GitHub issue #57).
//
// search_unlink_check_route.vp also asking confidentiality? message. The
// execution in which Bob and Carol leak x and y discloses message (c1) and
// links the signatures through it (u1). Asking about message gives the
// attacker nothing, so the unlinkability verdict is the same without it.

attacker[active]

principal Alice[
	knows private kb, kc, skone, sktwo
	generates x, y
	message = HASH(x, y)
	sigone = SIGN(skone, message)
	sigtwo = SIGN(sktwo, message)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	ex = ENC(kb, x)
	ey = ENC(kc, y)
	eskone = ENC(kb, skone)
	esktwo = ENC(kc, sktwo)
	eb = ENC(kb, nil)
	ec = ENC(kc, nil)
]

Alice -> Dave: ex, ey, pkone, pktwo, sigone, sigtwo, eskone, esktwo

Alice -> Bob: eb

Alice -> Carol: ec

principal Bob[
	knows private kb
	db = DEC(kb, eb)
	leaks db
]

principal Carol[
	knows private kc
	dc = DEC(kc, ec)
	leaks dc
]

principal Dave[
	_ = HASH(ex, ey, pkone, pktwo, sigone)
	_ = HASH(sigtwo, eskone, esktwo)
]

queries[
	confidentiality? message
	unlinkability? sigone, sigtwo
]

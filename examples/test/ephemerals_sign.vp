attacker[active]

principal Alice[
	knows private a
	ga = PUBKEY(a)
]

principal Bob[
	knows private message
]

Alice -> Bob: ga

principal Bob[
	generates be
	gbe = PUBKEY(be)
]

Bob -> Alice: gbe

principal Alice[
	generates ae
	gae = PUBKEY(ae)
	as = DH_KEX(gbe, ae)
	proof = SIGN(a, as)
]

Alice -> Bob: gae, proof

principal Bob[
	bs = DH_KEX(gae, be)
	_ = SIGNVERIF(ga, bs, proof)?
	generates n_ciphertext
	ciphertext = AEAD_ENC(bs, n_ciphertext, message, nil)
]

Bob -> Alice: n_ciphertext, ciphertext

principal Alice[
	_ = AEAD_DEC(as, n_ciphertext, ciphertext, nil)?
]

queries[
	confidentiality? message
	authentication? Bob -> Alice: ciphertext
]

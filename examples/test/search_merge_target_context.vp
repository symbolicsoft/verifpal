//
// Expected: u0c1 at one session and at two.
//
// Replacing gc with PUBKEY(nil) makes Alice encrypt CONCAT(sone, stwo) to
// the attacker, and replacing cd with cone makes Bob decrypt sone into d
// (c1). a and b share no secret and never link (u0).
//
// Both queries make sone a merge target: confidentiality? d in an execution
// where Bob holds it, and unlinkability? a, b, as the one secret argument of
// a, in the honest execution. A merge target is its values together with its
// context, the execution that makes its own subject hold the value: the
// honest execution, which has fewer installs, never gives Bob cone.
// _reversed asks the queries in the other order and _alone asks only about
// d; _guarded_key and _guarded_ciphertext guard gc and cd and hold.

attacker[active]

principal Carol[
	knows private c
	gc = PUBKEY(c)
]

Carol -> Alice: gc

principal Alice[
	knows private kb
	generates sone, stwo, unrelated
	cone = ENC(kb, sone)
	e = PKE_ENC(gc, CONCAT(sone, stwo))
	a = HASH(sone, nil)
	b = HASH(unrelated)
]

Alice -> Carol: cone, e, a, b

principal Carol[
	x = PKE_DEC(c, e)
]

principal Dave[
	knows private kb
	generates sd
	cd = ENC(kb, sd)
]

Dave -> Bob: cd

principal Bob[
	knows private kb
	d = DEC(kb, cd)
]

queries[
	unlinkability? a, b
	confidentiality? d
]

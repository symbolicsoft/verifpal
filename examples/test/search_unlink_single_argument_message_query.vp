//
// Expected: c1u1 at one session and at two.
//
// search_unlink_single_argument.vp with confidentiality? message asked
// first. The protocol is unchanged. message is now a merge target of its
// own, so the merge runs Bob's oracle on ex and Carol's on ey together even
// when no unlinkability target does, and the attacker obtains message. The
// same execution links the signatures via message. Asking about message
// gives the attacker nothing, so the unlinkability verdict must agree with
// search_unlink_single_argument.vp at every session count.
attacker[active]

principal Alice[
	knows private kb, kc, skone, sktwo
	generates x, y
	message = HASH(x, y)
	sigone = SIGN(skone, message)
	sigtwo = SIGN(sktwo, message)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	ex = ENC(kb, x)
	ey = ENC(kc, y)
	eskone = ENC(kb, skone)
	esktwo = ENC(kc, sktwo)
	eb = ENC(kb, nil)
	ec = ENC(kc, nil)
]

Alice -> Dave: ex, ey, pkone, pktwo, sigone, sigtwo, eskone, esktwo
Alice -> Bob: eb
Alice -> Carol: ec

principal Bob[
	knows private kb
	db = DEC(kb, eb)
	leaks db
]

principal Carol[
	knows private kc
	dc = DEC(kc, ec)
	leaks dc
]

principal Dave[
	_ = HASH(ex, ey, pkone, pktwo, sigone)
	_ = HASH(sigtwo, eskone, esktwo)
]

queries[
	confidentiality? message
	unlinkability? sigone, sigtwo
]

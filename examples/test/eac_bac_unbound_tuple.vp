//
// Expected: c1 at one session and at two.
//
// epassport/eac_bac_unbound.vp with the chip's challenge ciphertext and its
// MAC sent as one pair that the terminal splits. The double man-in-the-middle
// is unchanged: the attacker runs Chip Authentication with both sides under
// its own key, re-encrypts rpicc under the terminal's channel with a matching
// MAC, carries the terminal's signature into the chip's channel, and reads
// DG3.
//
// The terminal's MAC check relates the two fields of one received pair, and
// the oracle input that re-keys the challenge fixes only the first field, so
// the solver must open the pair and leave its tag field open for the check
// repair to rebuild, rather than fixing it to nil. Unification now opens a
// projected variable into a tuple of fresh fields, and oracle input proposals
// keep their free positions open. eac_bac_unbound_tuple_guarded.vp is the
// counterweight.
attacker[active]

principal Hotel[
	knows public docnumber
	knows private mrz
	leaks mrz
]

principal Terminal[
	knows private termkey
	termpub = PUBKEY(termkey)
]

Terminal -> Cvca: [termpub]

principal Cvca[
	knows private cvcakey
	cvcapub = PUBKEY(cvcakey)
	termcert = SIGN(cvcakey, termpub)
]

Cvca -> Terminal: [termcert]

Cvca -> Passport: [cvcapub]

principal Passport[
	knows private cakey, dg3
	knows public docnumber, sscr, sscta, sscdg3
	dg14 = PUBKEY(cakey)
]

Passport -> Terminal: dg14

principal Terminal[
	knows public docnumber, sscr, sscta, sscdg3
	generates caskt
	capkt = PUBKEY(caskt)
	caenc_t, camac_t = HKDF(nil, DH_KEX(dg14, caskt), nil)
]

Terminal -> Passport: capkt

principal Passport[
	caenc, camac = HKDF(nil, DH_KEX(capkt, cakey), nil)
	generates rpicc
	smr = ENC(caenc, rpicc)
	tagr = MAC(camac, CONCAT(sscr, smr))
	smr_tagr = CONCAT(smr, tagr)
]

Passport -> Terminal: smr_tagr

principal Terminal[
	smr_t, tagr_t = SPLIT(smr_tagr)
	_ = ASSERT(MAC(camac_t, CONCAT(sscr, smr_t)), tagr_t)?
	rpicc_t = DEC(caenc_t, smr_t)
	tasig = SIGN(termkey, CONCAT(docnumber, rpicc_t))
	smta = ENC(caenc_t, CONCAT(termpub, termcert, tasig))
	tagta = MAC(camac_t, CONCAT(sscta, smta))
]

Terminal -> Passport: smta, tagta

principal Passport[
	_ = ASSERT(MAC(camac, CONCAT(sscta, smta)), tagta)?
	termpub_p, termcert_p, tasig_p = SPLIT(DEC(caenc, smta))
	_ = SIGNVERIF(cvcapub, termpub_p, termcert_p)?
	_ = SIGNVERIF(termpub_p, CONCAT(docnumber, rpicc), tasig_p)?
	smdg3 = ENC(caenc, dg3)
	tagdg3 = MAC(camac, CONCAT(sscdg3, smdg3))
]

Passport -> Terminal: smdg3, tagdg3

principal Terminal[
	_ = ASSERT(MAC(camac_t, CONCAT(sscdg3, smdg3)), tagdg3)?
	dg3_t = DEC(caenc_t, smdg3)
]

queries[
	confidentiality? dg3
]

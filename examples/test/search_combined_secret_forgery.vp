//
// Expected: a1 at one and two sessions. Dave accepts m when it carries a
// MAC under s. Bob opens one ciphertext under kb and Carol one under kc, and
// s is reachable as ENC(k2, s) (under kc) opened with k2 (under kb): the
// attacker hands Bob w3 and Carol w4 in the same execution, learns s, and
// sends Dave nil with MAC(s, nil). No run of Alice emitted nil, so Dave's
// acceptance is a forgery. The route through k1 would need Bob twice. At two
// sessions the attacker can also replay Alice's second m and t to the first
// Dave run, which then accepts one emission twice.
attacker[active]

principal Alice[
	knows private kb, kc, s
	generates k1, k2, jb, jc
	w1 = ENC(kb, k1)
	w2 = ENC(kb, ENC(k1, s))
	w3 = ENC(kb, k2)
	w4 = ENC(kc, ENC(k2, s))
	xb = ENC(kb, jb)
	xc = ENC(kc, jc)
	leaks w1, w2, w3, w4
]
Alice -> Bob: xb
Alice -> Carol: xc

principal Bob[
	knows private kb
	y = DEC(kb, xb)
	leaks y
]

principal Carol[
	knows private kc
	z = DEC(kc, xc)
	leaks z
]

principal Alice[
	generates m
	t = MAC(s, m)
]
Alice -> Dave: m, t

principal Dave[
	knows private s
	_ = ASSERT(MAC(s, m), t)?
]

queries[
	authentication? Alice -> Dave: m
]

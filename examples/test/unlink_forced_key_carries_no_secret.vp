// Expected: u0 at one session and at two.
//
// Bob seals two public constants under one AEAD key derived from a seed only
// he can open, with a fresh nonce each. Nothing an attacker holds tests the
// two ciphertexts against each other: the payloads differ, so there is no
// equality, and forcing the sealed seed to a value of its own choosing gives
// it a key it made up rather than a secret the two tokens share.
//
// A witness has to carry a secret leaf the queried values genuinely share.
// Without that test the forced key counted as a common origin and every pair
// of messages under it was reported as linked.
attacker[active]
principal Alice[
	generates seed, pub_n
	knows public c1, c2
]
principal Bob[
	knows private b
	gb = PUBKEY(b)
	generates n1, n2
]
Bob -> Alice: [gb]
principal Alice[
	c = PKE_ENC(gb, seed)
	pn = PKE_ENC(gb, pub_n)
]
Alice -> Bob: pub_n, pn, c
principal Bob[
	knows public c1, c2
	seed_b = PKE_DEC(b, c)
	_ = PKE_DEC(b, pn)
	k = HASH(seed_b)
	e1 = AEAD_ENC(k, n1, c1, nil)
	e2 = AEAD_ENC(k, n2, c2, nil)
]
Bob -> Alice: n1, n2, e1, e2
principal Alice[
	_ = HASH(e1, e2)
]
queries[
	unlinkability? e1, e2
]

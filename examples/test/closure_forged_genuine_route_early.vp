//
// Expected: c1 at one session and at two.
//
// cfr_x is a forgeable partial whose nonce, commitments and message are known,
// so a genuine copy reveals cfr_s1. The attacker splits the leaked cfr_hz for
// cfr_hk and opens cfr_e for the genuine partial. cfr_f also yields cfr_hk under
// HASH(cfr_x), but only through the forgery itself.
// closure_forged_genuine_route_late.vp leaks cfr_hz after the send and must
// agree; closure_forged_genuine_route_absent.vp is the counterweight.
attacker[passive]
principal Alice[
	generates cfr_k, cfr_na, cfr_m, cfr_z, cfr_hk
	cfr_s1, cfr_s2 = THRESHOLD_SPLIT[2](cfr_k)
	cfr_ca = PUBKEY(cfr_na)
	cfr_x = THRESHOLD_SIGN[forgeable](cfr_s1, cfr_na, cfr_ca, cfr_m)
	cfr_f = ENC(HASH(cfr_x), cfr_hk)
	cfr_e = ENC(cfr_hk, cfr_x)
	cfr_hz = CONCAT(cfr_hk, cfr_z)
	leaks cfr_na, cfr_hz
]
Alice -> Bob: cfr_ca, cfr_m, cfr_f, cfr_e
principal Bob[
	_ = HASH(cfr_ca, cfr_m, cfr_f, cfr_e)
]
queries[
	confidentiality? cfr_s1
]

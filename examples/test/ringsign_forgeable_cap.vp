//
// Expected: a1a1 at one session and two. Both ring signatures use the same
// private signing key b, so the forgeable assumption permits signatures over
// attacker-chosen messages in either ring. Changing the other public members
// of the ring does not change the private key on which the assumption rests.
// The attacker must still hold the public ring members and the new message.
// cap_forgeable_other_key_holds.vp separates this from forgery under a different
// private key, and the solver unit test also checks primitive and phase scope.

attacker[active]

principal Alice[
	knows private a
	ga = PUBKEY(a)
]

principal Bob[
	knows private b
	gb = PUBKEY(b)
]

principal Carol[
	knows private c
	gc = PUBKEY(c)
]

principal Dana[
	knows private d
	gd = PUBKEY(d)
]

Alice -> Bob: [ga]
Carol -> Bob: [gc]
Dana -> Bob: [gd]
Alice -> Damian: [ga]
Bob -> Damian: [gb]
Carol -> Damian: [gc]
Dana -> Damian: [gd]

principal Bob[
	knows private soft
	knows private firm
	soft_sig = RINGSIGN[forgeable](b, ga, gc, soft)
	firm_sig = RINGSIGN(b, gc, gd, firm)
]

Bob -> Damian: soft, soft_sig, firm, firm_sig

principal Damian[
	_ = RINGSIGNVERIF(ga, gb, gc, soft, soft_sig)?
	_ = RINGSIGNVERIF(gb, gc, gd, firm, firm_sig)?
]

queries[
	authentication? Bob -> Damian: soft
	authentication? Bob -> Damian: firm
]

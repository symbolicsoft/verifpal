attacker[passive]

principal Alice[
	generates d
	p1 = PUBKEY(d)
	p2 = PUBKEY(d)
]

Alice -> Bob: p1, p2

principal Bob[
	_ = HASH(p1)
	_ = HASH(p2)
]

queries[
	unlinkability? p1, p2
]

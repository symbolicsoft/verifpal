//
// Expected: c1c1 at one session and at two.
//
// Alice's partial under s1 is declared `forgeable` and s2 leaks. The attacker
// holds no partial at all, but it needs none: it forges a partial under s1
// over the public message m with its own nonce nil and commitment list
// PUBKEY(nil), builds the matching partial under s2 itself, and joins the two
// into SIGN(k0, m), the key of e. The closure once combined only around a
// partial it already held, taking its commitment list, so an attacker that
// produced every partial itself could never choose a list of its own: the
// passive analysis reported c0c0, and an active one found the attack only by
// installing one of its partials somewhere first.
// threshold_combine_own_partials_short.vp is the counterweight.
attacker[passive]
principal Alice[
	knows public m
	generates k0, n0, m0, secret
	s1, s2 = THRESHOLD_SPLIT[2](k0)
	c0 = PUBKEY(n0)
	p0 = THRESHOLD_SIGN[forgeable](s1, n0, c0, m0)
	key = SIGN(k0, m)
	e = ENC(key, secret)
	leaks s2
]
Alice -> Bob: e
principal Bob[
	knows private bobonly
]
queries[
	confidentiality? secret
	confidentiality? key
]

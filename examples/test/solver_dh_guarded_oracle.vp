// Expected: c0 at both session counts. Guarding x prevents Bob from emitting
// the desired private tag: its second field must be b, but Alice's fresh x
// cannot be replaced. Swapping exponents cannot bypass that guarded input.
attacker[active]

principal Alice[
	knows public a, b
	generates x, y
]

Alice -> Bob: [x], y

principal Bob[
	knows public a, b
	knows private k
	tag = MAC(k, CONCAT(DH_KEX(PUBKEY(x), y), x))
	secret = MAC(k, CONCAT(DH_KEX(PUBKEY(a), b), b))
]

Bob -> Carol: tag

principal Carol[]

queries[
	confidentiality? secret
]

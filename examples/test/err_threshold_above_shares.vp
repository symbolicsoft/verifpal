//
// Expected: error — a threshold cannot exceed the number of shares bound, since
// // it is how many of them recover the secret.

attacker[passive]

principal Dealer[
	generates k
	s1, s2, s3 = THRESHOLD_SPLIT[4](k)
	_ = HASH(s1, s2, s3)
]

queries[
	confidentiality? k
]

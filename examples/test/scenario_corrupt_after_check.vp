// Sanity error at one session and at two.
//
// scenario_corrupt_at_late_check.vp with Alice's SIGNVERIF moved to phase 0.
// The gpeer = gb scenario's check still fails, but Bob leaks b only in phase
// 1, so at the check that run is honest, and a checked failure in an honest
// run is a model error.
attacker[passive]

principal Carol[
	knows private c
	gc = PUBKEY(c)
	sig = SIGN(c, nil)
]

principal Bob[
	knows private b
	gb = PUBKEY(b)
]

Carol -> Alice: [gc], [sig]

Bob -> Alice: [gb]

principal Alice[
	knows public gpeer
	knows private secret
	_ = SIGNVERIF(gpeer, nil, sig)?
]

phase[1]

principal Bob[
	leaks b
]

scenarios[
	Alice[gpeer = gc]
	Alice[gpeer = gb]
]

queries[
	confidentiality? secret
]

// Expected: c0c0 at one session and at two.
//
// A counter that never advances: two messages in one run are sealed under the
// same key and the same public counter. Against AES-GCM or ChaCha20-Poly1305
// the two ciphertexts give the attacker the XOR of m1 and m2 and the tag key,
// but neither plaintext while the other is unknown, and both are fresh.
// aead_nonce_reuse_counter_known.vp makes m1 public and m2 falls.
attacker[passive]

principal Alice[
	knows private k
	knows public ctr
	knows public ad
	generates m1, m2
	e1 = AEAD_ENC(k, ctr, m1, ad)
	e2 = AEAD_ENC(k, ctr, m2, ad)
]

Alice -> Bob: e1, e2

principal Bob[
	knows private k
	knows public ctr
	knows public ad
	d1 = AEAD_DEC(k, ctr, e1, ad)?
	d2 = AEAD_DEC(k, ctr, e2, ad)?
]

queries[
	confidentiality? m1
	confidentiality? m2
]

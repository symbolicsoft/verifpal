//
// Expected: c1c1 — a counter that never advances. Two messages in one run
// are sealed under the same key and the same public counter, so both
// plaintexts fall to the pairing and the attacker needs no key.

attacker[passive]

principal Alice[
	knows private k
	knows public ctr
	knows public ad
	generates m1, m2
	e1 = AEAD_ENC(k, ctr, m1, ad)
	e2 = AEAD_ENC(k, ctr, m2, ad)
]

Alice -> Bob: e1, e2

principal Bob[
	knows private k
	knows public ctr
	knows public ad
	d1 = AEAD_DEC(k, ctr, e1, ad)?
	d2 = AEAD_DEC(k, ctr, e2, ad)?
]

queries[
	confidentiality? m1
	confidentiality? m2
]

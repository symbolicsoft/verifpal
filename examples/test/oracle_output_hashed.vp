// Expected: a1 at one session and at two.
//
// Bob encrypts whatever x1 he receives under k and sends it back, and later
// accepts cmd when x2 = HASH(ENC(k, CONCAT(nb, cmd))). The attacker sends
// him x1 = CONCAT(nb, nil), hashes the ciphertext he returns and delivers
// cmd = nil with that hash. The oracle's output has to be hashed before it
// is fed back, and the search once admitted an input not yet derivable only
// when it equalled an oracle emission, so the flight was dropped unrun.
// oracle_output_hashed_guarded.vp is the counterweight.
attacker[active]
principal Bob[
	knows private k
	generates nb
]
Bob -> Alice: nb
principal Alice[
	knows private k
	generates x1
]
Alice -> Bob: x1
principal Bob[
	o = ENC(k, x1)
]
Bob -> Alice: o
principal Alice[
	generates cmd
	x2 = HASH(ENC(k, CONCAT(nb, cmd)))
]
Alice -> Bob: cmd, x2
principal Bob[
	_ = ASSERT(HASH(ENC(k, CONCAT(nb, cmd))), x2)?
]
queries[
	authentication? Alice -> Bob: cmd
]

//
// Expected: c0
//
// A shared secret is not a ciphertext. KEM_DECAP's rewrite rule undoes
// KEM_ENCAP, and KEM_ENCAP has two projections: the shared secret at |1 and the
// ciphertext at |2. Pinning only the key left both of them acceptable at the
// ciphertext position, so an attacker holding a shared secret it could not have
// encapsulated -- here Charlie's ksc_ss2, leaked without its ciphertext -- could
// put that secret on the wire and have Alice's KEM_DECAP accept it, deriving a
// key the attacker already knew. Choosing a ciphertext that decapsulates to a
// known secret is the one thing a KEM promises is impossible, so that was a
// false attack.
//
// The encapsulation key never travels, so the ordinary attack of encapsulating
// to it is unavailable and the substitution is the only lever there is; every
// principal that must encapsulate holds ksc_sk directly instead.
// kem_secret_is_a_real_ciphertext.vp is the counterweight: the same shape with
// the genuine ciphertext replayed, which still breaks the query.

attacker[active]

principal Alice[
	knows private ksc_sk
	generates ksc_m
]

principal Bob[
	knows private ksc_sk
	ksc_pk = PUBKEY(ksc_sk)
	generates ksc_r1
	ksc_ss1, ksc_ct1 = KEM_ENCAP(ksc_pk, ksc_r1)
]

principal Charlie[
	knows private ksc_sk
	ksc_pk2 = PUBKEY(ksc_sk)
	generates ksc_r2
	ksc_ss2, ksc_ct2 = KEM_ENCAP(ksc_pk2, ksc_r2)
	leaks ksc_ss2
]

Bob -> Alice: ksc_ct1

principal Alice[
	ksc_k = KEM_DECAP(ksc_sk, ksc_ct1)?
	ksc_e = AEAD_ENC(ksc_k, ksc_m, nil)
]

Alice -> Bob: ksc_e

principal Bob[
	_ = AEAD_DEC(ksc_ss1, ksc_e, nil)?
]

queries[
	confidentiality? ksc_m
]

//
// Expected: c1c1a1 — a login that hashes the password with a public salt and
// proves possession with a MAC over a public account name. The hash is an
// offline verifier, the password falls, the session key derived from it falls
// with it, and the attacker logs in.
//
// Everything here is a real deployment's idea of doing it properly: the
// password is not sent, it is salted, and the proof is a MAC rather than the
// password itself. None of that helps, because every sibling of the password
// at every level is public and the whole construction is one guessing loop.

attacker[active]

principal Client[
	knows password user_pw
	knows public salt, account
	knows private request
	stored = HASH(user_pw, salt)
	session_key = HASH(user_pw, account)
	proof = MAC(stored, account)
	sealed = AEAD_ENC(session_key, request, nil)
]

Client -> Server: stored, proof, sealed

principal Server[
	knows password user_pw
	knows public salt, account
	_ = ASSERT(MAC(HASH(user_pw, salt), account), proof)?
	got = AEAD_DEC(HASH(user_pw, account), sealed, nil)?
	_ = HASH(got)
]

queries[
	confidentiality? user_pw
	confidentiality? request
	authentication? Client -> Server: sealed
]

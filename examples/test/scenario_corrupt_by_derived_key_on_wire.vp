// Expected: c0 at one session and at two.
//
// Mallory's private key is not a declared secret but an assignment, scd_mk2 =
// HASH(scd_mk), and she sends it to Bob in the clear. The attacker holds it as
// surely as if she had leaked it, so the run in which Alice's peer is Mallory
// is a corrupt-peer run, and the message Alice encrypts to that peer is not a
// claim the model makes. A private key that travels bare on a message is
// compromised from that message's phase, whatever its declaration.

attacker[active]

principal Bob[
	knows private scd_b
	scd_gb = PUBKEY(scd_b)
]

principal Mallory[
	knows private scd_mk
	scd_mk2 = HASH(scd_mk)
	scd_gm = PUBKEY(scd_mk2)
]

principal Alice[
	knows public scd_gpeer
	generates scd_ni
]

Bob -> Alice: [scd_gb]
Mallory -> Alice: [scd_gm]
Mallory -> Bob: scd_mk2

principal Alice[
	scd_m1 = PKE_ENC(scd_gpeer, scd_ni)
]

Alice -> Bob: scd_m1

principal Bob[
	scd_ni_b = PKE_DEC(scd_b, scd_m1)
]

scenarios[
	Alice[scd_gpeer = scd_gb]
	Alice[scd_gpeer = scd_gm]
]

queries[
	confidentiality? scd_ni
]

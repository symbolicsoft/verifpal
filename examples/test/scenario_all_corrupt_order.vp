// Expected: f1 at one session and at two, like its swapped twin
// scenario_all_corrupt_order_swapped.vp.
//
// Both peers leak their keys in phase 0, so no scenario is honest and claims
// apply to every run. Query instances were once minted only for scenarios
// honest at some phase, so only the first declared scenario was ever asked:
// the stale x = HASH(gb) of the gpeer = gb run was found in one order and
// not the other.
attacker[passive]
principal Carol[
	generates c
	gc = PUBKEY(c)
	leaks c
]
principal Bob[
	knows private b
	gb = PUBKEY(b)
	leaks b
]
Carol -> Alice: [gc]
Bob -> Alice: [gb]
principal Alice[
	knows public gpeer
	x = HASH(gpeer)
	z = HASH(x)
]
scenarios[
	Alice[gpeer = gc]
	Alice[gpeer = gb]
]
queries[
	freshness? x
]

//
// Expected: c0 at one session and at two.
//
// ffgg_tuple.vp with the pair guarded: Alice#2 encrypts Bob#2's own nonces,
// so no reply of Bob#2 starts with Bob's n1 and m stays secret.
attacker[active]

principal Bob[
	knows private skb
	pkb = PUBKEY(skb)
]

principal Alice[
	knows private m
]

Bob -> Alice: [pkb]

principal Bob[
	generates n1
	generates n2
	nonces = CONCAT(n1, n2)
]

Bob -> Alice: [nonces]

principal Alice[
	n1_a, n2_a = SPLIT(nonces)
	msg = PKE_ENC(pkb, CONCAT(n1_a, n2_a, m))
]

Alice -> Bob: msg

principal Bob[
	clear = PKE_DEC(skb, msg)
	x, y1, y2 = SPLIT(clear)?
	_ = ASSERT(x, n1)?
	msg2 = PKE_ENC(pkb, CONCAT(y1, y2, n1))
]

Bob -> Alice: y1, msg2

queries[
	confidentiality? m
]

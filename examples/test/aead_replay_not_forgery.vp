attacker[active]

principal Alice[
	knows private k
	knows private m
	generates n
	generates n_c
	c = AEAD_ENC(k, n_c, m, n)
]

Alice -> Bob: n_c, c, n

principal Bob[
	knows private k
	m_b = AEAD_DEC(k, n_c, c, n)?
]

queries[
	authentication? Alice -> Bob: c
	confidentiality? m
]

// Expected: c1 at one session and two. A forgeable signature under ca_sk
// lets the attacker certify its own public key, even though the annotated
// call signs context alone and the certificate signs a structured message.
// Replacing the bundled key and certificate makes Browser encrypt secret to
// the attacker. The signature assumption does not disclose ca_sk.

attacker[active]

principal Ca[
	knows private ca_sk
	knows public context
	ca_pk = PUBKEY(ca_sk)
	tag = SIGN[forgeable](ca_sk, context)
]

principal Bank[
	knows private b_sk
	b_pk = PUBKEY(b_sk)
]

Bank -> Ca: [b_pk]

Ca -> Browser: [ca_pk], [tag]

principal Ca[
	cert = SIGN(ca_sk, CONCAT(context, b_pk))
	blob = CONCAT(b_pk, cert)
]

Ca -> Browser: blob

principal Browser[
	knows public context
	knows private secret
	peer, signature = SPLIT(blob)
	_ = SIGNVERIF(ca_pk, CONCAT(context, peer), signature)?
	sealed = PKE_ENC(peer, secret)
]

Browser -> Bank: sealed

queries[
	confidentiality? secret
]

// Expected: c1 at both session counts. A public tuple and its decryptable
// carrier do not hide the causally valid oracle response.
attacker[active]

principal Alice[
	knows public b, wrapping
	generates x
]

Alice -> Bob: x

principal Bob[
	knows public b, wrapping
	generates a
	leaks a
]

principal Alice[
	generates y
]

Alice -> Bob: y

principal Bob[
	knows private k
	tag = CONCAT(nil, ENC(wrapping, MAC(k, DH_KEX(PUBKEY(x), y))))
	secret = MAC(k, DH_KEX(PUBKEY(a), b))
]

Bob -> Carol: tag

principal Carol[]

queries[
	confidentiality? secret
]

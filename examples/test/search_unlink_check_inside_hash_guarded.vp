//
// Expected: u0 at one session and at two.
//
// search_unlink_check_inside_hash.vp with eb guarded: x stays secret, no
// execution holds message, and neither signature the hashes are built from
// can be checked against a common one.

attacker[active]

principal Alice[
	knows private kb, kc, skone, sktwo
	generates x, y
	message = HASH(x, y)
	sigone = SIGN(skone, message)
	sigtwo = SIGN(sktwo, message)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	ex = ENC(kb, x)
	ey = ENC(kc, y)
	eskone = ENC(kb, skone)
	esktwo = ENC(kc, sktwo)
	eb = ENC(kb, nil)
	ec = ENC(kc, nil)
	hone = HASH(sigone, nil)
	htwo = HASH(sigtwo, nil)
]

Alice -> Dave: ex, ey, pkone, pktwo, sigone, sigtwo, hone, htwo, eskone, esktwo

Alice -> Bob: [eb]

Alice -> Carol: ec

principal Bob[
	knows private kb
	db = DEC(kb, eb)
	leaks db
]

principal Carol[
	knows private kc
	dc = DEC(kc, ec)
	leaks dc
]

principal Dave[
	_ = HASH(ex, ey, pkone, pktwo, sigone)
	_ = HASH(sigtwo, eskone, esktwo, hone, htwo)
]

queries[
	unlinkability? hone, htwo
]

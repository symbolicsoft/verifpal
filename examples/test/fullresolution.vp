attacker[active]

principal Alice[
	knows private a
	ga = PUBKEY(a)
	h = HASH(a)
	leaks a
]

principal Bob[
	knows private b
	gb = PUBKEY(b)
]

Alice -> Bob: ga
Bob -> Alice: gb

principal Alice[
	gba = DH_KEX(gb, a)
]

principal Bob[
	gab = DH_KEX(ga, b)
]

queries[
	confidentiality? gba
	confidentiality? gab
	confidentiality? h
	confidentiality? a
	confidentiality? b
]

//
// Expected: c0 at one session, c1 at two. As
// search_merge_unblocked_source.vp, but Eve's input is guarded, so only Bob
// can open k, and doing so halts him before he sends Carol gb: Carol never
// opens ENC(k, s). At two sessions one Bob run is the oracle while the other
// serves Carol.
attacker[active]

principal Alice[
	knows private kb, ke, kc, km, s
	generates k, jb, je, jc
	wb = ENC(kb, k)
	we = ENC(ke, k)
	c = ENC(k, s)
	wc = ENC(kc, c)
	xb = ENC(kb, jb)
	tb = MAC(km, xb)
	xe = ENC(ke, je)
	xc = ENC(kc, jc)
	leaks wb, we, wc
]
Alice -> Bob: xb, [tb]
Alice -> Eve: [xe]
Alice -> Carol: xc

principal Bob[
	knows private kb, km
	generates gb
	yb = DEC(kb, xb)
	leaks yb
	_ = ASSERT(MAC(km, xb), tb)?
]
Bob -> Carol: [gb]

principal Eve[
	knows private ke
	ye = DEC(ke, xe)
	leaks ye
]

principal Carol[
	knows private kc
	yc = DEC(kc, xc)
	leaks yc
]

queries[
	confidentiality? s
]

//
// Expected: c0 at one session and at two.
//
// solver_oracle_input_honest_field.vp with Carol's input to Bob guarded: Bob
// signs only Carol's tuple, so no signature carries the attacker's key.
attacker[active]

principal Bob[
	knows private skb
	pkb = PUBKEY(skb)
]

Bob -> Alice: [pkb]

principal Carol[
	generates c, nc
	gc = PUBKEY(c)
	y = CONCAT(gc, nc)
]

Carol -> Bob: [y]

principal Bob[
	sb = SIGN(skb, y)
]

Bob -> Carol: sb

principal Alice[
	generates na, a, s
	ga = PUBKEY(a)
]

Alice -> Dave: na

principal Dave[
	knows private skb
	generates d
	gd = PUBKEY(d)
	hn = HASH(na)
	sd = SIGN(skb, CONCAT(gd, hn))
]

Dave -> Alice: gd, hn, sd

principal Alice[
	_ = ASSERT(hn, HASH(na))?
	_ = SIGNVERIF(pkb, CONCAT(gd, hn), sd)?
	k = DH_KEX(gd, a)
	ct = ENC(k, s)
]

Alice -> Dave: ga, ct

queries[
	confidentiality? s
]

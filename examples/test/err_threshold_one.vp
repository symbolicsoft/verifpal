// Expected: error — a threshold of one makes every share the secret, so it is
// // refused as a probable typo.

attacker[passive]

principal Dealer[
	generates k
	s1, s2, s3 = THRESHOLD_SPLIT[1](k)
	_ = HASH(s1, s2, s3)
]

queries[
	confidentiality? k
]

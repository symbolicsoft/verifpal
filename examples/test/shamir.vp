attacker[active]

principal Bob[]
principal Alice[
	generates k
	generates m
	s1, s2, s3 = THRESHOLD_SPLIT[2](k)
	generates n_e
	e = AEAD_ENC(k, n_e, m, nil)
]

Alice -> Bob: n_e, e, s1, s2

principal Bob[
	kk = THRESHOLD_JOIN(s1, s2)
	d = AEAD_DEC(kk, n_e, e, nil)?
]

queries[
	confidentiality? m
]

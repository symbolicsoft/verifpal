//
// Expected: c0c1a0a1 — a MAC over a message the attacker can read is a
// password verifier, so whether the password survives depends entirely on what
// stands between it and the MAC key. PW_HASH blocks the guess; a plain HASH
// does not.
//
// The two authentication queries are the consequence half, and they are the
// reason this is not just another confidentiality model: an extracted password
// is not merely disclosed, it is USABLE. The attacker that recovers pw_fast
// substitutes an order of its own and mints the tag to match, and Bob's ASSERT
// passes. The model asserts that the engine carries a recovered password
// forward into a forgery instead of stopping at the disclosure.

attacker[active]

principal Alice[
	knows password pw_slow
	knows password pw_fast
	knows private order_slow, order_fast
	tag_slow = MAC(PW_HASH(pw_slow), order_slow)
	tag_fast = MAC(HASH(pw_fast), order_fast)
]

Alice -> Bob: order_slow, tag_slow, order_fast, tag_fast

principal Bob[
	knows password pw_slow
	knows password pw_fast
	_ = ASSERT(MAC(PW_HASH(pw_slow), order_slow), tag_slow)?
	_ = ASSERT(MAC(HASH(pw_fast), order_fast), tag_fast)?
	_ = HASH(order_slow, order_fast)
]

queries[
	confidentiality? pw_slow
	confidentiality? pw_fast
	authentication? Alice -> Bob: order_slow
	authentication? Alice -> Bob: order_fast
]

//
// Expected: c0 at one session and at two. The nonce comes from the peer and
// travels unguarded, so the attacker chooses it. One run of Alice makes one
// ciphertext whatever nonce she is handed. Two runs handed the same nonce
// seal two fresh messages under one (k, n), and the pair gives the attacker
// their XOR and the tag key, but neither message.
// aead_nonce_reuse_attacker_supplied_retag.vp, where the solver has to
// install one nonce into both runs, uses the tag key.

attacker[active]

principal Bob[
	generates nb
]

Bob -> Alice: nb

principal Alice[
	knows private k
	knows public ad
	generates m
	e = AEAD_ENC(k, nb, m, ad)
]

Alice -> Bob: e

principal Bob[
	knows private k
	knows public ad
	d = AEAD_DEC(k, nb, e, ad)?
]

queries[
	confidentiality? m
]

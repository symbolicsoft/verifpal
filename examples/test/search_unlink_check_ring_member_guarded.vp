//
// Expected: u0 at one session and at two (GitHub issue #60).
//
// search_unlink_check_ring_member.vp with ed guarded: PUBKEY(skaux) stays
// hidden, so neither ring can be checked, whatever Bob and Carol leak.

attacker[active]

principal Alice[
	knows private kb, kc, kd, skone, sktwo, skaux
	generates x, y
	message = HASH(x, y)
	sigone = RINGSIGN(skone, PUBKEY(skaux), PUBKEY(nil), message)
	sigtwo = RINGSIGN(sktwo, PUBKEY(skaux), PUBKEY(nil), message)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	witness = HASH(message, PUBKEY(skaux))
	ex = ENC(kb, x)
	ey = ENC(kc, y)
	eskone = ENC(kb, skone)
	esktwo = ENC(kc, sktwo)
	eaux = ENC(kd, PUBKEY(skaux))
	eb = ENC(kb, nil)
	ec = ENC(kc, nil)
	ed = ENC(kd, nil)
]

Alice -> Dave: ex, ey, pkone, pktwo, eaux, sigone, sigtwo, eskone, esktwo

Alice -> Bob: eb

Alice -> Carol: ec

Alice -> Erin: [ed]

principal Bob[
	knows private kb
	db = DEC(kb, eb)
	leaks db
]

principal Carol[
	knows private kc
	dc = DEC(kc, ec)
	leaks dc
]

principal Erin[
	knows private kd
	dd = DEC(kd, ed)
	leaks dd
]

principal Dave[
	_ = HASH(CONCAT(ex, ey), pkone, pktwo, eaux, sigone)
	_ = HASH(sigtwo, eskone, esktwo)
]

queries[
	unlinkability? sigone, sigtwo
]

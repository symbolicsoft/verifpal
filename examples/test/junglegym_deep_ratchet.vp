//
// Expected: c0c0c0c0c0a0a0a0a0f0f1e1e1e0u0u0. A five-round ratchet exercises
// nested tuples and key derivation. The two key-equivalence queries can
// diverge after an ephemeral-key substitution. The checked final decryption
// must succeed before its output can witness a payload divergence.

attacker[active]

principal Origin[
	knows private origin_seed
	knows public salt, domain
	generates origin_eph
	origin_ephpk = PUBKEY(origin_eph)
	generates kem_r
]

principal Mirror[
	knows public salt, domain
	generates mirror_eph
	mirror_ephpk = PUBKEY(mirror_eph)
	knows private mirror_kem_sk
	mirror_kem_pk = PUBKEY(mirror_kem_sk)
]

Mirror → Origin: [mirror_ephpk], [mirror_kem_pk]
Origin → Mirror: [origin_ephpk]

principal Origin[
	/* Round 0: a DH secret and a KEM secret, concatenated and split apart
	   again before anything else touches them. */
	dh0 = DH_KEX(mirror_ephpk, origin_eph)
	kem_ss, kem_ct = KEM_ENCAP(mirror_kem_pk, kem_r)
	mixed0 = CONCAT(dh0, kem_ss, salt)
	a0, b0, c0 = SPLIT(mixed0)
	// Round 1
	r1 = HKDF(CONCAT(a0, b0), CONCAT(c0, domain), salt)
	// Round 2: feed the round-1 key back through another CONCAT/SPLIT cycle
	x2, y2 = SPLIT(CONCAT(r1, salt))
	r2 = HKDF(x2, CONCAT(y2, origin_ephpk), domain)
	// Round 3
	x3, y3, z3 = SPLIT(CONCAT(r2, r1, domain))
	r3 = HKDF(CONCAT(x3, y3), z3, salt)
	// Round 4: five-way concat and split, the widest the language allows
	p4, q4, s4, t4, u4 = SPLIT(CONCAT(r3, r2, r1, salt, domain))
	r4 = HKDF(CONCAT(p4, q4, s4), CONCAT(t4, u4), domain)
	// The payload is sealed under the deepest key and bound to every layer.
	generates cargo
	generates n_shipped
	shipped = AEAD_ENC(r4, n_shipped, cargo, HASH(r1, r2, r3))
	stamp = MAC(r3, CONCAT(shipped, HASH(r4, salt)))
	_ = HASH(shipped, stamp, domain)
]

Origin → Mirror: kem_ct, n_shipped, shipped, stamp

principal Mirror[
	/* Mirror walks the identical ladder from the other side of the DH. */
	dh0_m = DH_KEX(origin_ephpk, mirror_eph)
	kem_ss_m = KEM_DECAP(mirror_kem_sk, kem_ct)?
	mixed0_m = CONCAT(dh0_m, kem_ss_m, salt)
	a0m, b0m, c0m = SPLIT(mixed0_m)
	m1 = HKDF(CONCAT(a0m, b0m), CONCAT(c0m, domain), salt)
	x2m, y2m = SPLIT(CONCAT(m1, salt))
	m2 = HKDF(x2m, CONCAT(y2m, origin_ephpk), domain)
	x3m, y3m, z3m = SPLIT(CONCAT(m2, m1, domain))
	m3 = HKDF(CONCAT(x3m, y3m), z3m, salt)
	p4m, q4m, s4m, t4m, u4m = SPLIT(CONCAT(m3, m2, m1, salt, domain))
	m4 = HKDF(CONCAT(p4m, q4m, s4m), CONCAT(t4m, u4m), domain)
	_ = ASSERT(stamp, MAC(m3, CONCAT(shipped, HASH(m4, salt))))?
	landed = AEAD_DEC(m4, n_shipped, shipped, HASH(m1, m2, m3))?
	echo = MAC(m1, CONCAT(landed, HASH(m2, m3, m4)))
]

Mirror → Origin: echo

principal Origin[
	_ = ASSERT(echo, MAC(r1, CONCAT(cargo, HASH(r2, r3, r4))))?
]

queries[
	confidentiality? cargo
	confidentiality? origin_seed
	confidentiality? r1
	confidentiality? r4
	confidentiality? kem_r
	authentication? Origin → Mirror: shipped[
		precondition[Mirror → Origin: echo]
	]
	authentication? Origin → Mirror: stamp
	authentication? Origin → Mirror: kem_ct
	authentication? Mirror → Origin: echo
	freshness? cargo
	freshness? salt
	equivalence? r1, m1
	equivalence? r4, m4
	equivalence? cargo, landed
	unlinkability? shipped, stamp
	unlinkability? r1, r4
]

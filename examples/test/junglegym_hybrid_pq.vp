// SPDX-License-Identifier: GPL-3.0-only
// Expected: c1c1c1a0a1f0f1e1e1
//
// A hybrid classical+post-quantum handshake: X25519-shaped DH_KEX alongside a
// KEM, both folded into one HKDF, then a signed transcript, a MAC key
// confirmation, an AEAD payload and a MAC receipt, over three phases.
//
// The ephemeral public keys travel UNGUARDED, so an active attacker MitMs the
// handshake in phase 0 and every secrecy query falls to that alone. kem_seed
// goes with them: the attacker substitutes its own encapsulation key, Bob
// encapsulates to a key the attacker holds, and decapsulating recovers the
// encapsulation randomness as well as the shared secret, the way ML-KEM's
// re-encryption check does. PUBKEY[weak from phase 3] additionally hands the
// attacker Alice's ephemeral private key once phase 3 arrives.
//
// bob_sig nevertheless holds, and that is the interesting half. The attacker
// can feed Alice's ephemeral to Bob's SECOND run, which encapsulates to her
// key and signs her transcript, and relay that run's bob_ephpk, kem_ct and
// bob_sig back to her. Every check passes — but Bob's long-term key is guarded
// and never leaks, so nothing was signed that Bob did not sign, and Bob#2 is
// another run of the same Bob under the same peer binding, answering the
// ephemeral Alice actually sent. Alice's acceptance has that run as its unique
// match, so agreement is injective and the query passes.
// session_nonce_cross.vp is this shape without a KEM.
//
// The secrecy queries are where the MitM lands, and the third of them rests on
// KEM decapsulation yielding the encapsulation randomness: this model would go
// back to c1c1c0a0a1f0f1e1e1 if it stopped doing so.
//
// Note the KEM output order: `ss, ct = KEM_ENCAP(pk, r)` -- shared secret
// first. KEM_DECAP's rewrite rule pins the projection it consumes, so putting
// a shared secret where a ciphertext belongs is refused rather than reduced.
//
// The payload query has no minimized witness, and that is the honest answer
// rather than a gap. Reaching it needs kem_seed, which exists only in a run
// where alice_ephpk was replaced, while sealed exists only in a run where it
// was not; no single install into one session produces both. Before the
// projection was pinned, the minimizer confirmed `kem_ct := kem_ss` instead,
// which reproduced only because a shared secret decapsulated to itself.

attacker[active]

principal Alice[
	knows private alice_ltk
	knows public ctx
	alice_ltpk = PUBKEY(alice_ltk)
	generates alice_eph
	alice_ephpk = PUBKEY[weak from phase 3](alice_eph)
]

principal Bob[
	knows private bob_ltk
	knows public ctx
	bob_ltpk = PUBKEY(bob_ltk)
	generates bob_eph
	bob_ephpk = PUBKEY(bob_eph)
	generates kem_seed
]

Alice -> Bob: [alice_ltpk], alice_ephpk
Bob   -> Alice: [bob_ltpk], bob_ephpk

principal Bob[
	kem_ss, kem_ct = KEM_ENCAP(alice_ephpk, kem_seed)
	dh_ss = DH_KEX(alice_ephpk, bob_eph)
	transcript = CONCAT(alice_ephpk, bob_ephpk, ctx)
	root, chain, auth_key = HKDF(CONCAT(dh_ss, kem_ss), transcript, ctx)
	bob_sig = SIGN(bob_ltk, HASH(transcript, root))
	confirm = MAC(auth_key, transcript)
]

Bob -> Alice: kem_ct, bob_sig, confirm

principal Alice[
	kem_ss_a = KEM_DECAP(alice_eph, kem_ct)?
	dh_ss_a = DH_KEX(bob_ephpk, alice_eph)
	transcript_a = CONCAT(alice_ephpk, bob_ephpk, ctx)
	root_a, chain_a, auth_key_a = HKDF(CONCAT(dh_ss_a, kem_ss_a), transcript_a, ctx)
	_ = SIGNVERIF(bob_ltpk, HASH(transcript_a, root_a), bob_sig)?
	_ = ASSERT(confirm, MAC(auth_key_a, transcript_a))?
	generates payload
	sealed = AEAD_ENC(root_a, payload, transcript_a)
	receipt = MAC(chain_a, sealed)
]

Alice -> Bob: sealed, receipt

principal Bob[
	_ = ASSERT(receipt, MAC(chain, sealed))?
	payload_b = AEAD_DEC(root, sealed, transcript)?
	ack = HASH(payload_b, chain)
]

Bob -> Alice: ack

principal Alice[
	_ = ASSERT(ack, HASH(payload, chain_a))?
]

phase[1]

principal Bob[
	leaks bob_eph
]

phase[2]

principal Alice[
	leaks alice_ltk
]

phase[3]

queries[
	confidentiality? payload
	confidentiality? root
	confidentiality? kem_seed
	authentication? Bob -> Alice: bob_sig
	authentication? Alice -> Bob: sealed[
		precondition[Bob -> Alice: ack]
	]
	freshness? payload
	freshness? ctx
	equivalence? root, root_a
	equivalence? auth_key, auth_key_a
]

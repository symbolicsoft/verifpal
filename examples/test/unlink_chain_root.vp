attacker[passive]

principal Alice[
	knows public c1, c2
	generates sk0
	sk1 = HASH(sk0)
	tok0 = HASH(sk0, c1)
	tok1 = HASH(sk1, c2)
	leaks sk0
]

Alice -> Bob: tok0, tok1

principal Bob[
	knows public c1, c2
	_ = HASH(tok0)
	_ = HASH(tok1)
]

queries[
	unlinkability? tok0, tok1
]

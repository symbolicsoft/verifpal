// Expected: a0 at both session counts. All sixteen partials sign the same
// honest message: choosing another eight of them forges nothing. The guarded
// verification key also prevents replaying another session's signature.
attacker[active]

principal Dealer[
	generates k, m
	pk = PUBKEY(k)
	s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16 = THRESHOLD_SPLIT[8](k)
	generates n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n16
	cl = CONCAT(CONCAT(PUBKEY(n1), PUBKEY(n2), PUBKEY(n3), PUBKEY(n4)), CONCAT(PUBKEY(n5), PUBKEY(n6), PUBKEY(n7), PUBKEY(n8)), CONCAT(PUBKEY(n9), PUBKEY(n10), PUBKEY(n11), PUBKEY(n12)), CONCAT(PUBKEY(n13), PUBKEY(n14), PUBKEY(n15), PUBKEY(n16)))
	p1 = THRESHOLD_SIGN(s1, n1, cl, m)
	p2 = THRESHOLD_SIGN(s2, n2, cl, m)
	p3 = THRESHOLD_SIGN(s3, n3, cl, m)
	p4 = THRESHOLD_SIGN(s4, n4, cl, m)
	p5 = THRESHOLD_SIGN(s5, n5, cl, m)
	p6 = THRESHOLD_SIGN(s6, n6, cl, m)
	p7 = THRESHOLD_SIGN(s7, n7, cl, m)
	p8 = THRESHOLD_SIGN(s8, n8, cl, m)
	p9 = THRESHOLD_SIGN(s9, n9, cl, m)
	p10 = THRESHOLD_SIGN(s10, n10, cl, m)
	p11 = THRESHOLD_SIGN(s11, n11, cl, m)
	p12 = THRESHOLD_SIGN(s12, n12, cl, m)
	p13 = THRESHOLD_SIGN(s13, n13, cl, m)
	p14 = THRESHOLD_SIGN(s14, n14, cl, m)
	p15 = THRESHOLD_SIGN(s15, n15, cl, m)
	p16 = THRESHOLD_SIGN(s16, n16, cl, m)
	sig = THRESHOLD_JOIN(p1, p2, p3, p4, p5, p6, p7, p8)
]

Dealer -> Observer: p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15, p16

principal Observer[]

Dealer -> Verifier: [pk], m, sig

principal Verifier[
	_ = SIGNVERIF(pk, m, sig)?
]

queries[
	authentication? Dealer -> Verifier: sig
]

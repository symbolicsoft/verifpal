attacker[active]

principal Bob[
	knows private b, s
	gb = PUBKEY(b)
	gs = PUBKEY(s)
]

Bob -> Alice: [gb], gs

principal Alice[
	generates e, m
	ge = PUBKEY(e)
	d1 = DH_KEX(gs, e)
	d2 = DH_KEX(gb, e)
	k = HASH(d1, d2)
	generates n_c
	c = AEAD_ENC(k, n_c, m, nil)
]

Alice -> Bob: ge, n_c, c

phase[1]

principal Bob[leaks b]

queries[
	confidentiality? d1
	confidentiality? d2
	confidentiality? k
	confidentiality? m
]

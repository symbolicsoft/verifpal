attacker[passive]

principal Alice[
	knows public c1, c2
	generates seed
	tok1 = HASH(seed, c1)
	tok2 = HASH(seed, c2)
]

Alice -> Bob: tok1, tok2

principal Bob[
	knows public c1, c2
	_ = HASH(tok1)
	_ = HASH(tok2)
]

queries[
	unlinkability? tok1, tok2
]

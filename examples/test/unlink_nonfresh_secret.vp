attacker[passive]

principal Alice[
	knows private s
	knows public c1, c2
	tok1 = HASH(s, c1)
	tok2 = HASH(s, c2)
]

Alice -> Bob: tok1, tok2

principal Bob[
	knows private s
	knows public c1, c2
	_ = HASH(tok1)
	_ = HASH(tok2)
]

queries[
	unlinkability? tok1, tok2
]

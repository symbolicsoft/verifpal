//
// Expected: c1 at one and two sessions. Bob opens one ciphertext under kb
// and Carol one under kc. The secret s is reachable along two routes: k1
// with ENC(k1, s), both sealed under kb, or k2 (under kb) with ENC(k2, s)
// (under kc). The first route needs Bob twice, which one session does not
// allow; the second takes Bob once and Carol once, so the attacker hands Bob
// w3 and Carol w4 and opens Carol's leak with Bob's. At two sessions two Bob
// runs can also open both halves of the first route.
attacker[active]

principal Alice[
	knows private kb, kc, s
	generates k1, k2, jb, jc
	w1 = ENC(kb, k1)
	w2 = ENC(kb, ENC(k1, s))
	w3 = ENC(kb, k2)
	w4 = ENC(kc, ENC(k2, s))
	xb = ENC(kb, jb)
	xc = ENC(kc, jc)
	leaks w1, w2, w3, w4
]
Alice -> Bob: xb
Alice -> Carol: xc

principal Bob[
	knows private kb
	y = DEC(kb, xb)
	leaks y
]

principal Carol[
	knows private kc
	z = DEC(kc, xc)
	leaks z
]

queries[
	confidentiality? s
]

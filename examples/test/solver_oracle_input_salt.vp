//
// Expected: a1 at one and two sessions.
//
// Bob derives a key from a salt Alice sends and tags a public constant with
// it; later he checks a tag under HKDF(HASH(c0), ikm, c0) over a received
// message. salt := HASH(c0) makes his first tag MAC(HKDF(HASH(c0), ikm, c0),
// c0), which is exactly what his later check accepts with m := c0.
//
// Wire matching is one-way, so the goal solver could not bind the check's
// m to the c0 inside Bob's emission; unifying the emission with the check's
// wanted shape binds both salt and m, and the check's own slot is bound to
// the emission under that unifier. The joint proposal is refused once, since
// the tag is derivable only after the salt has been delivered, and its
// prefix runs first.

attacker[active]

principal Alice[
	knows private ikm
	knows public c0
	generates salt, m
]

Alice -> Bob: salt

principal Bob[
	knows private ikm
	knows public c0
	k1 = HKDF(salt, ikm, c0)
	t1 = MAC(k1, c0)
]

Bob -> Alice: t1

principal Alice[
	k2 = HKDF(HASH(c0), ikm, c0)
	tm = MAC(k2, m)
]

Alice -> Bob: m, tm

principal Bob[
	k3 = HKDF(HASH(c0), ikm, c0)
	_ = ASSERT(MAC(k3, m), tm)?
	h = HASH(m)
]

queries[
	authentication? Alice -> Bob: m
]

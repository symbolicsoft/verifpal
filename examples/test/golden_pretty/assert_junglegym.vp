attacker[active]

principal Alice[
	knows private ka
]

principal Bob[
	knows private ka
	knows private kb
	generates kab
	kab_bob = ENC(kb, kab)
	tag = HASH(kab, kab_bob)
	enctag = ENC(ka, tag)
	kab_alice = ENC(ka, kab)
	kab_bob_alice = ENC(ka, kab_bob)
]

Bob -> Alice: enctag, kab_alice, kab_bob_alice

principal Alice[
	tag_ = DEC(ka, enctag)
	kab_ = DEC(ka, kab_alice)
	kab_bob_ = DEC(ka, kab_bob_alice)
	_ = ASSERT(tag_, HASH(kab_, kab_bob_))?
	leaks kab_bob_
]

queries[
	confidentiality? kab
]

attacker[passive]

principal Alice[
	knows private private_key_alice
	public_key_alice = PUBKEY(private_key_alice)
]

principal Bob[
	knows private private_key_bob
	public_key_bob = PUBKEY(private_key_bob)
]

Alice -> Bob: [public_key_alice]

Bob -> Alice: [public_key_bob]

principal Alice[
	knows private message
	shared_secret_alice = DH_KEX(public_key_bob, private_key_alice)
	generates n_ciphertext_and_tag
	ciphertext_and_tag = AEAD_ENC(shared_secret_alice, n_ciphertext_and_tag, message, shared_secret_alice)
]

Alice -> Bob: n_ciphertext_and_tag, ciphertext_and_tag

principal Bob[
	shared_secret_bob = DH_KEX(public_key_alice, private_key_bob)
	decrypted_message = AEAD_DEC(shared_secret_bob, n_ciphertext_and_tag, ciphertext_and_tag, shared_secret_bob)?
]

queries[
	confidentiality? message
]

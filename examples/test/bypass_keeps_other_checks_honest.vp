//
// Expected: a0a1 at one session and a1a1 at two. A leaked encryption key
// permits a ciphertext forgery, while the independent signing key protects x
// from a one-session forgery. Another session supplies a replay of the
// honestly signed x.

attacker[active]

principal Alice[
	knows private sk, k
	pk = PUBKEY(sk)
	generates x, n, m
	sig = SIGN(sk, x)
	e = AEAD_ENC(k, n, m, nil)
]

principal Mallory[
	knows private k
	leaks k
]

Alice -> Bob: [pk]
Alice -> Bob: x, sig, n, e

principal Bob[
	knows private k
	_ = SIGNVERIF(pk, x, sig)?
	d = AEAD_DEC(k, n, e, nil)?
	h = HASH(x, d)
]

queries[
	authentication? Alice -> Bob: x
	authentication? Alice -> Bob: e
]

//
// Sanity error: the precondition's sender must be the principal that sends
// the constant to that recipient. Alice sends m2 to Carol; Bob never does,
// so there is no such event and the model is rejected at the option.

attacker[active]

principal Bob[
	knows private psk
	generates m
	e = ENC(psk, m)
]

Bob -> Alice: e

principal Alice[
	knows private psk
	m2 = DEC(psk, e)
]

Alice -> Carol: m2

principal Carol[
	_ = HASH(m2)
]

queries[
	authentication? Bob -> Alice: e[
		precondition[Bob -> Carol: m2]
	]
]

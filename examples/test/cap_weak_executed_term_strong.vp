//
// Expected: c0 at one session and at two.
//
// cap_weak_executed_term.vp without the `weak` annotation: the man-in-the-
// middle still holds Client's transcript-bound proof, but a hash gives up
// nothing, so pw stays secret.
attacker[active]
principal Client[
	knows private pw
	generates a
	ga = PUBKEY(a)
]
Client -> Server: ga
principal Server[
	knows private pw
	generates b
	gb = PUBKEY(b)
]
Server -> Client: gb
principal Client[
	k = DH_KEX(gb, a)
	proof = HASH(pw, ga, gb)
	generates n
	e = AEAD_ENC(k, n, proof, nil)
]
Client -> Server: n, e
principal Server[
	ks = DH_KEX(ga, b)
	p = AEAD_DEC(ks, n, e, nil)?
	_ = ASSERT(p, HASH(pw, ga, gb))?
]
queries[
	confidentiality? pw
]

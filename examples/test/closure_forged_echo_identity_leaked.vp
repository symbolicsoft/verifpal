//
// Expected: c1 at one session and at two.
//
// closure_forged_echo_identity.vp with Alice leaking her own x in phase 1. The
// attacker now holds x twice over, once as Bob's echo of its own forgery and
// once from Alice, and the second disclosure rests on no install, so x is
// genuine and reveals s1.
attacker[active]

principal Alice[
	generates k, na, m
	s1, s2 = THRESHOLD_SPLIT[2](k)
	ca = PUBKEY(na)
	x = THRESHOLD_SIGN[forgeable](s1, na, ca, m)
	leaks na
]

Alice -> Bob: ca, m

principal Carol[
	generates kc, nc, mc
	c1, c2 = THRESHOLD_SPLIT[2](kc)
	cc = PUBKEY(nc)
	y = THRESHOLD_SIGN(c1, nc, cc, mc)
]

Carol -> Bob: y

principal Bob[
	w1, w2 = SPLIT(CONCAT(y, nil))
]

Bob -> Dave: w1

principal Dave[
	_ = HASH(w1)
]

phase[1]

principal Alice[
	leaks x
]

queries[
	confidentiality? s1
]

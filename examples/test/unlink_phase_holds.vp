attacker[passive]

principal Alice[
	knows public c1, c2
	generates seed0
	generates filler
]

Alice -> Bob: filler

principal Bob[
	_ = HASH(filler)
]

phase[1]

principal Alice[
	leaks seed0
]

phase[2]

principal Alice[
	generates seed2
	tok1 = HASH(seed2, c1)
	tok2 = HASH(seed2, c2)
]

Alice -> Bob: tok1, tok2

principal Bob[
	knows public c1, c2
	_ = HASH(tok1)
	_ = HASH(tok2)
]

queries[
	unlinkability? tok1, tok2
]

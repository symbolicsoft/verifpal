attacker[passive]

principal Alice[
	knows public c1, c2
	generates s1
	generates s2
	tok1 = HASH(s1, c1)
	tok2 = HASH(s2, c2)
	leaks tok1
	leaks tok2
]

Alice -> Bob: tok1, tok2

principal Bob[
	knows public c1, c2
	_ = HASH(tok1)
	_ = HASH(tok2)
]

queries[
	unlinkability? tok1, tok2
]

// Expected: a0 at one session, a1 at two.
//
// aead_nonce_reuse_same_ciphertext_no_retag.vp with Bob leaking k once he has
// checked e3, the counterweight to aead_nonce_reuse_retag_late_key.vp. e1 and
// e2 are one ciphertext, so no tag key falls before the leak, and nothing
// Bob receives can be built from a key the attacker learns only afterwards.
// The second session adds only the ordinary replay of its own n3 and e3.
attacker[active]

principal Alice[
	knows private k, m
	knows public n, ad1, ad3
	generates n3, m3
	e1 = AEAD_ENC(k, n, m, ad1)
	e2 = AEAD_ENC(k, n, m, ad1)
	e3 = AEAD_ENC(k, n3, m3, ad3)
]

Alice -> Bob: e1, e2, n3, e3

principal Bob[
	knows private k
	knows public ad3
	d3 = AEAD_DEC(k, n3, e3, ad3)?
	h = HASH(d3)
	leaks k
]

queries[
	authentication? Alice -> Bob: e3
]

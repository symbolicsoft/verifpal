//
// Expected: c1c1a1 — a "group key" handed to everyone who asks. The
// distribution message is encrypted to each member under a key the server also
// gives away, so the group key reaches the attacker by the same route it
// reaches the members, and every message under it follows.
//
// The authentication verdict is the second half of the same mistake: holding
// the group key, the attacker is a member, and a member can speak. Group
// membership and group authentication are the same thing under a shared
// symmetric key, which is the reason real group protocols carry per-sender
// signatures.

attacker[active]

principal Server[
	knows private distribution_key
	generates group_key
	generates n_wrapped
	wrapped = AEAD_ENC(distribution_key, n_wrapped, group_key, nil)
	leaks distribution_key
]

Server -> Alice: n_wrapped, wrapped
Server -> Bob: n_wrapped, wrapped

principal Alice[
	knows private distribution_key
	knows private m_alice
	alice_group = AEAD_DEC(distribution_key, n_wrapped, wrapped, nil)?
	generates n_post
	post = AEAD_ENC(alice_group, n_post, m_alice, nil)
]

Alice -> Bob: n_post, post

principal Bob[
	knows private distribution_key
	bob_group = AEAD_DEC(distribution_key, n_wrapped, wrapped, nil)?
	got = AEAD_DEC(bob_group, n_post, post, nil)?
	_ = HASH(got)
]

queries[
	confidentiality? group_key
	confidentiality? m_alice
	authentication? Alice -> Bob: post
]

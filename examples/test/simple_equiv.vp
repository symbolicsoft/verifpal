attacker[passive]

principal Server[
    generates x
    generates y
    gx = PUBKEY(x)
    gy = PUBKEY(y)
    gxy = DH_KEX(gx, y)
    gyx = DH_KEX(gy, x)
]

queries [
    equivalence? gxy, gyx
]

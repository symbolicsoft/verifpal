// Expected: c1c0c0c0 at one session and at two.
//
// Two ciphertexts under one key and nonce, with tuples of different widths as
// plaintexts. The first field of each lies over the same keystream, and the
// attacker knows the public header in the first, so it reads the keystream
// there and strips it from the second: x falls. Their second fields are both
// unknown and give up only their combination, and the third field of e2 has
// nothing beside it in e1. aead_nonce_reuse_known_field_reveals_hidden.vp
// makes the header private and x holds.
attacker[passive]

principal Alice[
	knows private k, n
	knows public hdr, ad
	generates s1, x, s2, s3
	e1 = AEAD_ENC(k, n, CONCAT(hdr, s1), ad)
	e2 = AEAD_ENC(k, n, CONCAT(x, s2, s3), ad)
]

Alice -> Bob: e1, e2

principal Bob[
	knows private k, n
	knows public ad
	d1 = AEAD_DEC(k, n, e1, ad)?
	d2 = AEAD_DEC(k, n, e2, ad)?
]

queries[
	confidentiality? x
	confidentiality? s1
	confidentiality? s2
	confidentiality? s3
]

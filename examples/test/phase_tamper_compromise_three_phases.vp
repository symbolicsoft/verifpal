attacker[active]

principal Bob[
	knows private b, s
	gb = G^b
	gs = G^s
]

Bob -> Alice: [gb], gs

principal Alice[
	generates e, m
	ge = G^e
	k = HASH(gs^e, gb^e)
	c = AEAD_ENC(k, m, nil)
]

Alice -> Bob: ge, c

phase[1]

principal Bob[leaks gs]

phase[2]

principal Bob[leaks b]

queries[
	confidentiality? m
]

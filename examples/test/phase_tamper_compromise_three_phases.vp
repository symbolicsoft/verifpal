attacker[active]

principal Bob[
	knows private b, s
	gb = PUBKEY(b)
	gs = PUBKEY(s)
]

Bob -> Alice: [gb], gs

principal Alice[
	generates e, m
	ge = PUBKEY(e)
	k = HASH(DH_KEX(gs, e), DH_KEX(gb, e))
	generates n_c
	c = AEAD_ENC(k, n_c, m, nil)
]

Alice -> Bob: ge, n_c, c

phase[1]

principal Bob[leaks gs]

phase[2]

principal Bob[leaks b]

queries[
	confidentiality? m
]

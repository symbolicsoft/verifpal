//
// Expected: c0 — relay_rewrap_oracle.vp with the answer withheld. Client still
// recovers a key from what Relay forwarded and still opens whatever Server
// sent, but it keeps the result, so there is nothing for the attacker to read.
//
// This is the counterweight to the refinement search. Building an abstraction
// in which a slot holds its honest value hands the solver more terms to reason
// about, and the hazard is that it starts deriving values the attacker cannot
// actually obtain. Every proposal still goes through the validator's own
// derivability proof, and this model is what says so: the same relay shape,
// the same reachable slots, and no attack.

attacker[active]

principal Server[
	knows private storage_key
	knows private document
	knows public label
	knows private n_storage
	wrapping = AEAD_ENC(storage_key, n_storage, label, label)
	generates n_sealed_doc
	sealed_doc = AEAD_ENC(wrapping, n_sealed_doc, document, label)
	generates n_rewrap_request
	rewrap_request = AEAD_ENC(AEAD_ENC(storage_key, n_storage, sealed_doc, label), n_rewrap_request, label, label)
]

Server -> Relay: n_sealed_doc, sealed_doc

principal Relay[
	knows private storage_key
	knows private relay_key
	knows public label
	knows private n_storage
	generates n_forwarded
	forwarded = AEAD_ENC(relay_key, n_forwarded, AEAD_ENC(storage_key, n_storage, sealed_doc, label), label)
]

Relay -> Client: n_forwarded, forwarded

Server -> Client: n_rewrap_request, rewrap_request

principal Client[
	knows private relay_key
	knows public label
	recovered = AEAD_DEC(relay_key, n_forwarded, forwarded, label)?
	opened = AEAD_DEC(recovered, n_rewrap_request, rewrap_request, label)?
	_ = HASH(opened)
]

queries[
	confidentiality? document
]

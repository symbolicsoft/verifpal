//
// Parse error: precondition is the only query option, and any other name
// inside a query's option brackets is rejected with a suggestion.

attacker[active]

principal Bob[
	knows private psk
	generates m
	e = ENC(psk, m)
]

Bob -> Alice: e

principal Alice[
	knows private psk
	m2 = DEC(psk, e)
]

Alice -> Carol: m2

principal Carol[
	_ = HASH(m2)
]

queries[
	authentication? Bob -> Alice: e[
		postcondition[Alice -> Carol: m2]
	]
]

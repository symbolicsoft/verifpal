//
// Expected: c1c0 — password extraction is decided level by level, all the way
// up. Both passwords sit three HASH levels down with public siblings at the
// top and bottom; the only difference is a secret sibling at the MIDDLE level
// of one of them, and that single unknown is enough to make the guess
// unverifiable.
//
// The corpus tested one level of nesting. Three is what catches an
// implementation that checks the innermost enclosing primitive and stops, or
// one that checks the outermost: either mistake reads pw_shut as extractable,
// because its outermost and innermost levels are both fully public.

attacker[passive]

principal Alice[
	knows password pw_open
	knows password pw_shut
	knows public tag
	generates hidden
	open_three = HASH(HASH(HASH(pw_open, tag), tag), tag)
	shut_three = HASH(HASH(HASH(pw_shut, tag), hidden), tag)
]

Alice -> Bob: open_three, shut_three

principal Bob[
	_ = HASH(open_three, shut_three)
]

queries[
	confidentiality? pw_open
	confidentiality? pw_shut
]

// Expected: u0 at one session and at two.
//
// unlink_forced_equality_two_keys.vp with Bob's first tag forgeable under
// ufk_k1, the counterweight to unlink_forced_equality_forgeable.vp. The
// attacker can mint tags under ufk_k1, but Bob's two tags are under two keys,
// so equal inputs still give different tags and nothing links them.
attacker[active]

principal Alice[
	generates ufk_na
]

principal Carol[
	generates ufk_nc
]

Alice -> Bob: ufk_na
Carol -> Bob: ufk_nc

principal Bob[
	knows private ufk_k1, ufk_k2
	ufk_p = MAC[forgeable](ufk_k1, ufk_na)
	ufk_q = MAC(ufk_k2, ufk_nc)
]

Bob -> Dave: ufk_p, ufk_q

principal Dave[
	_ = HASH(ufk_p)
	_ = HASH(ufk_q)
]

queries[
	unlinkability? ufk_p, ufk_q
]

// The attack needs exactly one substitution: mw_gb, which gives the attacker
// the shared secret. mw_decoy is mutable and irrelevant — a correct minimal
// witness must not mention it.

attacker[active]

principal Alice[
	knows private mw_a
	mw_ga = G^mw_a
	generates mw_m
	generates mw_decoy
]

principal Bob[
	knows private mw_b
	mw_gb = G^mw_b
]

Alice -> Bob: mw_ga, mw_decoy
Bob -> Alice: mw_gb

principal Alice[
	mw_ka = mw_gb^mw_a
	mw_e = ENC(mw_ka, mw_m)
]

Alice -> Bob: mw_e

queries[
	confidentiality? mw_m
]

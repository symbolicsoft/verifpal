// Expected: c1. mw_gb travels unguarded, so the attacker substitutes PUBKEY(nil),
// computes mw_ka = DH_KEX(mw_ga, nil) and opens mw_e. mw_decoy exists only to give
// the witness minimizer a mutation it must drop: the reported trace should name the
// mw_gb substitution and nothing else.
attacker[active]

principal Alice[
	knows private mw_a
	mw_ga = PUBKEY(mw_a)
	generates mw_m
	generates mw_decoy
]

principal Bob[
	knows private mw_b
	mw_gb = PUBKEY(mw_b)
]

Alice -> Bob: mw_ga, mw_decoy
Bob -> Alice: mw_gb

principal Alice[
	mw_ka = DH_KEX(mw_gb, mw_a)
	mw_e = ENC(mw_ka, mw_m)
]

Alice -> Bob: mw_e

queries[
	confidentiality? mw_m
]

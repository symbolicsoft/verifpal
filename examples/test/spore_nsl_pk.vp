// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: c0a1a0 — Needham-Schroeder-Lowe with peer instantiation. This is
// spore_ns_pk.vp plus Lowe's 1995 fix, and the fix works.
//
// Message 2 now carries the responder's identity, and the initiator checks
// it against the peer she believes she is talking to. That single ASSERT
// breaks step 4 of the attack the unfixed model exhibits: the attacker
// relays Bob's reply to Alice@2, but the reply names Bob while Alice@2 is
// running with Mallory, so she halts instead of sealing nr to Mallory's key.
// The attacker never gets a ciphertext it can open, and nr stays secret.
//
// Verifpal reports c1 for the unfixed protocol and c0 for this one, which is
// the discrimination Lowe's fix exists to make, and which needs the peer
// axis that scenarios[] declares: with one fixed cast the two protocols are
// indistinguishable at every session count.
//
// Modelling note. Bob's `ASSERT(id_b, ga)?` is what SPDL's pattern matching
// does for free — see the note in spore_ns_pk.vp.
//
// The two authentication queries are the peer axis read the other way round.
// m1 fails in both models, and legitimately: Mallory opens Alice@2's request
// with the private key she leaked and reseals it under Bob's, so Bob accepts a
// ciphertext no Alice run produced. Alice@2 is a run of Alice with a different
// peer binding, so it is not a run Bob's acceptance may be matched against,
// and widening the matching-run rule to every clone of a principal would lose
// exactly this attack. m2 holds in both: the attacker can route Alice's
// request into Bob's other scenario copy and bring that copy's reply back, but
// that copy is a run of the same Bob under the same peer binding — the
// scenario rebinds Alice, not Bob — and Alice accepts its reply once.

attacker[active]

principal Alice[
	knows private a
	knows public gpeer
	ga = PUBKEY(a)
	generates ni
]

principal Bob[
	knows private b
	gb = PUBKEY(b)
	generates nr
]

principal Mallory[
	knows private mk
	gm = PUBKEY(mk)
	leaks mk
]

Alice -> Bob: [ga]
Bob -> Alice: [gb]
Mallory -> Alice: [gm]

principal Alice[
	m1 = PKE_ENC(gpeer, CONCAT(ni, ga))
]

Alice -> Bob: m1

principal Bob[
	d1 = PKE_DEC(b, m1)
	ni_b, id_b = SPLIT(d1)?
	_ = ASSERT(id_b, ga)?
	m2 = PKE_ENC(id_b, CONCAT(ni_b, nr, gb))
]

Bob -> Alice: m2

principal Alice[
	d2 = PKE_DEC(a, m2)
	ni_a, nr_a, gb_a = SPLIT(d2)?
	_ = ASSERT(ni_a, ni)?
	_ = ASSERT(gb_a, gpeer)?
	m3 = PKE_ENC(gpeer, nr_a)
]

Alice -> Bob: m3

principal Bob[
	d3 = PKE_DEC(b, m3)
	_ = ASSERT(d3, nr)?
]

scenarios[
	Alice[gpeer = gb]
	Alice[gpeer = gm]
]

queries[
	confidentiality? nr
	authentication? Alice -> Bob: m1
	authentication? Bob -> Alice: m2
]

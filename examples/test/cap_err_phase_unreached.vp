//
// Sanity error: phase 5 is never reached, so this assumption has no effect. A
// weakening that silently does nothing reads as a check that was performed.
attacker[active]

principal Alice[
	knows private k
	knows private m
	knows public ad
	generates n_e
	e = AEAD_ENC[weak from phase 5](k, n_e, m, ad)
]

Alice -> Bob: n_e, e

principal Bob[
	knows private k
	knows public ad
	d = AEAD_DEC(k, n_e, e, ad)
	_ = HASH(d)
]

queries[
	confidentiality? m
]

// Expected: c1 at one session and at two.
//
// aead_nonce_reuse_counter.vp with a public first message. The attacker reads
// the keystream for the stuck counter off e1, whose plaintext it knows, and
// strips it from e2: m2 falls without the key.
attacker[passive]

principal Alice[
	knows private k
	knows public ctr
	knows public ad
	knows public m1
	generates m2
	e1 = AEAD_ENC(k, ctr, m1, ad)
	e2 = AEAD_ENC(k, ctr, m2, ad)
]

Alice -> Bob: e1, e2

principal Bob[
	knows private k
	knows public ctr
	knows public ad
	d1 = AEAD_DEC(k, ctr, e1, ad)?
	d2 = AEAD_DEC(k, ctr, e2, ad)?
]

queries[
	confidentiality? m2
]

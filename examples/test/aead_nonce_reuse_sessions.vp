//
// Expected: c0 at one session and at two. A declared nonce under a long-term
// key is the same nonce in every session, and each session encrypts a fresh
// message under it. One session is one ciphertext and nothing to compare it
// with. Two sessions put AEAD_ENC(k, n, m, ad) and AEAD_ENC(k, n, m#2, ad) on
// the wire together, which gives the attacker the XOR of m and m#2 and the tag
// key, but neither message while the other is unknown.
// aead_nonce_reuse_sessions_retag.vp uses the tag key the second session
// gives up.

attacker[passive]

principal Alice[
	knows private k
	knows private n
	knows public ad
	generates m
	e = AEAD_ENC(k, n, m, ad)
]

Alice -> Bob: e

principal Bob[
	knows private k
	knows private n
	knows public ad
	d = AEAD_DEC(k, n, e, ad)?
]

queries[
	confidentiality? m
]

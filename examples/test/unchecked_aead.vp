attacker[active]

principal Alice[
	knows private a
	a_public = PUBKEY(a)
]
principal Bob[
	knows private b
	b_public = PUBKEY(b)
]
Alice -> Bob   : [a_public]
Bob   -> Alice : [b_public]

principal Alice[
	generates plaintext
	generates ad
	ss         = DH_KEX(b_public, a)
	key        = HASH(ss)
	generates n_ciphertext
	ciphertext = AEAD_ENC(key, n_ciphertext, plaintext, ad)
]

Alice -> Bob: ad, n_ciphertext, ciphertext

principal Bob[
	ss_        = DH_KEX(a_public, b)
	key_       = HASH(ss_)
	plaintext_ = AEAD_DEC(key_, n_ciphertext, ciphertext, ad)
]

queries[
	confidentiality? plaintext
	authentication? Alice -> Bob : ciphertext
	authentication? Alice -> Bob : ad
]

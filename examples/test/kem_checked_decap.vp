// A KEM with explicit rejection, modelled by checking the decapsulation, which
// halts Bob on a malformed ciphertext instead of handing him a pseudorandom
// secret. Note what the check does not buy: because the encapsulation key is
// public, the attacker can always produce a well-formed ciphertext of its own,
// so authentication here comes from the signature and not from the check.

attacker[active]

principal Alice[
	knows private siga
	ga = PUBKEY(siga)
]

principal Bob[
	knows private dkb
	ekb = PUBKEY(dkb)
]

Alice -> Bob: [ga]
Bob -> Alice: [ekb]

principal Alice[
	knows private m
	generates r
	ss, ct = KEM_ENCAP(ekb, r)
	e = AEAD_ENC(ss, m, nil)
	sig = SIGN(siga, ct)
]

Alice -> Bob: ct, e, sig

principal Bob[
	_ = SIGNVERIF(ga, ct, sig)?
	ssb = KEM_DECAP(dkb, ct)?
	d = AEAD_DEC(ssb, e, nil)?
]

queries[
	confidentiality? m
	authentication? Alice -> Bob: ct
]

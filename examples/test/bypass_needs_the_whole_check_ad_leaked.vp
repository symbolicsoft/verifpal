//
// Expected: a1. The attacker knows the encryption key, nonce, and associated
// data, so it constructs a ciphertext of its choosing that Bob successfully
// decrypts.

attacker[active]

principal Alice[
	knows private k
	knows private ad
	leaks k
	leaks ad
	knows private plain
	generates n_c
	c = AEAD_ENC(k, n_c, plain, ad)
]

Alice -> Bob: n_c, c

principal Bob[
	knows private k
	knows private ad
	m = AEAD_DEC(k, n_c, c, ad)?
	generates s
	out = HASH(s, m)
]

Bob -> Alice: out

queries[
	authentication? Alice -> Bob: c
]

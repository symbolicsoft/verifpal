//
// Expected: a1 — the counterweight to bypass_needs_the_whole_check.vp.
//
// The same protocol with the associated data leaked as well. The attacker can
// now build AEAD_ENC(k, ., ad) for a plaintext of its choosing, so the check
// really is defeatable and Bob really does accept a value Alice never sent.
// Without this model, the fix that made the first one a0 could equally have
// been "never bypass an AEAD check".

attacker[active]

principal Alice[
	knows private k
	knows private ad
	leaks k
	leaks ad
	knows private plain
	generates n_c
	c = AEAD_ENC(k, n_c, plain, ad)
]

Alice -> Bob: n_c, c

principal Bob[
	knows private k
	knows private ad
	m = AEAD_DEC(k, n_c, c, ad)?
	generates s
	out = HASH(s, m)
]

Bob -> Alice: out

queries[
	authentication? Alice -> Bob: c
]

//
// Expected: a1 at one session and at two.
//
// narrate_install_before_capability_onset.vp with e1 never sent and Bob
// receiving in phase 1. There is no reuse pair on the wire, and the assumption
// is in force when the attacker builds its replacement for e2, so the trace
// names it.
attacker[active]

principal Alice[
	knows private k
	knows public ad1, ad2
	generates n, m1, m2
	e1 = AEAD_ENC[forgeable from phase 1](k, n, m1, ad1)
	e2 = AEAD_ENC(k, n, m2, ad2)
	leaks m1
]

phase[1]

Alice -> Bob: n, e2

principal Bob[
	knows private k
	knows public ad2
	d2 = AEAD_DEC(k, n, e2, ad2)?
]

queries[
	authentication? Alice -> Bob: e2
]

//
// Expected: u1 at one session and at two.
//
// unlink_container_echo_not_observed.vp with Alice sending b as well. Both
// values are now observed from Alice's own send, the attacker rebuilds each
// from the leaked s and its nonce, and s links them.
attacker[active]

principal Alice[
	knows private s
	generates n1, n2
	a = HASH(s, n1)
	b = HASH(s, n2)
	leaks s
]

Alice -> Relay: n1, n2, a, b

principal Relay[
	w = CONCAT(a, nil)
]

Relay -> Bob: n1, n2, w

principal Bob[
	_ = HASH(n1, n2, w)
]

queries[
	unlinkability? a, b
]

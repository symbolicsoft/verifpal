// Expected: a1 at one session and at two, reported as a replay.
//
// Alice signs a fresh m for Bob. Both modeled instances of Bob verify their
// incoming signatures before sealing the message for the peer selected by
// their scenario. The second Bob has Mallory as its peer, but still performs
// its signature check and uses m@2 successfully.
//
// Delivering Alice@2's m@2 and signature to the honest Bob therefore yields
// two successful uses of one signed flight. Nothing is forged: Alice signed
// it herself. Query scope selects the honest recipient for the reported
// violation; the other modeled recipient supplies the second acceptance.
// The classification and trace must identify this as a cross-scenario replay.

attacker[active]

principal Alice[
	knows private ska
	pka = PUBKEY(ska)
	generates m
	sig = SIGN(ska, m)
]

principal Mallory[
	knows private msk
	mpk = PUBKEY(msk)
	leaks msk
]

principal Bob[
	knows public peer
]

Mallory -> Bob: [mpk]

Alice -> Bob: [pka], m, sig

principal Bob[
	_ = SIGNVERIF(pka, m, sig)?
	sealed = PKE_ENC(peer, m)
	_ = HASH(m)
]

scenarios[
	Bob[peer = pka]
	Bob[peer = mpk]
]

queries[
	authentication? Alice -> Bob: m
]

//
// Expected: u0 at one session and at two.
//
// unlink_reuse_opened_content.vp with a nonce of its own for c. No nonce is
// reused, m2 stays hidden, and the attacker can neither open c nor rebuild
// b: the two have no term in common.
attacker[passive]

principal Alice[
	knows private k, ad
	generates n, ntwo, m1, m2
	a = AEAD_ENC(k, n, m1, ad)
	c = AEAD_ENC(k, ntwo, m2, ad)
	b = HASH(m2)
	leaks m1
]

Alice -> Bob: a, c, b

principal Bob[
	_ = HASH(a, c, b)
]

queries[
	unlinkability? c, b
]

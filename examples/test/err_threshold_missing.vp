// Expected: error — a split must state its threshold; there is no default, because
// // an implicit threshold hides the one number that matters.

attacker[passive]

principal Dealer[
	generates k
	s1, s2, s3 = THRESHOLD_SPLIT(k)
	_ = HASH(s1, s2, s3)
]

queries[
	confidentiality? k
]

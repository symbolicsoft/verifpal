// SPDX-License-Identifier: GPL-3.0-only
// Expected: c0c1c0c0c1a0a0a0f0f1e1e1u0
//
// Two passwords take different routes through one protocol. vault_pw is only
// ever used under PW_HASH and stays secret; login_pw lands in a plain HASH
// whose every other argument is public, so it can be guessed offline. That
// pair — c0 then c1 — is the whole point of the model.
//
// The MAC is declared forgeable and is INERT here: the result code is
// identical with and without the annotation, because the independent
// SIGNVERIF under a guarded long-term key stops the attack either way. That
// makes this a negative test — a declared capability must not manufacture an
// attack when something else already holds the line.

attacker[active]

principal Client[
	knows password vault_pw
	knows password login_pw
	knows public realm, nonce_seed
	knows private client_ltk
	client_ltpk = PUBKEY(client_ltk)
	generates client_eph
	client_ephpk = PUBKEY(client_eph)
	// Correct usage: the password never appears outside PW_HASH.
	vault_key = PW_HASH(vault_pw, realm)
	// Wrong usage: every sibling of login_pw here is public.
	login_probe = HASH(login_pw, realm, nonce_seed)
]

principal Server[
	knows public realm, nonce_seed
	knows private server_ltk
	server_ltpk = PUBKEY(server_ltk)
	generates server_eph
	server_ephpk = PUBKEY(server_eph)
	generates challenge
]

Client -> Server: [client_ltpk], client_ephpk, login_probe
Server -> Client: [server_ltpk], server_ephpk, challenge

principal Client[
	session = DH_KEX(server_ephpk, client_eph)
	wrapper = CONCAT(session, vault_key, challenge)
	w1, w2, w3 = SPLIT(wrapper)
	transport = HKDF(w1, w2, realm)
	// A nested CONCAT/SPLIT round trip that reduces straight back to w3.
	echo = SPLIT(CONCAT(w3, realm))
	generates secret_note
	blob = ENC(transport, secret_note)
	// Declared forgeable: the attacker can produce this tag without transport.
	tag = MAC[forgeable](transport, CONCAT(blob, echo))
	proof = SIGN(client_ltk, HASH(blob, tag, challenge))
]

Client -> Server: blob, tag, proof

principal Server[
	session_s = DH_KEX(client_ephpk, server_eph)
	// Server reconstructs the vault key from the password it also knows.
	knows password vault_pw
	vault_key_s = PW_HASH(vault_pw, realm)
	wrapper_s = CONCAT(session_s, vault_key_s, challenge)
	s1, s2, s3 = SPLIT(wrapper_s)
	transport_s = HKDF(s1, s2, realm)
	echo_s = SPLIT(CONCAT(s3, realm))
	_ = ASSERT(tag, MAC(transport_s, CONCAT(blob, echo_s)))?
	_ = SIGNVERIF(client_ltpk, HASH(blob, tag, challenge), proof)?
	note_s = DEC(transport_s, blob)
	receipt = ENC(transport_s, HASH(note_s, challenge))
]

Server -> Client: receipt

principal Client[
	_ = ASSERT(DEC(transport, receipt), HASH(secret_note, challenge))?
]

phase[1]

principal Server[
	leaks server_eph
]

queries[
	confidentiality? vault_pw
	confidentiality? login_pw
	confidentiality? secret_note
	confidentiality? transport
	confidentiality? challenge
	authentication? Client -> Server: blob[
		precondition[Server -> Client: receipt]
	]
	authentication? Client -> Server: proof
	authentication? Server -> Client: receipt
	freshness? secret_note
	freshness? realm
	equivalence? transport, transport_s
	equivalence? echo, echo_s
	unlinkability? login_probe, vault_key
]

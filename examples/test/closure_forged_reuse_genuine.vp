//
// Expected: c1 at one session and at two.
//
// closure_forged_reuse_bypass.vp with the outer key leaked. cfu_c1 is opened
// genuinely, the nonce reuse with cfu_c2, whose plaintext cfu_m2 leaks,
// recovers the genuine partial, and it reveals cfu_s1.
attacker[passive]
principal Alice[
	generates cfu_k0, cfu_na, cfu_m, cfu_n, cfu_m2
	knows private cfu_kae
	knows public cfu_ad
	cfu_s1, cfu_s2 = THRESHOLD_SPLIT[2](cfu_k0)
	cfu_ca = PUBKEY(cfu_na)
	cfu_x = THRESHOLD_SIGN[forgeable](cfu_s1, cfu_na, cfu_ca, cfu_m)
	cfu_hk = HASH(cfu_x)
	cfu_c1 = AEAD_ENC(cfu_kae, cfu_n, cfu_x, cfu_ad)
	cfu_c2 = AEAD_ENC(cfu_kae, cfu_n, cfu_m2, cfu_ad)
	cfu_outer = ENC(cfu_hk, cfu_c1)
	leaks cfu_na, cfu_hk, cfu_m2
]
Alice -> Bob: cfu_ca, cfu_m, cfu_n, cfu_outer, cfu_c2
principal Bob[
	_ = HASH(cfu_ca, cfu_m, cfu_n, cfu_outer, cfu_c2)
]
queries[
	confidentiality? cfu_s1
]

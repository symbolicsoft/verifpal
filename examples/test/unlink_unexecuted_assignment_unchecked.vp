// Expected: u1 at one session and at two.
//
// unlink_unexecuted_assignment.vp with Bob's ASSERT unchecked. The attacker
// replaces e with the leaked sealed, and Bob leaks d = s. Bob no longer halts,
// so he sends ack and Alice computes right = HASH(s, q) in that execution.
// left and right are both held, observable through the leaked left and second,
// and share s, which the attacker holds: u1.
attacker[active]

principal Alice[
	knows private k
	knows public p, q
	generates s, n
	ka = HASH(k, n)
	e = ENC(ka, nil)
	sealed = ENC(ka, s)
	left = HASH(s, p)
	second = HASH(s, q)
	leaks left, second, sealed
]

Alice -> Bob: [n], e

principal Bob[
	knows private k
	kb = HASH(k, n)
	d = DEC(kb, e)
	leaks d
	_ = ASSERT(d, nil)
	generates ack
]

Bob -> Alice: [ack]

principal Alice[
	right = HASH(s, q)
]

queries[
	unlinkability? left, right
]

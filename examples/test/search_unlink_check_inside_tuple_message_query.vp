//
// Expected: c1u1 at one session and at two.
//
// search_unlink_check_inside_tuple.vp also asking confidentiality? message:
// the execution that discloses message (c1) links the tuples (u1).

attacker[active]

principal Alice[
	knows private kb, kc, skone, sktwo
	generates x, y
	message = HASH(x, y)
	sigone = SIGN(skone, message)
	sigtwo = SIGN(sktwo, message)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	ex = ENC(kb, x)
	ey = ENC(kc, y)
	eskone = ENC(kb, skone)
	esktwo = ENC(kc, sktwo)
	eb = ENC(kb, nil)
	ec = ENC(kc, nil)
	wone = CONCAT(sigone, nil)
	wtwo = CONCAT(sigtwo, nil)
]

Alice -> Dave: ex, ey, pkone, pktwo, wone, wtwo, eskone, esktwo

Alice -> Bob: eb

Alice -> Carol: ec

principal Bob[
	knows private kb
	db = DEC(kb, eb)
	leaks db
]

principal Carol[
	knows private kc
	dc = DEC(kc, ec)
	leaks dc
]

principal Dave[
	_ = HASH(ex, ey, pkone, pktwo, wone)
	_ = HASH(wtwo, eskone, esktwo)
]

queries[
	confidentiality? message
	unlinkability? wone, wtwo
]

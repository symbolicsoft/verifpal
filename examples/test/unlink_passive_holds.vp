attacker[passive]

principal Alice[
	knows public c1, c2
	generates a
	ga = PUBKEY(a)
]

Alice -> Bob: ga

principal Bob[
	knows public c1, c2
	generates b
	gb = PUBKEY(b)
	k = DH_KEX(ga, b)
	tok1 = HASH(k, c1)
	tok2 = HASH(k, c2)
]

Bob -> Alice: gb, tok1, tok2

principal Alice[
	_ = HASH(tok1)
	_ = HASH(tok2)
]

queries[
	unlinkability? tok1, tok2
]

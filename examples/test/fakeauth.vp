// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: a1 at one session and at two. The phone accepts the wrapped
// private key only through a checked AEAD_DEC under a key derived from the
// private password, which the attacker never holds, so no blob but the one
// Alice stored passes. But Alice uploads that blob in the clear, so the
// Server's ASSERT on the phone's credential does not decide whether the
// phone gets it. At one session the attacker replaces
// alicephone_master_auth with nil, the Server halts at its ASSERT before
// releasing the blob, and the attacker hands the phone the ciphertext it
// observed on Alice's upload: the phone accepts a blob the Server never
// sent. The judge once excused a delivered value equal to the honest one
// when the sender had not sent it, and pinned a0 at one session.
// The nonce on `n_e_alice_private_key` is declared rather than generated, so
// the ciphertext is the same value in every session. At two sessions the
// attacker halts one Server run the same way and delivers the blob the other
// Server run sent in its place. The phones accept one emission twice: a
// duplicate acceptance, not a forgery (GitHub issue #39). The judge once
// dismissed an installed value equal to the recipient's honest one before
// counting emissions.

attacker[active]

principal Alice[
    knows public const_e
    knows public alice_username
    knows private alice_password
    alice_master_decryption, alice_master_auth = HKDF(alice_username, HASH(alice_password), const_e)
    knows private alice_private_key
    knows private n_e_alice_private_key
    e_alice_private_key = AEAD_ENC(alice_master_decryption, n_e_alice_private_key, alice_private_key, alice_username)
    alice_public_key = PUBKEY(alice_private_key)
]

Alice -> Server: [n_e_alice_private_key], [e_alice_private_key], [alice_master_auth], [alice_public_key]

principal Alice[
    generates e_a
    generates n_e_e_a
    e_e_a = AEAD_ENC(alice_private_key, n_e_e_a, e_a, alice_username)
]

Alice -> Server: n_e_e_a, e_e_a

principal AlicePhone[
    knows public const_e
    knows public alice_username
    knows private alice_password
    alicephone_master_decryption, alicephone_master_auth = HKDF(alice_username, HASH(alice_password), const_e)
]

AlicePhone -> Server: alicephone_master_auth

principal Server[
    _ = ASSERT(alicephone_master_auth, alice_master_auth)?
]

Server -> AlicePhone: n_e_alice_private_key, e_alice_private_key

principal AlicePhone[
	alicephone_private_key = AEAD_DEC(alicephone_master_decryption, n_e_alice_private_key, e_alice_private_key, alice_username)?
]

queries[
    authentication? Server -> AlicePhone: e_alice_private_key
]

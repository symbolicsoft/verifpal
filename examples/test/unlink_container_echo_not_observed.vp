//
// Expected: u0 at one session and at two.
//
// unlink_relay_echo_not_observed.vp with Relay wrapping a in a tuple before it
// forwards it. b never leaves Alice. The attacker can build HASH(s, n2) itself
// and install it as Relay's a, and Relay's tuple then carries it to Bob. Relay
// holds the tuple as a value it computed, so its send is a disclosure, and
// opening the tuple once made b observable through the attacker's own value.
// What the attacker supplied into a disclosed value is not observed by opening
// it. unlink_container_echo_sent.vp is the counterweight.
attacker[active]

principal Alice[
	knows private s
	generates n1, n2
	a = HASH(s, n1)
	b = HASH(s, n2)
	leaks s
]

Alice -> Relay: n1, n2, a

principal Relay[
	w = CONCAT(a, nil)
]

Relay -> Bob: n1, n2, w

principal Bob[
	_ = HASH(n1, n2, w)
]

queries[
	unlinkability? a, b
]

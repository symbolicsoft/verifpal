//
// Expected: c1 at one session and at two.
//
// Bob opens Alice's guarded ciphertext under the key he derives from her
// ephemeral share and splits the plaintext without checking it. The attacker
// replaces `ga` with PUBKEY(nil): Bob's key becomes one it can compute, his
// decryption of `c` no longer matches, and his unchecked SPLIT continues with
// the unreduced term SPLIT(DEC(kb, c)), as an unmatched call does. The
// attacker holds `kb` and `c`, so it applies DEC and SPLIT itself, gets `y`,
// and opens `e`. SPLIT is a public function like any other: a principal that
// keeps its unreduced application as a value keeps one the attacker can
// compute from the same inputs. The engine once refused every core
// application that did not reduce, so `y` stayed out of reach.
// core_split_checked_junk.vp is the counterweight.
attacker[active]
principal Bob[
	knows private b
	gb = PUBKEY(b)
]
Bob -> Alice: [gb]
principal Alice[
	generates a, na, s
	ga = PUBKEY(a)
	ka = DH_KEX(gb, a)
	c = ENC(ka, CONCAT(na, s))
]
Alice -> Bob: ga, [c]
principal Bob[
	generates s2
	kb = DH_KEX(ga, b)
	x, y = SPLIT(DEC(kb, c))
	e = ENC(HASH(y), s2)
]
Bob -> Alice: e
queries[
	confidentiality? s2
]

// Expected: c0 at one session and at two.
//
// aead_nonce_reuse_shared_dag_known.vp with right encrypted under its own
// nonce. x is leaked and the attacker knows the plaintext of left, but left
// and right no longer share a keystream, so nothing about right follows and y
// stays hidden.
attacker[passive]
principal Alice[
	knows private k, n, nother
	generates x, y
	a0 = CONCAT(x, x)
	a1 = CONCAT(a0, a0)
	a2 = CONCAT(a1, a1)
	a3 = CONCAT(a2, a2)
	a4 = CONCAT(a3, a3)
	a5 = CONCAT(a4, a4)
	a6 = CONCAT(a5, a5)
	a7 = CONCAT(a6, a6)
	a8 = CONCAT(a7, a7)
	a9 = CONCAT(a8, a8)
	a10 = CONCAT(a9, a9)
	a11 = CONCAT(a10, a10)
	a12 = CONCAT(a11, a11)
	a13 = CONCAT(a12, a12)
	a14 = CONCAT(a13, a13)
	a15 = CONCAT(a14, a14)
	a16 = CONCAT(a15, a15)
	a17 = CONCAT(a16, a16)
	a18 = CONCAT(a17, a17)
	a19 = CONCAT(a18, a18)
	a20 = CONCAT(a19, a19)
	a21 = CONCAT(a20, a20)
	a22 = CONCAT(a21, a21)
	a23 = CONCAT(a22, a22)
	a24 = CONCAT(a23, a23)
	a25 = CONCAT(a24, a24)
	a26 = CONCAT(a25, a25)
	a27 = CONCAT(a26, a26)
	a28 = CONCAT(a27, a27)
	a29 = CONCAT(a28, a28)
	a30 = CONCAT(a29, a29)
	a31 = CONCAT(a30, a30)
	a32 = CONCAT(a31, a31)
	a33 = CONCAT(a32, a32)
	a34 = CONCAT(a33, a33)
	a35 = CONCAT(a34, a34)
	a36 = CONCAT(a35, a35)
	a37 = CONCAT(a36, a36)
	a38 = CONCAT(a37, a37)
	a39 = CONCAT(a38, a38)
	a40 = CONCAT(a39, a39)
	a41 = CONCAT(a40, a40)
	a42 = CONCAT(a41, a41)
	a43 = CONCAT(a42, a42)
	a44 = CONCAT(a43, a43)
	a45 = CONCAT(a44, a44)
	a46 = CONCAT(a45, a45)
	a47 = CONCAT(a46, a46)
	b0 = CONCAT(y, y)
	b1 = CONCAT(b0, b0)
	b2 = CONCAT(b1, b1)
	b3 = CONCAT(b2, b2)
	b4 = CONCAT(b3, b3)
	b5 = CONCAT(b4, b4)
	b6 = CONCAT(b5, b5)
	b7 = CONCAT(b6, b6)
	b8 = CONCAT(b7, b7)
	b9 = CONCAT(b8, b8)
	b10 = CONCAT(b9, b9)
	b11 = CONCAT(b10, b10)
	b12 = CONCAT(b11, b11)
	b13 = CONCAT(b12, b12)
	b14 = CONCAT(b13, b13)
	b15 = CONCAT(b14, b14)
	b16 = CONCAT(b15, b15)
	b17 = CONCAT(b16, b16)
	b18 = CONCAT(b17, b17)
	b19 = CONCAT(b18, b18)
	b20 = CONCAT(b19, b19)
	b21 = CONCAT(b20, b20)
	b22 = CONCAT(b21, b21)
	b23 = CONCAT(b22, b22)
	b24 = CONCAT(b23, b23)
	b25 = CONCAT(b24, b24)
	b26 = CONCAT(b25, b25)
	b27 = CONCAT(b26, b26)
	b28 = CONCAT(b27, b27)
	b29 = CONCAT(b28, b28)
	b30 = CONCAT(b29, b29)
	b31 = CONCAT(b30, b30)
	b32 = CONCAT(b31, b31)
	b33 = CONCAT(b32, b32)
	b34 = CONCAT(b33, b33)
	b35 = CONCAT(b34, b34)
	b36 = CONCAT(b35, b35)
	b37 = CONCAT(b36, b36)
	b38 = CONCAT(b37, b37)
	b39 = CONCAT(b38, b38)
	b40 = CONCAT(b39, b39)
	b41 = CONCAT(b40, b40)
	b42 = CONCAT(b41, b41)
	b43 = CONCAT(b42, b42)
	b44 = CONCAT(b43, b43)
	b45 = CONCAT(b44, b44)
	b46 = CONCAT(b45, b45)
	b47 = CONCAT(b46, b46)
	left = AEAD_ENC(k, n, a47, nil)
	right = AEAD_ENC(k, nother, b47, nil)
	leaks x
]
Alice -> Bob: left, right
principal Bob[
	_ = HASH(left, right)
]
queries[
	confidentiality? y
]

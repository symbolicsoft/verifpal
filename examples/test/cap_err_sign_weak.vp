//
// Sanity error: SIGN provides authenticity, not confidentiality, so `weak` has
// nothing to reveal. Must point at `forgeable` rather than silently do nothing.
attacker[active]

principal Alice[
	knows private sk
	knows private m
	s = SIGN[weak](sk, m)
]

Alice -> Bob: s

principal Bob[
	_ = HASH(s)
]

queries[
	confidentiality? m
]

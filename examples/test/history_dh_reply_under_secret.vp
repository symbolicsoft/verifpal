//
// Expected: c1c0 at one session and at two.
//
// The Diffie-Hellman shape, with a counterweight in the same model. Alice's
// share is unguarded, so swapping it really does give the attacker the
// session key and `early` is disclosed: that value is sealed in the same
// execution the swap creates. `late` is sealed under the key of the
// execution where the share is honest, and pairing it with the swapped
// key's secret is the cross-execution read the world of each value refuses.
attacker[active]
principal Alice[
	generates a
	ga = PUBKEY(a)
]
Alice -> Bob: ga
principal Bob[
	generates b
	gb = PUBKEY(b)
	k = DH_KEX(ga, b)
	knows private early
	generates n1
	e1 = AEAD_ENC(k, n1, early, nil)
]
Bob -> Alice: [gb], n1, e1
principal Alice[
	ka = DH_KEX(gb, a)
	knows private late
	generates n2
	e2 = AEAD_ENC(ka, n2, late, nil)
]
Alice -> Bob: n2, e2
principal Bob[
	_ = HASH(n2, e2)
]
queries[
	confidentiality? early
	confidentiality? late
]

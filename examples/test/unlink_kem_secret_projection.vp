// Expected: u0c0 at both session counts. A decapsulation key cannot test
// shared-secret outputs: KEM_DECAP accepts only the ciphertext projection.
// Neither ciphertext nor independent randomness is ever disclosed, so the
// attacker can neither test nor reconstruct the two shared secrets.
attacker[passive]

principal Alice[
	knows private k
	pk = PUBKEY(k)
	leaks k
	generates r1, r2
	s1, c1 = KEM_ENCAP(pk, r1)
	s2, c2 = KEM_ENCAP(pk, r2)
]

Alice -> Bob: s1, s2

principal Bob[]

queries[
	unlinkability? s1, s2
	confidentiality? r1
]

//
// Expected: c1c0a1a0 — a post-quantum KEM does not repair a password. The
// shared secret is real and unguessable, but the KEM ciphertext travels in the
// clear, so a transcript tag computed as MAC(password, ciphertext) is an
// offline verifier over a value the attacker already holds. The same tag under
// PW_HASH of a password is not.
//
// This is the one place the password machinery and the KEM machinery have to
// agree, and they have to disagree about direction: find_obtainable_passwords
// descends into the tag's key argument while the encapsulation sitting in the
// tag's other argument stays entirely opaque. A descent that treated an
// unopened KEM ciphertext as an unknown sibling would report pw_raw safe.
//
// The authentication half is the attack the disclosure buys: holding pw_raw
// the attacker encapsulates to Bob's own public key, sends its ciphertext, and
// tags it. Bob accepts and decapsulates a secret the attacker chose.

attacker[active]

principal Bob[
	knows private dk
	ek = PUBKEY(dk)
]

Bob -> Alice: [ek]

principal Alice[
	knows password pw_raw
	knows password pw_hard
	generates r_raw, r_hard
	ss_raw, ct_raw = KEM_ENCAP(ek, r_raw)
	ss_hard, ct_hard = KEM_ENCAP(ek, r_hard)
	tag_raw = MAC(pw_raw, ct_raw)
	tag_hard = MAC(PW_HASH(pw_hard), ct_hard)
]

Alice -> Bob: ct_raw, tag_raw, ct_hard, tag_hard

principal Bob[
	knows password pw_raw
	knows password pw_hard
	_ = ASSERT(MAC(pw_raw, ct_raw), tag_raw)?
	_ = ASSERT(MAC(PW_HASH(pw_hard), ct_hard), tag_hard)?
	back_raw = KEM_DECAP(dk, ct_raw)
	back_hard = KEM_DECAP(dk, ct_hard)
	_ = HASH(back_raw, back_hard)
]

queries[
	confidentiality? pw_raw
	confidentiality? pw_hard
	authentication? Alice -> Bob: ct_raw
	authentication? Alice -> Bob: ct_hard
]

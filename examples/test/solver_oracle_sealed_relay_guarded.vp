//
// Expected: c0 at one session and at two.
//
// solver_oracle_sealed_relay.vp with both Diffie-Hellman shares guarded. The
// channel keys are then known only to Alice and Bob, the attacker can open
// neither the challenge nor the signature, and Bob as an oracle answers only
// what Alice sent him. The relay needs both shares replaced, so it is gone.
attacker[active]

principal Bob[
	knows private skb
	pkb = PUBKEY(skb)
]

Bob -> Alice: [pkb]

principal Alice[
	knows private a
	ga = PUBKEY(a)
]

Alice -> Bob: [ga]

principal Bob[
	generates e
	ge = PUBKEY(e)
	kb = HASH(DH_KEX(ga, e))
]

Bob -> Alice: [ge]

principal Alice[
	ka = HASH(DH_KEX(ge, a))
	generates r
	cr = ENC(ka, r)
]

Alice -> Bob: cr

principal Bob[
	rb = DEC(kb, cr)
	sig = SIGN(skb, rb)
	cs = ENC(kb, sig)
]

Bob -> Alice: cs

principal Alice[
	_ = SIGNVERIF(pkb, r, DEC(ka, cs))?
	generates secret
	csec = ENC(ka, secret)
]

Alice -> Bob: csec

principal Bob[
	sb = DEC(kb, csec)
]

queries[
	confidentiality? secret
]

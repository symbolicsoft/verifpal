// The KEM analogue of the Diffie-Hellman mayor-in-the-middle. With Bob's
// encapsulation key unguarded, the attacker substitutes its own, Alice
// encapsulates to it, and the attacker decapsulates with the matching private key.

attacker[active]

principal Bob[
	knows private dkb
	ekb = PUBKEY(dkb)
]

Bob -> Alice: ekb

principal Alice[
	knows private m
	generates r
	ss, ct = KEM_ENCAP(ekb, r)
	generates n_e
	e = AEAD_ENC(ss, n_e, m, nil)
]

Alice -> Bob: ct, n_e, e

principal Bob[
	ssb = KEM_DECAP(dkb, ct)
	d = AEAD_DEC(ssb, n_e, e, nil)?
]

queries[
	confidentiality? m
	authentication? Alice -> Bob: e
]

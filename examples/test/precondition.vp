//
// Expected: a1
//
// The manual's example. Alice's MAC check is unchecked, so a replay of e and
// h from Bob's other session is accepted, decrypted and forwarded: one send
// of e is accepted twice, and Alice still sends m2 to Carol, so the failure
// falls inside the precondition and the gated query is contradicted.

attacker[active]

principal Bob[
	knows private psk
	generates m
	e = ENC(psk, m)
	h = MAC(psk, e)
]

Bob -> Alice: e, h

principal Alice[
	knows private psk
	_ = ASSERT(MAC(psk, e), h)
	m2 = DEC(psk, e)
]

Alice -> Carol: [m2]

principal Carol[
	_ = HASH(m2)
]

queries[
	authentication? Bob -> Alice: e[
		precondition[Alice -> Carol: m2]
	]
]

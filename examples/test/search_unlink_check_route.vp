//
// Expected: u1 at one session and at two (GitHub issue #57).
//
// Alice signs message = HASH(x, y) under skone and sktwo and sends both
// public keys. Replacing eb with ex makes Bob leak x and replacing ec with ey
// makes Carol leak y, so the attacker rebuilds message and SIGNVERIF confirms
// it for both signatures: neither signing key is needed. Bob and Carol could
// leak skone and sktwo from eskone and esktwo instead, but at one session Bob
// leaks skone or x, never both, so a merge of every missing argument, which
// rebuilding a signature needs, has no plan. The check's own missing input is
// message alone.
// _unsent_keys, _message_query and _guarded are the counterweights.

attacker[active]

principal Alice[
	knows private kb, kc, skone, sktwo
	generates x, y
	message = HASH(x, y)
	sigone = SIGN(skone, message)
	sigtwo = SIGN(sktwo, message)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	ex = ENC(kb, x)
	ey = ENC(kc, y)
	eskone = ENC(kb, skone)
	esktwo = ENC(kc, sktwo)
	eb = ENC(kb, nil)
	ec = ENC(kc, nil)
]

Alice -> Dave: ex, ey, pkone, pktwo, sigone, sigtwo, eskone, esktwo

Alice -> Bob: eb

Alice -> Carol: ec

principal Bob[
	knows private kb
	db = DEC(kb, eb)
	leaks db
]

principal Carol[
	knows private kc
	dc = DEC(kc, ec)
	leaks dc
]

principal Dave[
	_ = HASH(ex, ey, pkone, pktwo, sigone)
	_ = HASH(sigtwo, eskone, esktwo)
]

queries[
	unlinkability? sigone, sigtwo
]

//
// Expected: e0 — Alice packs one nonce twice into a bundle and Bob splits it,
// over a guarded wire. The bundle Bob projects is the bundle Alice packed, so
// its halves agree.
//
// With the wire open the attacker sends a bundle whose fields differ, as
// equiv_forged_bundle_far_fields.vp shows at five fields. This model checks
// that the divergence search is still asking whether the attacker may touch the
// slot before asking what it would put there.

attacker[active]

principal Alice[
	generates n
	bundle = CONCAT(n, n)
]

Alice -> Bob: [bundle]

principal Bob[
	left, right = SPLIT(bundle)?
	_ = HASH(left, right)
]

queries[
	equivalence? left, right
]

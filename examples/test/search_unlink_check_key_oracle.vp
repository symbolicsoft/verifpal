//
// Expected: u1 at one session and at two (GitHub issue #59).
//
// As search_unlink_check_route.vp, but Alice sends the public keys only
// inside ekeys. Bob and Carol leak x and y, Erin opens ekeys, and SIGNVERIF
// confirms message under PUBKEY(skone) and PUBKEY(sktwo). Those are inputs of
// the check that undoes each signature, not arguments of it, so no set of the
// signatures' arguments names them: the merge targets the check's missing
// inputs, message and the public keys, from all three oracles at once.
// _public_keys, _witness, _message_query and _guarded are the counterweights.

attacker[active]

principal Alice[
	knows private kb, kc, kd, skone, sktwo
	generates x, y
	message = HASH(x, y)
	sigone = SIGN(skone, message)
	sigtwo = SIGN(sktwo, message)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	witness = HASH(message, pkone, pktwo)
	ex = ENC(kb, x)
	ey = ENC(kc, y)
	ekeys = ENC(kd, CONCAT(pkone, pktwo))
	eb = ENC(kb, nil)
	ec = ENC(kc, nil)
	ed = ENC(kd, nil)
]

Alice -> Dave: ex, ey, ekeys, sigone, sigtwo

Alice -> Bob: eb

Alice -> Carol: ec

Alice -> Erin: ed

principal Bob[
	knows private kb
	db = DEC(kb, eb)
	leaks db
]

principal Carol[
	knows private kc
	dc = DEC(kc, ec)
	leaks dc
]

principal Erin[
	knows private kd
	dd = DEC(kd, ed)
	leaks dd
]

principal Dave[
	_ = HASH(ex, ey, ekeys, sigone)
	_ = HASH(sigtwo)
]

queries[
	unlinkability? sigone, sigtwo
]

attacker[passive]

principal Alice[
	knows private x
	knows public c
	e = ENC(c, c)
	a1 = DEC(c, e)
	ga1 = PUBKEY(a1)
	b1 = HASH(x)
	s = DH_KEX(ga1, b1)
]

queries[
	confidentiality? s
	confidentiality? b1
]

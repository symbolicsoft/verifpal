//
// Expected: u0 at one session and at two.
//
// search_unlink_single_argument.vp with eb guarded: Bob decrypts only
// ENC(kb, nil), so x and skone stay secret. Carol can still leak y or
// sktwo, but without x the attacker never obtains message, and every tie
// between the two signatures passes through it.
attacker[active]

principal Alice[
	knows private kb, kc, skone, sktwo
	generates x, y
	message = HASH(x, y)
	sigone = SIGN(skone, message)
	sigtwo = SIGN(sktwo, message)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	ex = ENC(kb, x)
	ey = ENC(kc, y)
	eskone = ENC(kb, skone)
	esktwo = ENC(kc, sktwo)
	eb = ENC(kb, nil)
	ec = ENC(kc, nil)
]

Alice -> Dave: ex, ey, pkone, pktwo, sigone, sigtwo, eskone, esktwo
Alice -> Bob: [eb]
Alice -> Carol: ec

principal Bob[
	knows private kb
	db = DEC(kb, eb)
	leaks db
]

principal Carol[
	knows private kc
	dc = DEC(kc, ec)
	leaks dc
]

principal Dave[
	_ = HASH(ex, ey, pkone, pktwo, sigone)
	_ = HASH(sigtwo, eskone, esktwo)
]

queries[
	unlinkability? sigone, sigtwo
]

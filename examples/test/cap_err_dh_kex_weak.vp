//
// Sanity error: discrete log is a property of the key, not the exchange, so
// this must point at PUBKEY[weak] instead.
attacker[active]

principal Alice[
	generates a
	ga = PUBKEY(a)
]

principal Bob[
	generates b
	gb = PUBKEY(b)
]

Alice -> Bob: ga
Bob -> Alice: gb

principal Alice[
	knows private m
	k = DH_KEX[weak](gb, a)
	generates n_e
	e = AEAD_ENC(k, n_e, m, nil)
]

Alice -> Bob: n_e, e

principal Bob[
	kb = DH_KEX(ga, b)
	mb = AEAD_DEC(kb, n_e, e, nil)
]

queries[
	confidentiality? m
]

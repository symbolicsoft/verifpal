// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: a1 at one session and at two.
//
// Alice accepts Bob's first box only after verifying the signature inside it,
// and sends her reply under the same key afterwards; Bob's second box exists
// only once he has a reply. That reply need not come from Alice. The key and
// the associated data are the same in both directions, so the attacker hands
// Bob his own first box, observed on the wire, as Alice's reply before she has
// sent one: Bob's check passes and he answers with box3. Handed to Alice as
// her first box, box3 decrypts, so she uses it; her signature check then
// fails, but every slot that mentions box1 is reached and its first use
// passed, so the acceptance stands. Every step happens in one execution, in
// order: Bob emits box1 before receiving it back, and Alice receives box3
// only after Bob emits it.
//
// The engine once pinned a0 at one session, reasoning that Bob's second box
// needs a reply Alice sends only after accepting a first one; that overlooks
// reflecting Bob's own box. At two sessions the same reflection also works
// through Bob#2. Nothing in the witness depends on a value Alice's own run
// computes later. history_own_early_emission.vp is the counterweight.

attacker[active]

principal Alice[
	generates ea
	gea = PUBKEY(ea)
]

principal Bob[
	knows private lb
	glb = PUBKEY(lb)
	generates eb
	geb = PUBKEY(eb)
]

Bob -> Alice: [glb]

Alice -> Bob: gea

Bob -> Alice: geb

principal Alice[
	k_a = HASH(DH_KEX(geb, ea), DH_KEX(glb, ea))
]

principal Bob[
	k_b = HASH(DH_KEX(gea, eb), DH_KEX(gea, lb))
	sig = SIGN(lb, HASH(gea, geb))
	generates n1
	box1 = AEAD_ENC(k_b, n1, sig, nil)
]

Bob -> Alice: n1, box1

principal Alice[
	s = AEAD_DEC(k_a, n1, box1, nil)?
	_ = SIGNVERIF(glb, HASH(gea, geb), s)?
	knows private m1
	generates n2
	box2 = AEAD_ENC(k_a, n2, m1, nil)
]

Alice -> Bob: n2, box2

principal Bob[
	m1b = AEAD_DEC(k_b, n2, box2, nil)?
	knows private m2
	generates n3
	box3 = AEAD_ENC(k_b, n3, m2, nil)
]

Bob -> Alice: n3, box3

principal Alice[
	m2a = AEAD_DEC(k_a, n3, box3, nil)?
]

queries[
	authentication? Bob -> Alice: box1
]

// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: a0 at one session and a1 at two.
//
// Alice accepts Bob's first box only after verifying the signature inside it,
// and sends her reply under the same key afterwards; Bob's second box exists
// only once he has a reply. At one session the only box that opens under
// Alice's key is one her own Bob made, and his second box needs the reply she
// sends only after accepting a first one, so the query holds.
//
// At two sessions it fails by reflection. The attacker routes Alice's key share
// into Bob#2 and hands Bob#2 its own first box back as Alice's reply: the key
// and the associated data are the same in both directions, so Bob#2's check
// passes, and Bob#2 answers with box3#2 under the key it now shares with Alice.
// Handed to Alice as her first box, that box decrypts, so she uses it; her
// signature check then fails, but every slot that mentions box1 is reached and
// its first use passed, so the acceptance stands. Nothing in the witness
// depends on a value Alice's own run computes later. history_own_early_emission.vp
// is the counterweight.

attacker[active]

principal Alice[
	generates ea
	gea = PUBKEY(ea)
]

principal Bob[
	knows private lb
	glb = PUBKEY(lb)
	generates eb
	geb = PUBKEY(eb)
]

Bob -> Alice: [glb]

Alice -> Bob: gea

Bob -> Alice: geb

principal Alice[
	k_a = HASH(DH_KEX(geb, ea), DH_KEX(glb, ea))
]

principal Bob[
	k_b = HASH(DH_KEX(gea, eb), DH_KEX(gea, lb))
	sig = SIGN(lb, HASH(gea, geb))
	generates n1
	box1 = AEAD_ENC(k_b, n1, sig, nil)
]

Bob -> Alice: n1, box1

principal Alice[
	s = AEAD_DEC(k_a, n1, box1, nil)?
	_ = SIGNVERIF(glb, HASH(gea, geb), s)?
	knows private m1
	generates n2
	box2 = AEAD_ENC(k_a, n2, m1, nil)
]

Alice -> Bob: n2, box2

principal Bob[
	m1b = AEAD_DEC(k_b, n2, box2, nil)?
	knows private m2
	generates n3
	box3 = AEAD_ENC(k_b, n3, m2, nil)
]

Bob -> Alice: n3, box3

principal Alice[
	m2a = AEAD_DEC(k_a, n3, box3, nil)?
]

queries[
	authentication? Bob -> Alice: box1
]

//
// Expected: c0 at one session and at two.
//
// One plaintext, one key, one nonce, two associated-data values. The two
// ciphertext bodies are identical, but GHASH runs over the associated data
// too, so the two tags differ under one mask and the pair gives up the
// authentication key. It gives up no plaintext: the XOR of two equal
// plaintexts is zero. aead_nonce_reuse_same_plaintext_retag.vp uses the
// authentication key this pair gives up.
attacker[passive]

principal Alice[
	knows private k
	knows private n
	knows private m
	knows public ad1, ad2
	e1 = AEAD_ENC(k, n, m, ad1)
	e2 = AEAD_ENC(k, n, m, ad2)
]

Alice -> Bob: e1, e2

principal Bob[
	knows private k
	knows private n
	knows public ad1, ad2
	d1 = AEAD_DEC(k, n, e1, ad1)?
	d2 = AEAD_DEC(k, n, e2, ad2)?
]

queries[
	confidentiality? m
]

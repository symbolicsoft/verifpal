//
// Expected: c0 at one session and at two.
//
// solver_onion_oracle.vp with gc guarded: kbob is the key Bob shares with
// Carol, so the attacker cannot wrap Alice's ciphertext for Bob and s stays
// secret.
attacker[active]

principal Bob[
	knows private kb
	generates b
	gb = PUBKEY(b)
]

Bob -> Carol: gb

principal Carol[
	knows private kb
	generates c, mc
	gc = PUBKEY(c)
	kc = DH_KEX(gb, c)
	x = ENC(kc, ENC(kb, mc))
]

Carol -> Bob: [gc], x

principal Alice[
	knows private kb
	generates s
	ca = ENC(kb, s)
]

Alice -> Dave: [ca]

principal Dave[
	knows private kb
	sd = DEC(kb, ca)
]

principal Bob[
	kbob = DH_KEX(gc, b)
	m1 = DEC(kbob, x)
	m2 = DEC(kb, m1)
]

Bob -> Carol: m2

queries[
	confidentiality? s
]

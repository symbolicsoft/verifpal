// Expected: a0 at one session and at two.
//
// auth_withheld_static_replay.vp with tag guarded. The attacker can still halt
// Alice by replacing c, but a guarded slot takes only the sender's value, so
// Bob then waits for a tag that never comes instead of accepting Alice#2's.
attacker[active]

principal Charlie[
	generates c
	h = HASH(c)
]

Charlie -> Alice: c, [h]

principal Alice[
	knows private k
	_ = ASSERT(HASH(c), h)?
	tag = MAC(k, nil)
]

Alice -> Bob: [tag]

principal Bob[
	knows private k
	_ = ASSERT(tag, MAC(k, nil))?
]

queries[
	authentication? Alice -> Bob: tag
]

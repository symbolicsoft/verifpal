//
// Expected: u1 at one and two sessions. The later key disclosure reveals
// the existing link between the ciphertexts under s. Replaying an opaque
// ciphertext before that disclosure does not supply its unknown key.

attacker[active]
principal Alice[
	knows private s
	knows public c1, c2
	generates m1, m2
	x = ENC(s, m1)
	y = ENC(s, m2)
	carrier = HASH(y, c2)
]
Alice -> Bob: x, y, [carrier]
principal Bob[
	a = HASH(x, c1)
	b = HASH(y, c2)
]
Bob -> Dave: a, b
principal Dave[
	_ = HASH(a, b)
]
phase[1]
principal Alice[
	leaks s
]
queries[
	unlinkability? a, b
]

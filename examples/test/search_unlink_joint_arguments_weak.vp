//
// Expected: u1 at one session and at two.
//
// search_unlink_joint_arguments.vp with Bob's ob weak: it reveals s1 on the
// wire, so Carol's oracle alone, hy replaced with PUBKEY(nil), gives s2 and
// the attacker rebuilds a and b. The weak route on ob had hidden the shaped
// key the deducer needs to open Carol's oc, so weakening ob lost the attack.
// search_unlink_joint_arguments_weak_guarded.vp is the counterweight.
attacker[active]
principal Alice[
	knows private s1, s2
	generates n1, n2, x, y
	a = HASH(s1, s2, n1)
	b = HASH(s1, s2, n2)
	hx = HASH(x)
	hy = HASH(y)
]
Alice -> Dave: n1, n2, a, b
Alice -> Bob: hx
Alice -> Carol: hy
principal Bob[
	knows private s1
	ob = PKE_ENC[weak](hx, s1)
]
principal Carol[
	knows private s2
	oc = PKE_ENC(hy, s2)
]
Bob -> Dave: ob
Carol -> Dave: oc
principal Dave[
	_ = HASH(n1, n2, a, b)
	_ = HASH(ob, oc)
]
queries[
	unlinkability? a, b
]

attacker[active]

principal Alice[
	knows private psk
	knows private a
	ga = PUBKEY(a)
]

principal Bob[
	knows private psk
	knows private b
	gb = PUBKEY(b)
]

Alice -> Bob: [ga]
Bob -> Alice: [gb]

principal Alice[
	dh_a = DH_KEX(gb, a)
	session_key_a = HKDF(HASH(psk, dh_a), nil, nil)
	generates m1, m2
	generates n_e1
	e1 = AEAD_ENC(session_key_a, n_e1, m1, nil)
	generates n_e2
	e2 = AEAD_ENC(session_key_a, n_e2, m2, nil)
]

Alice -> Bob: n_e1, e1, n_e2, e2

principal Bob[
	dh_b = DH_KEX(ga, b)
	session_key_b = HKDF(HASH(psk, dh_b), nil, nil)
	m1_b = AEAD_DEC(session_key_b, n_e1, e1, nil)?
	m2_b = AEAD_DEC(session_key_b, n_e2, e2, nil)?
]

phase[1]

principal Alice[leaks psk]
principal Bob[leaks psk]

queries[
	confidentiality? m1
	confidentiality? m2
	authentication? Alice -> Bob: e1
	authentication? Alice -> Bob: e2
]

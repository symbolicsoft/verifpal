attacker[active]

principal Alice[
	knows private k
	generates m, a
	ga = G^a
	kk = HASH(k)
	e = AEAD_ENC(kk, m, nil)
]

principal Bob[
	knows private k, b
	gb = G^b
]

Bob -> Alice: gb

Alice -> Bob: ga, e

principal Bob[
	kk_b = HASH(k)
	m_b = AEAD_DEC(kk_b, e, nil)?
	shared = ga^b
	tag = MAC(shared, m_b)
]

queries[
	authentication? Alice -> Bob: e
]

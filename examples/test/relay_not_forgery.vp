attacker[active]

principal Alice[
	knows private k
	generates m, a
	ga = PUBKEY(a)
	kk = HASH(k)
	generates n_e
	e = AEAD_ENC(kk, n_e, m, nil)
]

principal Bob[
	knows private k, b
	gb = PUBKEY(b)
]

Bob -> Alice: gb

Alice -> Bob: ga, n_e, e

principal Bob[
	kk_b = HASH(k)
	m_b = AEAD_DEC(kk_b, n_e, e, nil)?
	shared = DH_KEX(ga, b)
	tag = MAC(shared, m_b)
]

queries[
	authentication? Alice -> Bob: e
]

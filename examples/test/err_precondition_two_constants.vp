//
// Parse error: a precondition describes one message carrying one constant,
// and a second constant is rejected where the closing bracket was expected.

attacker[active]

principal Bob[
	knows private psk
	generates m
	e = ENC(psk, m)
]

Bob -> Alice: e

principal Alice[
	knows private psk
	m2 = DEC(psk, e)
]

Alice -> Carol: m2

principal Carol[
	_ = HASH(m2)
]

queries[
	authentication? Bob -> Alice: e[
		precondition[Alice -> Carol: m2, e]
	]
]

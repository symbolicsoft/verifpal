//
// Expected: u0 at one session and at two.
//
// search_unlink_joint_arguments.vp with hx guarded: Bob's oracle answers only
// Alice, so s1 stays secret and neither value can be rebuilt.
attacker[active]
principal Alice[
	knows private s1, s2
	generates n1, n2, x, y
	a = HASH(s1, s2, n1)
	b = HASH(s1, s2, n2)
	hx = HASH(x)
	hy = HASH(y)
]
Alice -> Dave: n1, n2, a, b
Alice -> Bob: [hx]
Alice -> Carol: hy
principal Bob[
	knows private s1
	ob = PKE_ENC(hx, s1)
]
principal Carol[
	knows private s2
	oc = PKE_ENC(hy, s2)
]
Bob -> Dave: ob
Carol -> Dave: oc
principal Dave[
	_ = HASH(n1, n2, a, b)
	_ = HASH(ob, oc)
]
queries[
	unlinkability? a, b
]

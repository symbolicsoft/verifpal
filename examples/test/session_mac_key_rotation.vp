// SPDX-License-Identifier: CC-BY-SA-4.0
// Expected: e0e0 at one session, e1e0 at two.
//
// Two messages from one long-term root, sent in one flight, differing only in
// whether the key that protects them is rotated per session. The static key is
// the same value in every run, so the sibling session's ciphertext opens under
// it; the rotated key mixes in a salt that reaches Bob guarded, so the
// sibling's ciphertext no longer reduces and his check halts him instead.
//
// This is key separation doing the job a session identifier would do, one
// layer lower. What makes it a session model rather than a key-derivation one
// is that at a single session the two flights are indistinguishable: both
// verdicts are e0, and only replication tells them apart. That is also the
// argument for the shipped default being two rather than one.

attacker[active]

principal Alice[
	knows private root
	generates session_salt
	generates m_static, m_rotated
	k_static = HASH(root)
	k_rotated = HASH(root, session_salt)
	e_static = AEAD_ENC(k_static, m_static, nil)
	e_rotated = AEAD_ENC(k_rotated, m_rotated, nil)
]

Alice -> Bob: e_static, e_rotated, [session_salt]

principal Bob[
	knows private root
	k_static_b = HASH(root)
	k_rotated_b = HASH(root, session_salt)
	d_static = AEAD_DEC(k_static_b, e_static, nil)?
	d_rotated = AEAD_DEC(k_rotated_b, e_rotated, nil)?
	_ = HASH(d_static, d_rotated)
]

queries[
	equivalence? m_static, d_static
	equivalence? m_rotated, d_rotated
]

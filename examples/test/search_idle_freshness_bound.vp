//
// Expected: f0 at one session and at two.
//
// The counterweight to search_idle_freshness.vp and its _guarded twin: Carol
// binds h to a nonce she generates. A replayed h#2, sent directly or rebuilt
// by Bob from a replayed u#2, carries nc#2, so Carol's check fails, and no
// two Carol runs accept one h.
attacker[active]

principal Alice[
	knows private k
	generates s
	t = MAC(k, s)
]

Alice -> Carol: s, t

principal Carol[
	knows private k
	_ = ASSERT(MAC(k, s), t)?
	generates nc
	u = MAC(k, t)
]

Carol -> Bob: u, nc

principal Bob[
	h = HASH(u, nc)
]

Bob -> Carol: h

principal Carol[
	_ = ASSERT(HASH(MAC(k, t), nc), h)?
]

queries[
	freshness? h
]

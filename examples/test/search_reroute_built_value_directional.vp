//
// Expected: a0 at one session and at two. Counterweight to
// search_reroute_built_value.vp: Alice's reply is bound to HASH(sid), so
// Bob's own box1 does not decrypt as her reply and Bob cannot be made to send
// box3 before Alice has accepted pkt.
attacker[active]

principal Bob[
	knows private k
	knows private mb1, mb3
	generates sid
]

Bob -> Alice: [sid]

principal Bob[
	generates n1
	box1 = AEAD_ENC(k, n1, mb1, sid)
	pkt = CONCAT(n1, box1)
]

Bob -> Alice: pkt

principal Alice[
	knows private k
	knows private ma
	an1, abox1 = SPLIT(pkt)?
	d1 = AEAD_DEC(k, an1, abox1, sid)?
	generates n2
	box2 = AEAD_ENC(k, n2, ma, HASH(sid))
]

Alice -> Bob: n2, box2

principal Bob[
	d2 = AEAD_DEC(k, n2, box2, HASH(sid))?
	generates n3
	box3 = AEAD_ENC(k, n3, mb3, sid)
]

Bob -> Alice: n3, box3

principal Alice[
	d3 = AEAD_DEC(k, n3, box3, sid)?
	hp = HASH(pkt)
]

queries[
	authentication? Bob -> Alice: pkt
]

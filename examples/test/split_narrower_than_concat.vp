//
// Expected: e0e0e1c0 — core_rule_split ignores excess arity, so a recipient may
// project fewer fields than the sender packed. What it must take is the
// PREFIX: x is the first field and y the second, not the last two and not some
// rotation. The third query is the one that fails, and it fails because y is
// the second field rather than the fourth.
//
// The confidentiality query is the other half of "ignores excess arity": the
// fields Bob never projected are still inside the ciphertext and still out of
// the attacker's reach. A SPLIT that leaked its unprojected tail into attacker
// knowledge would take p3 down while every equivalence query kept passing.

attacker[passive]

principal Alice[
	knows private p1, p2, p3, p4
	knows private packing_key
	bundle = CONCAT(p1, p2, p3, p4)
	sealed = ENC(packing_key, bundle)
]

Alice -> Bob: sealed

principal Bob[
	knows private packing_key
	x, y = SPLIT(DEC(packing_key, sealed))
	_ = HASH(x, y)
]

queries[
	equivalence? x, p1
	equivalence? y, p2
	equivalence? y, p4
	confidentiality? p3
]

// Expected: u0 at one session and at two (GitHub issue #37).
//
// Alice computes right only after Bob's ack. The attacker can learn s only by
// replacing e with the leaked sealed = ENC(ka, s): Bob decrypts it, leaks
// d = s, and his checked ASSERT(d, nil)? halts him before ack, so Alice never
// computes right in that execution. The guarded fresh n keeps every other
// session's Bob from opening this session's sealed. The leaked second has the
// value right would have, but a disclosed carrier does not make the assignment
// execute. The judge once took right from the honest execution and linked it
// to left via s: u1. Unlinkability now links only values the judged execution
// holds. unlink_unexecuted_assignment_unchecked.vp is the counterweight.
attacker[active]

principal Alice[
	knows private k
	knows public p, q
	generates s, n
	ka = HASH(k, n)
	e = ENC(ka, nil)
	sealed = ENC(ka, s)
	left = HASH(s, p)
	second = HASH(s, q)
	leaks left, second, sealed
]

Alice -> Bob: [n], e

principal Bob[
	knows private k
	kb = HASH(k, n)
	d = DEC(kb, e)
	leaks d
	_ = ASSERT(d, nil)?
	generates ack
]

Bob -> Alice: [ack]

principal Alice[
	right = HASH(s, q)
]

queries[
	unlinkability? left, right
]

attacker[active]

principal Alice[
	generates b
]

Alice -> Bob: b

principal Bob[
	knows private a
	generates c
	generates d
	leaks c
	h1, h2, h3 = HKDF(a, b, nil)
	h4, h5, h6 = HKDF(c, c, nil)
	p1 = PUBKEY(d)
	p2 = PUBKEY(d)
]

Bob -> Alice: h1, h2, h3, h4, h5, h6, p1, p2

principal Alice[
	_ = HASH(h1)
	_ = HASH(h4)
	_ = HASH(p1)
]

queries[
	unlinkability? h1, h2, h3
	unlinkability? h4, h5, h6
	unlinkability? p1, p2
]

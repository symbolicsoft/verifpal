attacker[active]

principal Bob[
	knows private k
	generates m
	generates n_c
	c = AEAD_ENC(k, n_c, m, nil)
]

Bob -> Alice: n_c, c

principal Alice[
	knows private k
	generates s
	m_a = AEAD_DEC(k, n_c, c, nil)?
	gs = PUBKEY(s)
	tag = MAC(m_a, gs)
]

Alice -> Bob: gs, tag

phase[1]

principal Bob[leaks k]

queries[
	confidentiality? m
	authentication? Bob -> Alice: c
]

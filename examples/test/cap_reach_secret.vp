// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: a1 — Bob accepts m2 as coming from Alice, verified against sig_2,
// which the attacker forged.
//
// The reach a `forgeable` assumption has is one level wider than the reach the
// capability index alone describes, and this model is the case that separates
// them. sig_1 and sig_2 are *different* terms, so the equivalence-class index
// says nothing about sig_2. But `forgeable` is a statement about the scheme
// under a key, not about a term: it says the attacker can produce SIGN(sk, ·)
// over a message of its choosing, and a forgery is by definition over a message
// the honest run never signed. The exemption is therefore keyed on the secret,
// and sig_2 is forgeable even though nothing about sig_2 is annotated.
//
// A reviewer reading this model sees an unannotated SIGN and concludes that m2
// is authenticated. Verifpal says otherwise at load time.
attacker[active]

principal Alice[
	knows private sk
	pk = PUBKEY(sk)
	generates m1, m2
	sig_1 = SIGN[forgeable](sk, m1)
	sig_2 = SIGN(sk, m2)
]

Alice -> Bob: [pk], m1, m2, sig_1, sig_2

principal Bob[
	_ = SIGNVERIF(pk, m2, sig_2)?
]

queries[
	authentication? Alice -> Bob: m2
]

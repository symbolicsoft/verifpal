//
// Expected: c0
//
// The decompose counterpart of kem_secret_is_not_a_ciphertext.vp. KEM_ENCAP's
// decompose rule hands the private key's holder the shared secret and the
// encapsulation randomness, because ML-KEM's re-encryption check re-derives the
// coins -- but it runs on the CIPHERTEXT. A shared secret is a hash output, and
// the private key recovers nothing from it. Applying the rule at either
// projection let an attacker holding a leaked shared secret and a leaked
// decapsulation key "open" the secret and walk out with the randomness, which
// is a preimage no KEM lets anyone compute.
//
// Here the ciphertext never travels and is never leaked, so the only route to
// kem_decap_reveals_randomness.vp's genuine reveal is closed and the query must
// hold.

attacker[passive]

principal Bob[
	knows private ksr_dk
	ksr_ek = PUBKEY(ksr_dk)
	leaks ksr_dk
]

Bob -> Alice: [ksr_ek]

principal Alice[
	knows public ksr_ctx
	generates ksr_r
	ksr_ss, ksr_ct = KEM_ENCAP(ksr_ek, ksr_r)
	generates n_ksr_e
	ksr_e = AEAD_ENC(ksr_ss, n_ksr_e, ksr_ctx, ksr_ctx)
	leaks ksr_ss
]

Alice -> Bob: n_ksr_e, ksr_e

queries[
	confidentiality? ksr_r
]

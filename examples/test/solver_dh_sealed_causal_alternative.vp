// Expected: c0 at both session counts. A matching oracle response does not
// disclose its contents when the attacker cannot open the carrier.
attacker[active]

principal Alice[
	knows public b
	generates x
]

Alice -> Bob: x

principal Bob[
	knows public b
	generates a
	leaks a
]

principal Alice[
	generates y
]

Alice -> Bob: y

principal Bob[
	knows private k, wrapping
	tag = ENC(wrapping, MAC(k, DH_KEX(PUBKEY(x), y)))
	secret = MAC(k, DH_KEX(PUBKEY(a), b))
]

Bob -> Carol: tag

principal Carol[]

queries[
	confidentiality? secret
]

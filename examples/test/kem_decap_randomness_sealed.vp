// Expected: c0c0
//
// The counterweight to kem_decap_reveals_randomness.vp, identical but for
// the leak. The encapsulation randomness is revealed to whoever holds the
// decapsulation key, and to nobody else: dkb stays secret here, so the
// attacker holds ct without being able to decapsulate it, and both the
// shared secret and the randomness hold.
//
// Without this model the randomness reveal could be a blanket disclosure
// and the corpus would not notice.

attacker[passive]

principal Bob[
	knows private dkb
	ekb = PUBKEY(dkb)

]

Bob -> Alice: [ekb]

principal Alice[
	knows public ctx
	generates r
	ss, ct = KEM_ENCAP(ekb, r)
	generates n_e
	e = AEAD_ENC(ss, n_e, ctx, ctx)
]

Alice -> Bob: ct, n_e, e

queries[
	confidentiality? ss
	confidentiality? r
]

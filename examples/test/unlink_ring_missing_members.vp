// Expected: u0 at both session counts. A known message cannot be recognized
// inside either ring signature without all three ring members' public keys.
// Repeating pa in every verifier position does not supply the missing keys.
attacker[passive]

principal Alice[
	knows private a, b, c, m
	pa = PUBKEY(a)
	pb = PUBKEY(b)
	pc = PUBKEY(c)
	s1 = RINGSIGN(a, pb, pc, m)
	s2 = RINGSIGN(b, pa, pc, m)
	leaks m
]

Alice -> Bob: pa, s1, s2

principal Bob[]

queries[
	unlinkability? s1, s2
]

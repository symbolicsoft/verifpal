// The same protocol with an ephemeral encapsulation key, authenticated by a
// long-term signing key. Compromising the signing key afterwards does not
// recover the message, because the decapsulation key was never long-term.

attacker[active]

principal Bob[
	knows private sigb
	generates dkb
	gb = PUBKEY(sigb)
	ekb = PUBKEY(dkb)
	ekbsig = SIGN(sigb, ekb)
]

Bob -> Alice: [gb], ekb, ekbsig

principal Alice[
	knows private m
	generates r
	_ = SIGNVERIF(gb, ekb, ekbsig)?
	ss, ct = KEM_ENCAP(ekb, r)
	generates n_e
	e = AEAD_ENC(ss, n_e, m, nil)
]

Alice -> Bob: ct, n_e, e

principal Bob[
	ssb = KEM_DECAP(dkb, ct)
	d = AEAD_DEC(ssb, n_e, e, nil)?
]

phase[1]

principal Bob[leaks sigb]

queries[
	confidentiality? m
]

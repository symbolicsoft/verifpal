//
// Expected: c1 at one session and at two.
//
// Counterweight to threshold_secret_reveals_no_share.vp: with k leaked and s1
// on the wire, the attacker holds two points of the two-of-three sharing's
// line, so it interpolates s2.
attacker[passive]
principal Dealer[
	generates k
	s1, s2, s3 = THRESHOLD_SPLIT[2](k)
	leaks k
]
Dealer -> Bob: s1
principal Bob[
	_ = HASH(s1)
]
queries[
	confidentiality? s2
]

// Expected: c1 at one session and at two. Bob seals the answer of a keyed DH
// oracle under an inner nonce only he and Carol hold, and Carol seals a public
// label under the same inner key and nonce. The attacker replaces x and y so
// that Bob's DH_KEX(PUBKEY(x), y) is DH_KEX(PUBKEY(a), b), which commutes, and
// Bob seals the secret itself; the label gives it the keystream, and the pair
// the secret.
attacker[active]

principal Alice[
	knows public b, wrapping, inner_wrapping
	generates x
]

Alice -> Bob: x

principal Bob[
	knows public b, wrapping, inner_wrapping
	generates a
	leaks a
]

principal Alice[
	generates y
]

Alice -> Bob: y

principal Bob[
	knows private k, inner_nonce
	tag = ENC(wrapping, AEAD_ENC(inner_wrapping, inner_nonce, MAC(k, DH_KEX(PUBKEY(x), y)), nil))
	secret = MAC(k, DH_KEX(PUBKEY(a), b))
]

Bob -> Carol: tag

principal Carol[
	knows public label, inner_wrapping
	knows private inner_nonce
	probe = AEAD_ENC(inner_wrapping, inner_nonce, label, nil)
]

Carol -> Dave: probe

principal Dave[]

queries[
	confidentiality? secret
]

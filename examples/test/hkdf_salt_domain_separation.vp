//
// Expected: c0a0 at one session and c0a1 at two.
// A fixed, distinct info term separates the exposed token from the wrapping
// key even when their untrusted salts coincide. The salt-substitution
// forgery is refused; an honest sibling's ciphertext remains replayable.
// The client's upload is guarded and the query is restricted to executions
// in which the server forwards the item, so what is asked is the device's
// check, not whether the attacker can bypass a server that only relays:
// it can, by making the server forward nil and handing the device the
// upload it observed. hkdf_salt_substitution.vp is the counterweight.
attacker[active]

principal Server[]

principal Client[
	knows private password, item
	generates token_salt, wrapping_salt, item_nonce
	token = HKDF(password, token_salt, nil)
	wrapping_key = HKDF(password, wrapping_salt, HASH(nil))
	sealed = AEAD_ENC(wrapping_key, item_nonce, item, nil)
]

Client -> Server: [token], [token_salt], [wrapping_salt], [item_nonce], [sealed]
Server -> Device: token_salt, wrapping_salt, item_nonce, sealed

principal Device[
	knows private password
	key = HKDF(password, wrapping_salt, HASH(nil))
	opened = AEAD_DEC(key, item_nonce, sealed, nil)?
]

queries[
	confidentiality? item
	authentication? Server -> Device: sealed[
		precondition[Server -> Device: sealed]
	]
]

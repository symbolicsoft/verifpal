//
// Expected: u1u0 — password reuse across two sites is linkable exactly when
// the stored record is guessable. Both pairs reuse one password across two
// public site labels; the difference is PW_HASH, and it decides not only
// whether the password falls but whether the two accounts can be tied
// together.
//
// The chain runs through machinery that had never been asked to cooperate:
// find_obtainable_passwords recovers pw_fast, and only then does origin_leaves
// find that both records reconstruct from a secret the attacker now holds. A
// password barrier is therefore an unlinkability property as well as a
// confidentiality one, which is not obvious and is worth a model.

attacker[passive]

principal Alice[
	knows password pw_fast
	knows password pw_slow
	knows public site_one, site_two
	rec_fast_one = HASH(pw_fast, site_one)
	rec_fast_two = HASH(pw_fast, site_two)
	rec_slow_one = PW_HASH(pw_slow, site_one)
	rec_slow_two = PW_HASH(pw_slow, site_two)
]

Alice -> Bob: rec_fast_one, rec_fast_two, rec_slow_one, rec_slow_two

principal Bob[
	_ = HASH(rec_fast_one, rec_fast_two, rec_slow_one, rec_slow_two)
]

queries[
	unlinkability? rec_fast_one, rec_fast_two
	unlinkability? rec_slow_one, rec_slow_two
]

//
// Expected: a1a0 at one session, a1a1 at two. The leaked key permits a
// concrete ciphertext forgery in the first flight. The independent secret
// key protects the second from forgery but not from replay: declared nonces
// keep honest ciphertexts identical across sessions, so at two sessions one
// copy of Alice never starts, the attacker replays the other's e_held to
// both of Bob's runs, and Bob accepts twice a ciphertext Alice sent once.
// The executor once ran every copy of every principal to completion, so
// each Bob run had an Alice emission to match. At one session the one Bob
// accepts the one flight.

attacker[active]

principal Alice[
	knows private k_lost, k_held
	knows private m_lost, m_held
	knows private n_e_lost
	e_lost = AEAD_ENC(k_lost, n_e_lost, m_lost, nil)
	knows private n_e_held
	e_held = AEAD_ENC(k_held, n_e_held, m_held, nil)
	leaks k_lost
]

Alice -> Bob: n_e_lost, e_lost, n_e_held, e_held

principal Bob[
	knows private k_lost, k_held
	d_lost = AEAD_DEC(k_lost, n_e_lost, e_lost, nil)?
	d_held = AEAD_DEC(k_held, n_e_held, e_held, nil)?
	_ = HASH(d_lost, d_held)
]

queries[
	authentication? Alice -> Bob: e_lost
	authentication? Alice -> Bob: e_held
]

//
// Expected: a1a0. The leaked key permits a concrete ciphertext forgery in the
// first flight. The independent secret key protects the second. Declared
// nonces keep honest ciphertexts identical across sessions.

attacker[active]

principal Alice[
	knows private k_lost, k_held
	knows private m_lost, m_held
	knows private n_e_lost
	e_lost = AEAD_ENC(k_lost, n_e_lost, m_lost, nil)
	knows private n_e_held
	e_held = AEAD_ENC(k_held, n_e_held, m_held, nil)
	leaks k_lost
]

Alice -> Bob: n_e_lost, e_lost, n_e_held, e_held

principal Bob[
	knows private k_lost, k_held
	d_lost = AEAD_DEC(k_lost, n_e_lost, e_lost, nil)?
	d_held = AEAD_DEC(k_held, n_e_held, e_held, nil)?
	_ = HASH(d_lost, d_held)
]

queries[
	authentication? Alice -> Bob: e_lost
	authentication? Alice -> Bob: e_held
]

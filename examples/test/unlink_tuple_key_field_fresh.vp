//
// Expected: u0 at one session and at two.
//
// unlink_tuple_key_field.vp with a fresh plaintext. The attacker reads k
// from a and opens b with it, but obtains only the fresh m, which it has
// nothing to compare against: any key would yield some unknown value, as in
// unlink_opened_fresh_content.vp. b is tied to m and not to k, a is tied to
// x and k, and the two have no term in common.
attacker[passive]

principal Alice[
	generates k, x, m
	a = CONCAT(x, k)
	b = ENC(k, m)
]

Alice -> Bob: a, b

principal Bob[
	_ = HASH(a, b)
]

queries[
	unlinkability? a, b
]

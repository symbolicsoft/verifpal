//
// Expected: c1c1
//
// A passive attacker learns m at phase 0 from the leaked key. The
// precondition names a message Bob only sends in phase 1. A precondition
// restricts the query to executions that reach that send, and this one does,
// so the gated query fails as the ungated one does. A precondition in a later
// phase never loses a verdict; precondition_later_phase_scenario.vp is the
// case where the phase-0 claim is the only one that applies.

attacker[passive]

principal Alice[
	knows private k
	generates m
	e = ENC(k, m)
	leaks k
]

Alice -> Bob: e

principal Bob[
	knows private k
	d = DEC(k, e)
]

phase[1]

principal Bob[
	ack = HASH(d)
]

Bob -> Alice: ack

principal Alice[
	_ = HASH(ack)
]

queries[
	confidentiality? m
	confidentiality? m[
		precondition[Bob -> Alice: ack]
	]
]

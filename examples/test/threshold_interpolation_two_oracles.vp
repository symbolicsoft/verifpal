// Expected: c1 at one session and at two.
//
// Alice splits secret two-of-two and leaks it wrapped for Bob and its first
// share wrapped for Carol. Bob and Carol each decrypt what they receive and
// leak it. The attacker hands Bob wrapped_secret and Carol wrapped_first in
// one execution, learns secret and first, and interpolates second: the
// secret and one share are two points of the sharing's line. Interpolation
// once recorded only the secret as its input, so the query-source merge
// followed Bob's oracle alone and never brought in Carol's, and second held
// at every session count. threshold_interpolation_two_oracles_guarded.vp
// guards Carol's input: the secret alone fixes no share, and second holds.
attacker[active]

principal Alice[
	knows private kb, kc, secret
	generates junkb, junkc
	first, second = THRESHOLD_SPLIT[2](secret)
	wrapped_secret = ENC(kb, secret)
	wrapped_first = ENC(kc, first)
	xb = ENC(kb, junkb)
	xc = ENC(kc, junkc)
	leaks wrapped_secret, wrapped_first
]

Alice -> Bob: xb

Alice -> Carol: xc

principal Bob[
	knows private kb
	yb = DEC(kb, xb)
	leaks yb
]

principal Carol[
	knows private kc
	yc = DEC(kc, xc)
	leaks yc
]

queries[
	confidentiality? second
]

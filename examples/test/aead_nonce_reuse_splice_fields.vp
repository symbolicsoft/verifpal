// Expected: c0a0 at one session, c0a1 at two.
//
// aead_nonce_reuse_rewrite_known_field.vp with the challenge bound under a
// shared secret, so the attacker knows neither binding field and reads no
// keystream at all. It does not need to: under one key and nonce, field i of
// every ciphertext lies over the same keystream, so the attacker splices the
// message field of e#2 onto the binding field of e, re-tags the result with
// the tag key the pair gives up, and Bob's first run accepts m#2, which Alice
// sealed for his second. m and m#2 stay secret.
// aead_nonce_reuse_splice_fields_bound.vp binds the fields together and
// holds.
attacker[active]

principal Bob[
	generates chal
]

Bob -> Alice: [chal]

principal Alice[
	knows private k, n, s
	generates m
	b = HASH(s, chal)
	p = CONCAT(b, m)
	e = AEAD_ENC(k, n, p, nil)
]

Alice -> Bob: e

principal Bob[
	knows private k, n, s
	d = AEAD_DEC(k, n, e, nil)?
	c, mm = SPLIT(d)?
	_ = ASSERT(c, HASH(s, chal))?
	h = HASH(mm)
]

queries[
	confidentiality? m
	authentication? Alice -> Bob: e
]

attacker[active]

principal Alice[
	knows password pw
	knows public m
	generates y
	gy = PUBKEY(y)
	k = DH_KEX(gy, pw)
	e = ENC(k, m)
]

Alice -> Bob: e

principal Bob[
	knows public m
	d = DEC(m, e)
]

queries[
	confidentiality? pw
]

// Expected: c0 at one session, c1 at two. Reusing the inner key and nonce
// across sessions discloses the oracle's response without ordinary decryption.
attacker[active]

principal Alice[
	knows public b, wrapping, inner_nonce
	generates x
]

Alice -> Bob: x

principal Bob[
	knows public b, wrapping, inner_nonce
	generates a
	leaks a
]

principal Alice[
	generates y
]

Alice -> Bob: y

principal Bob[
	knows private k, inner_wrapping
	tag = ENC(wrapping, AEAD_ENC(inner_wrapping, inner_nonce, MAC(k, DH_KEX(PUBKEY(x), y)), nil))
	secret = MAC(k, DH_KEX(PUBKEY(a), b))
]

Bob -> Carol: tag

principal Carol[]

queries[
	confidentiality? secret
]

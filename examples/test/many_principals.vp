//
// Expected: c1a0a0a0a0a0f0 at one session, c1a1a1a1a1a1f1 at two.
//
// Server signs HASH(payload, nonce) and sends payload, nonce and the
// signature in the clear to five principals, with its public key guarded.
// payload is on the wire, so its confidentiality fails at both counts. At
// one session each recipient's signature check admits only Server's
// flight, which Server sent to it once. At two sessions nothing binds a
// flight to a recipient run: the attacker replays Server#2's flight into
// each recipient's first run, so each accepts payload#2 in both of its
// runs while Server sent it to each once, and Alice and Alice#2 both accept
// nonce#2, so it is not fresh. Freshness once asked only whether the value
// contained a generated constant.

attacker[active]

principal Server[
	knows private sk
	gsk = PUBKEY(sk)
	generates payload, nonce
	sig = SIGN(sk, HASH(payload, nonce))
]

principal Alice[]
principal Bob[]
principal Carol[]
principal Damian[]
principal Eve[]

Server -> Alice: [gsk], payload, nonce, sig
Server -> Bob: [gsk], payload, nonce, sig
Server -> Carol: [gsk], payload, nonce, sig
Server -> Damian: [gsk], payload, nonce, sig
Server -> Eve: [gsk], payload, nonce, sig

principal Alice[
	_ = SIGNVERIF(gsk, HASH(payload, nonce), sig)?
]

principal Bob[
	_ = SIGNVERIF(gsk, HASH(payload, nonce), sig)?
]

principal Carol[
	_ = SIGNVERIF(gsk, HASH(payload, nonce), sig)?
]

principal Damian[
	_ = SIGNVERIF(gsk, HASH(payload, nonce), sig)?
]

principal Eve[
	_ = SIGNVERIF(gsk, HASH(payload, nonce), sig)?
]

queries[
	confidentiality? payload
	authentication? Server -> Alice: payload
	authentication? Server -> Bob: payload
	authentication? Server -> Carol: payload
	authentication? Server -> Damian: payload
	authentication? Server -> Eve: payload
	freshness? nonce
]

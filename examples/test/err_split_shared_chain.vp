//
// Expected: error — pair packs x20 twice and the SPLIT binds three
// constants, so the third projection has no field to take in the honest run.
//
// err_honest_check_shared_chain.vp for the other diagnostic of a failed
// honest check. Its note once printed the resolved CONCAT, both copies of the
// whole chain, 58 MB here (issue #71); it now names the argument as the
// model writes it, pair.
attacker[passive]

principal Alice[
	knows private secret
	x0 = HASH(secret, secret)
	x1 = HASH(x0, x0)
	x2 = HASH(x1, x1)
	x3 = HASH(x2, x2)
	x4 = HASH(x3, x3)
	x5 = HASH(x4, x4)
	x6 = HASH(x5, x5)
	x7 = HASH(x6, x6)
	x8 = HASH(x7, x7)
	x9 = HASH(x8, x8)
	x10 = HASH(x9, x9)
	x11 = HASH(x10, x10)
	x12 = HASH(x11, x11)
	x13 = HASH(x12, x12)
	x14 = HASH(x13, x13)
	x15 = HASH(x14, x14)
	x16 = HASH(x15, x15)
	x17 = HASH(x16, x16)
	x18 = HASH(x17, x17)
	x19 = HASH(x18, x18)
	x20 = HASH(x19, x19)
	pair = CONCAT(x20, x20)
	first, second, third = SPLIT(pair)?
]

queries[
	confidentiality? secret
]

//
// Expected: c0 at one session, c1 at two.
//
// solver_type_flaw_nested_pair.vp with the server's nonce and ticket sent as
// one pair that Bob splits. Syverson's type flaw is unchanged: the attacker
// opens Bob#2 with Na := CONCAT(nil, nb#2), and Bob#2's request
// {A, <nil, Nb#2>}Kbs under n2 has the shape of a ticket, so it hands Bob#2
// CONCAT(n2, t2) as the server's pair. Bob#2 accepts nil as the session key
// and encrypts secret_b#2 under it. At one session no second Bob run exists
// to serve as the oracle.
//
// Bob#2's ticket check needs the nonce and the ciphertext of one received pair
// to unify with the request Bob#2 emits, which unification did not see
// through Bob's projections of that pair. Unification now opens a projected
// variable into a tuple of fresh fields.
// solver_type_flaw_nested_pair_tuple_guarded.vp is the counterweight.
attacker[active]

principal Alice[
	generates na
]

Alice -> Bob: na

principal Bob[
	knows private k_bs
	knows public a_name
	generates nb, n2
	t2 = AEAD_ENC(k_bs, n2, CONCAT(a_name, na), nil)
]

Bob -> Server: nb, n2, t2

principal Server[
	knows private k_bs
	knows public a_name
	_ = AEAD_DEC(k_bs, n2, t2, nil)?
	generates kab, n3
	t3 = AEAD_ENC(k_bs, n3, CONCAT(a_name, CONCAT(kab, nb)), nil)
	ticket = CONCAT(n3, t3)
]

Server -> Bob: ticket

principal Bob[
	n3_b, t3_b = SPLIT(ticket)
	d = AEAD_DEC(k_bs, n3_b, t3_b, nil)?
	a_b, rest = SPLIT(d)?
	kab_b, nb_b = SPLIT(rest)?
	_ = ASSERT(nb_b, nb)?
	generates secret_b, n_e
	e = AEAD_ENC(kab_b, n_e, secret_b, nil)
]

Bob -> Alice: n_e, e

queries[
	confidentiality? secret_b
]

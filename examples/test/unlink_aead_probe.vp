attacker[passive]

principal Alice[
	knows private k
	knows public ad
	generates m1
	generates m2
	e1 = AEAD_ENC(k, m1, ad)
	e2 = AEAD_ENC(k, m2, ad)
	leaks k
]

Alice -> Bob: e1, e2

principal Bob[
	knows private k
	knows public ad
	d1 = AEAD_DEC(k, e1, ad)?
	d2 = AEAD_DEC(k, e2, ad)?
]

queries[
	unlinkability? e1, e2
]

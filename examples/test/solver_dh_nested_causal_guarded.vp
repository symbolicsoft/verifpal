// Expected: c0 at both session counts. Opening every carrier is insufficient
// when the oracle's guarded inputs cannot be changed.
attacker[active]

principal Alice[
	knows public b, wrapping, inner_wrapping, inner_nonce
	generates x
]

Alice -> Bob: [x]

principal Bob[
	knows public b, wrapping, inner_wrapping, inner_nonce
	generates a
	leaks a
]

principal Alice[
	generates y
]

Alice -> Bob: [y]

principal Bob[
	knows private k
	tag = ENC(wrapping, AEAD_ENC(inner_wrapping, inner_nonce, MAC(k, DH_KEX(PUBKEY(x), y)), nil))
	secret = MAC(k, DH_KEX(PUBKEY(a), b))
]

Bob -> Carol: tag

principal Carol[]

queries[
	confidentiality? secret
]

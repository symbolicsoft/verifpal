//
// Sanity error: malleability of an authenticated cipher is an authenticity
// break, which is already spelled `forgeable`.
attacker[active]

principal Alice[
	knows private k
	knows private m
	knows public ad
	generates n_e
	e = AEAD_ENC[malleable](k, n_e, m, ad)
]

Alice -> Bob: n_e, e

principal Bob[
	knows private k
	knows public ad
	d = AEAD_DEC(k, n_e, e, ad)
	_ = HASH(d)
]

queries[
	confidentiality? m
]

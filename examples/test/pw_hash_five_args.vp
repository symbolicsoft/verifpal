//
// Expected: c0c1 — password_hashing lists all five PW_HASH positions, and the
// only position anybody had ever tested was the first. Here the password is
// the FIFTH argument, with four public siblings ahead of it, which is exactly
// the shape a context-string-then-password call takes and exactly where an
// implementation that checked position 0 and moved on would fall through.
//
// The HASH twin beside it fixes the reading: with the same five arguments in
// the same order and the same public siblings, the password IS recoverable.
// The difference between the two lines is the entire claim.

attacker[passive]

principal Alice[
	knows password pw_slow
	knows password pw_fast
	knows public ctx_one, ctx_two, ctx_three, ctx_four
	stored_slow = PW_HASH(ctx_one, ctx_two, ctx_three, ctx_four, pw_slow)
	stored_fast = HASH(ctx_one, ctx_two, ctx_three, ctx_four, pw_fast)
]

Alice -> Bob: stored_slow, stored_fast

principal Bob[
	_ = HASH(stored_slow, stored_fast)
]

queries[
	confidentiality? pw_slow
	confidentiality? pw_fast
]

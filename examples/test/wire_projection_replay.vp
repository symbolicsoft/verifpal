attacker[active]

principal Alice[
	generates n1, n2
	data_alice = CONCAT(n1, n2)
]

Alice -> Bob: [data_alice]

principal Bob[
	n1_b, n2_b = SPLIT(data_alice)
]

Bob -> Alice: n2_b

principal Alice[
	_ = ASSERT(n2, n2_b)?
]

queries[
	authentication? Bob -> Alice: n2_b
]

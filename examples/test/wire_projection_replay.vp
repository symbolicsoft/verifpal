// Companion to concat_split_replay.vp: here the SPLIT projection itself
// travels on the wire, so the honest value of n2_b resolves to a top-level
// SPLIT(CONCAT(n1, n2)) projection. The attacker can only replay n2, which
// Alice's checked ASSERT binds to her own nonce, so the query must pass.

attacker[active]

principal Alice[
	generates n1, n2
	data_alice = CONCAT(n1, n2)
]

Alice -> Bob: [data_alice]

principal Bob[
	n1_b, n2_b = SPLIT(data_alice)
]

Bob -> Alice: n2_b

principal Alice[
	_ = ASSERT(n2, n2_b)?
]

queries[
	authentication? Bob -> Alice: n2_b
]

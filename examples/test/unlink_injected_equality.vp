attacker[active]

principal Alice[
	generates b
]

Alice -> Bob: b

principal Bob[
	knows private a
	h1, h2, h3 = HKDF(a, b, nil)
]

Bob -> Alice: h1, h2, h3

principal Alice[
	_ = HASH(h1)
	_ = HASH(h2)
]

queries[
	unlinkability? h1, h2
]

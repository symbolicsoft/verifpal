// Expected: f1 at one session and at two.
//
// scenario_all_corrupt_order.vp with its two scenarios exchanged.
attacker[passive]
principal Carol[
	generates c
	gc = PUBKEY(c)
	leaks c
]
principal Bob[
	knows private b
	gb = PUBKEY(b)
	leaks b
]
Carol -> Alice: [gc]
Bob -> Alice: [gb]
principal Alice[
	knows public gpeer
	x = HASH(gpeer)
	z = HASH(x)
]
scenarios[
	Alice[gpeer = gb]
	Alice[gpeer = gc]
]
queries[
	freshness? x
]

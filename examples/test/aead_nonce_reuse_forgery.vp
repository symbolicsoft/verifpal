//
// Expected: a1 at --sessions 1 and at 2. Alice seals three fresh messages
// under one key and one nonce, the third under its own associated data, so
// neither of the first two passes Bob's check of the third as it stands. The
// first two give the attacker the authentication key for that key and nonce,
// though no plaintext, so it re-tags e1 under ad2, and Bob's checked
// decryption of the third accepts m1: an origin failure with no key ever
// leaked. Without a known plaintext it cannot choose what Bob decrypts
// (aead_nonce_reuse_chosen_plaintext.vp). At two sessions the replay of the
// other run's e3 is the same a1 by another route; one session pins the
// re-tagging. aead_nonce_distinct_forgery_holds.vp, with three nonces, holds.

attacker[active]

principal Alice[
	knows private k
	knows private n
	knows public ad1, ad2
	generates m1, m2, m3
	e1 = AEAD_ENC(k, n, m1, ad1)
	e2 = AEAD_ENC(k, n, m2, ad1)
	e3 = AEAD_ENC(k, n, m3, ad2)
]

Alice -> Bob: e1, e2, e3

principal Bob[
	knows private k
	knows private n
	knows public ad2
	d3 = AEAD_DEC(k, n, e3, ad2)?
	h = HASH(d3)
]

queries[
	authentication? Alice -> Bob: e3
]

//
// Expected: c1c1c0c0 — two weakening assumptions with different onsets,
// stacked so that the later one is only REACHABLE because the earlier one
// fired. The payload is sealed under an inner key and the whole inner
// ciphertext sealed again under an outer one; the outer seal is declared
// invertible from phase 1 and the inner from phase 2.
//
// The attacker cannot break what it does not hold. In phase 0 it holds only
// the outer ciphertext and neither assumption is in force. In phase 1 the
// outer one opens and the inner ciphertext becomes something the attacker
// HOLDS for the first time. Only in phase 2 does holding it matter. A
// capability system that evaluated onsets against the phase a term was created
// in, rather than against the phase the attacker is currently running, would
// open both at once in phase 1 or never open the inner one at all.
//
// Neither key is ever surrendered, which is the counterweight: `weak` on an
// AEAD reveals its plaintext and not its key, even twice over.

attacker[passive]

principal Alice[
	knows private inner_key, outer_key
	knows private payload
	generates n_inner
	inner = AEAD_ENC[weak from phase 2](inner_key, n_inner, payload, nil)
	generates n_outer
	outer = AEAD_ENC[weak from phase 1](outer_key, n_outer, inner, nil)
]

Alice -> Bob: n_inner, n_outer, outer

principal Bob[
	knows private inner_key, outer_key
	seen_inner = AEAD_DEC(outer_key, n_outer, outer, nil)?
	seen_payload = AEAD_DEC(inner_key, n_inner, seen_inner, nil)?
	_ = HASH(seen_payload)
]

phase[1]

phase[2]

queries[
	confidentiality? payload
	confidentiality? inner
	confidentiality? outer_key
	confidentiality? inner_key
]

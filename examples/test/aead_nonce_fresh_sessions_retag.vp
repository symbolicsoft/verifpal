// Expected: a0 at one session and at two.
//
// aead_nonce_reuse_sessions_retag.vp with Alice generating her nonce and
// sending it. Each session's ciphertext has a nonce of its own, so no two
// share key and nonce, no tag key is given up, and Bob's challenge rules out
// the replay of the other run's ciphertext.
attacker[active]

principal Bob[
	generates t
]

Bob -> Alice: [t]

principal Alice[
	knows private k
	generates n, m
	e = AEAD_ENC(k, n, m, t)
]

Alice -> Bob: n, e

principal Bob[
	knows private k
	d = AEAD_DEC(k, n, e, t)?
	h = HASH(d)
]

queries[
	authentication? Alice -> Bob: e
]

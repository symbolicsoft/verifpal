// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: a1a1 — a blind signer signs a term it cannot read, and its blind
// signature is itself a valid signature over the blinded value. Both flights
// send the blinded value and the blind signature across the wire (a guard
// prevents replacement, not observation), so the attacker hands the verifier
// (BLIND(r, note), SIGN(sk, BLIND(r, note))) as (note, sig). SIGNVERIF passes
// with a note Alice never sent.
//
// The open flight fails for a second reason as well: its blinded value is
// unguarded, so the signer is a signing oracle, and the oracle's output
// survives UNBLIND. The attacker feeds the signer a blinding of its own and
// gets back a signature that a verifier who never saw any blinding accepts
// over a bare message of the attacker's choosing. blind_message_substituted.vp
// stops at the signer, where the substitution is visible as a plain
// authentication failure. The sealed flight, whose blinded value is guarded
// and whose signer key is its own, closes that oracle but not the direct
// replay of the blind signature.

attacker[active]

principal SignerOpen[
	knows private sk_open
	gsk_open = PUBKEY(sk_open)
]

principal SignerSealed[
	knows private sk_sealed
	gsk_sealed = PUBKEY(sk_sealed)
]

SignerOpen -> Alice: [gsk_open]
SignerSealed -> Alice: [gsk_sealed]
SignerOpen -> Verifier: [gsk_open]
SignerSealed -> Verifier: [gsk_sealed]

principal Alice[
	knows private note_open
	knows private note_sealed
	generates r_open
	generates r_sealed
	blinded_open = BLIND(r_open, note_open)
	blinded_sealed = BLIND(r_sealed, note_sealed)
]

Alice -> SignerOpen: blinded_open
Alice -> SignerSealed: [blinded_sealed]

principal SignerOpen[
	bs_open = SIGN(sk_open, blinded_open)
]

principal SignerSealed[
	bs_sealed = SIGN(sk_sealed, blinded_sealed)
]

SignerOpen -> Alice: bs_open
SignerSealed -> Alice: bs_sealed

principal Alice[
	sig_open = UNBLIND(r_open, note_open, bs_open)
	sig_sealed = UNBLIND(r_sealed, note_sealed, bs_sealed)
]

Alice -> Verifier: note_open, sig_open, note_sealed, sig_sealed

principal Verifier[
	_ = SIGNVERIF(gsk_open, note_open, sig_open)?
	_ = SIGNVERIF(gsk_sealed, note_sealed, sig_sealed)?
]

queries[
	authentication? Alice -> Verifier: note_open
	authentication? Alice -> Verifier: note_sealed
]

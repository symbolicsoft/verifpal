//
// Expected: a1 at one session and at two (GitHub issue #50).
//
// search_supplier_same_input.vp, with Phone also sending note = HASH(nResp)
// beside resp. The attack is the same, with note replayed from Phone@2,
// since the halted Phone never sends it to Bank.
//
// The merge that carries the attack leaves Bank's receive of resp waiting on
// note, which nobody sent, while its resp install is derivable. That receive
// counted as stuck, so the merge was dropped. A receive is stuck only when
// one of its installs cannot be delivered; one waiting on withheld slots
// alone is starved, and its withheld slots are filled.
//
// search_starved_not_stuck_guarded.vp guards chalMsg and holds.

attacker[active]

principal Passport[
	knows private aaKey
	dg15 = PUBKEY(aaKey)
]

Passport -> Bank: [dg15]

principal Evil[
	knows private evilKey
	evilPub = PUBKEY(evilKey)
	leaks evilKey
]

principal Bank[
	knows private bankKey
	bankPub = PUBKEY(bankKey)
]

Bank -> Phone: [bankPub]
Evil -> Phone: [evilPub]

principal Phone[
	knows private nfcKey
	knows public rpPub, nChal, nResp
	generates ck
	ckMsg = PKE_ENC(rpPub, ck)
]

Phone -> Bank: ckMsg

principal Bank[
	knows public nChal, nResp
	ck_b = PKE_DEC(bankKey, ckMsg)
	generates chal
	chalMsg = AEAD_ENC(ck_b, nChal, chal, nil)
]

Bank -> Phone: chalMsg

principal Phone[
	chal_p = AEAD_DEC(ck, nChal, chalMsg, nil)?
	nfcRequest = ENC(nfcKey, chal_p)
]

Phone -> Passport: [nfcRequest]

principal Passport[
	knows private nfcKey
	challenge_p = DEC(nfcKey, nfcRequest)
	aaSig = SIGN(aaKey, challenge_p)
	nfcAnswer = ENC[weak](nfcKey, aaSig)
]

Passport -> Phone: [nfcAnswer]

principal Phone[
	aaSig_phone = DEC(nfcKey, nfcAnswer)
	resp = AEAD_ENC(ck, nResp, aaSig_phone, nil)
	note = HASH(nResp)
]

Phone -> Bank: note, resp

principal Bank[
	_ = SIGNVERIF(dg15, chal, AEAD_DEC(ck_b, nResp, resp, nil))?
]

scenarios[
	Phone[rpPub = bankPub]
	Phone[rpPub = evilPub]
]

queries[
	authentication? Phone -> Bank: resp
]

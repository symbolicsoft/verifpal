attacker[active]

principal Bob[
	knows private skb
	pkb = PUBKEY(skb)
	generates n1
]

Bob -> Alice: [pkb], n1

principal Alice[
	knows private m
	generates n2
	msg     = PKE_ENC(pkb, CONCAT(n1, n2, m))
	msg_rot = PKE_ENC(pkb, CONCAT(n2, m, n1))
]

Alice -> Bob: msg, msg_rot

principal Bob[
	clear = PKE_DEC(skb, msg)
	x, y1, y2 = SPLIT(clear)?
	_ = ASSERT(x, n1)?
]

Bob -> Alice: y1

queries[
	confidentiality? m
]

// Expected: c0 at one and two sessions. Guarding x prevents swapping the
// decrypted exponent with y, so the equality check keeps y at HASH(b).

attacker[active]

principal Alice[
	knows private k
	knows public a, b
	x = ENC(k, HASH(a))
	alt = ENC(k, HASH(b))
	y = HASH(b)
]

Alice -> Carol: [alt]

principal Carol[
]

Alice -> Bob: [x], y

principal Bob[
	knows private k, sk
	knows public a, b
	_ = ASSERT(DH_KEX(PUBKEY(DEC(k, x)), y), DH_KEX(PUBKEY(HASH(a)), HASH(b)))?
	tag = MAC(sk, y)
	secret = MAC(sk, HASH(a))
]

Bob -> Carol: tag

queries[
	confidentiality? secret
]

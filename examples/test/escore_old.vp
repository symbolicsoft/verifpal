//
// Expected: c1c1 — each client's public key reaches the server unguarded, so
// the attacker substitutes its own and the server seals that client's score
// under a key it shares with the attacker rather than the client.

attacker[active]

principal Alice[
    knows private Alice_pass
    knows public Alice_id
    Alice_priv = HASH(Alice_pass)
    Alice_pub = PUBKEY(Alice_priv)
]

principal Bob[
    knows private Bob_pass
    knows public Bob_id
    Bob_priv = HASH(Bob_pass)
    Bob_pub = PUBKEY(Bob_priv)
]

principal Server[
    knows private server_secret
    server_priv = HKDF(nil, HASH(server_secret, Alice_id), nil)
    server_pub = PUBKEY(server_priv)
]

Alice -> Server: Alice_pub

principal Server[
    knows private escoreA
    ss_serverA = DH_KEX(Alice_pub, server_priv)
    sym_key_serverA = HKDF(Alice_id, ss_serverA, nil)
    generates n_encrypted_escoreA
    encrypted_escoreA = AEAD_ENC(sym_key_serverA, n_encrypted_escoreA, escoreA, nil)
]

Server -> Alice: [n_encrypted_escoreA], [encrypted_escoreA], server_pub

principal Alice[
    ss_Alice = DH_KEX(server_pub, Alice_priv)
    sym_key_Alice = HKDF(Alice_id, ss_Alice, nil)
    decrypted_escoreA = AEAD_DEC(sym_key_Alice, n_encrypted_escoreA, encrypted_escoreA, nil)?
]

Bob -> Server: Bob_pub

principal Server[
    knows private escoreB
    ss_serverB = DH_KEX(Bob_pub, server_priv)
    sym_key_serverB = HKDF(Bob_id, ss_serverB, nil)
    generates n_encrypted_escoreB
    encrypted_escoreB = AEAD_ENC(sym_key_serverB, n_encrypted_escoreB, escoreB, nil)
]

Server -> Bob: [n_encrypted_escoreB], [encrypted_escoreB], server_pub

principal Bob[
    ss_Bob = DH_KEX(server_pub, Bob_priv)
    sym_key_Bob = HKDF(Bob_id, ss_Bob, nil)
    decrypted_escoreB = AEAD_DEC(sym_key_Bob, n_encrypted_escoreB, encrypted_escoreB, nil)?
]

queries[
    confidentiality? escoreA
    confidentiality? escoreB
]

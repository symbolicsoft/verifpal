//
// Expected: e1 at one and two sessions.
//
// split_delivery_equivalence.vp with Alice checking Carol's signature over
// the share before deriving her key. Only an addressed delivery to Bob
// leaves Alice's check passing while Bob's key diverges.

attacker[active]

principal Carol[
	knows private csk
	cpk = PUBKEY(csk)
	generates c
	gc = PUBKEY(c)
	sig = SIGN(csk, gc)
]

principal Alice[
	knows private a
]

principal Bob[
	knows private b
]

Carol -> Alice: [cpk], gc, sig
Carol -> Bob: gc

principal Alice[
	_ = SIGNVERIF(cpk, gc, sig)?
	generates y
	ka = HASH(gc, y)
]

Alice -> Bob: [y]

principal Bob[
	kb = HASH(gc, y)
]

queries[
	equivalence? ka, kb
]

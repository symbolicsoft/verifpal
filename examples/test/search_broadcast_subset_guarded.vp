//
// Expected: c0 at one session and at two.
//
// Counterweight to search_broadcast_subset.vp: Carol's copy of the share is
// guarded, so the subset the attacker needs does not exist. Replacing the share
// at Bob alone leaves his hash disagreeing with Carol's and halts him, and the
// probe that drops halted recipients has nothing left to drop.

attacker[active]

principal Alice[
	generates a
	ga = PUBKEY(a)
	hga = HASH(ga)
]

Alice -> Bob: ga
Alice -> Carol: [ga]
Alice -> Dave: ga, [hga]

principal Bob[
	generates b, sb
	gb = PUBKEY(b)
	hb = HASH(ga)
]

principal Carol[
	hc = HASH(ga)
]

principal Dave[
	_ = ASSERT(HASH(ga), hga)?
	generates ackd
]

Bob -> Carol: [hb]
Carol -> Bob: [hc]
Dave -> Bob: [ackd]

principal Bob[
	_ = ASSERT(hb, hc)?
	kb = DH_KEX(ga, b)
	generates n
	e = AEAD_ENC(kb, n, sb, ackd)
]

Bob -> Alice: gb, n, e

queries[
	confidentiality? sb
]

//
// Parse error: `knows` takes `private` or `public`, and any other qualifier is
// rejected at the declaration with the accepted ones named. Verifpal once had a
// third qualifier, `password`, marking a guessable value; a model written for
// it must be refused here rather than silently read as `private`.
attacker[passive]

principal Alice[
	knows password pw
	h = HASH(pw)
]

Alice -> Bob: h

principal Bob[
	_ = HASH(h)
]

queries[
	confidentiality? pw
]

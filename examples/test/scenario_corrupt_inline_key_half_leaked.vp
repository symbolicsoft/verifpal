// Expected: c1 at one session and at two.
//
// Mallory's private key is HASH(m, seed), written inline, and only m leaks,
// so the attacker cannot compute it and a run with Mallory as peer is
// honest. gm reaches Alice unguarded: the attacker replaces it with
// PUBKEY(nil), Alice seals s to that key, and the attacker opens e with nil.
//
// Corruption once read a bound value's constant leaves one at a time, and m
// is key material as a private constant, so its leak marked the run with
// Mallory corrupt and this attack was dropped with its claims. Naming the
// key as sk = HASH(m, seed) already left the run honest. A computed term at
// a key position is now compromised only when the attacker can compute all
// of it. scenario_corrupt_inline_key_both_leaked.vp is the counterweight,
// and scenario_corrupt_needs_every_ingredient.vp is the named form.
attacker[active]
principal Bob[
	knows private b
	gb = PUBKEY(b)
]
principal Mallory[
	knows private m
	generates seed
	gm = PUBKEY(HASH(m, seed))
	leaks m
]
Bob -> Alice: [gb]
Mallory -> Alice: gm
principal Alice[
	knows public gpeer
	generates s
	e = PKE_ENC(gpeer, s)
]
Alice -> Bob: e
principal Bob[
	sb = PKE_DEC(b, e)
]
scenarios[
	Alice[gpeer = gb]
	Alice[gpeer = gm]
]
queries[
	confidentiality? s
]

// A bare KEM protects the message but authenticates nobody: the attacker can
// encapsulate to Bob's public key itself and send its own ciphertext, so the
// authentication query is legitimately contradicted while confidentiality holds.

attacker[active]

principal Bob[
	knows private dkb
	ekb = PUBKEY(dkb)
]

Bob -> Alice: [ekb]

principal Alice[
	knows private m
	generates r
	ss, ct = KEM_ENCAP(ekb, r)
	generates n_e
	e = AEAD_ENC(ss, n_e, m, nil)
]

Alice -> Bob: ct, n_e, e

principal Bob[
	ssb = KEM_DECAP(dkb, ct)
	d = AEAD_DEC(ssb, n_e, e, nil)?
]

queries[
	confidentiality? m
	authentication? Alice -> Bob: e
]

attacker[active]

principal Bob[
	knows private b
	gb = PUBKEY(b)
]

Bob -> Alice: gb

principal Alice[
	knows private a
	knows private aa
	ga = PUBKEY(a)
	gaa = PUBKEY(aa)
	generates n_egaa
	egaa = AEAD_ENC(DH_KEX(gb, a), n_egaa, gaa, nil)
]

Alice -> Bob: ga, n_egaa, egaa

principal Bob[
	b_gaa = AEAD_DEC(DH_KEX(ga, b), n_egaa, egaa, nil)?
	knows private m
	generates n_em
	em = AEAD_ENC(DH_KEX(b_gaa, b), n_em, m, nil)
]

Bob -> Alice: n_em, em

principal Alice[
	x = AEAD_DEC(DH_KEX(gb, aa), n_em, em, nil)?
	knows private m2
	generates n_em2
	em2 = AEAD_ENC(DH_KEX(gb, aa), n_em2, m2, nil)
]

Alice -> Bob: n_em2, em2

principal Bob[
	_ = AEAD_DEC(DH_KEX(b_gaa, b), n_em2, em2, nil)?
]

queries[
	confidentiality? gaa
	confidentiality? m
	confidentiality? m2
	authentication? Alice -> Bob: egaa
	authentication? Bob -> Alice: em
	authentication? Alice -> Bob: em2
]

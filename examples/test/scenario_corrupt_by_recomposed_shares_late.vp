//
// Expected: c1 at one session and at two.
//
// scenario_corrupt_by_recomposed_shares.vp with the two shares leaked in
// phase 1. The gpeer = gm scenario is honest in phase 0 and corrupt from
// phase 1, so at phase 1 it answers for its phase-0 m against a knowledge
// that recomposes mk: no forward secrecy.
attacker[active]
principal Bob[
	knows private b
	gb = PUBKEY(b)
]
principal Mallory[
	knows private mk
	gm = PUBKEY(mk)
	s1, s2, s3 = THRESHOLD_SPLIT[2](mk)
]
Bob -> Alice: [gb]
Mallory -> Alice: [gm]
principal Alice[
	knows public gpeer
	generates m
	e = PKE_ENC(gpeer, m)
]
Alice -> Bob: e
principal Bob[
	_ = PKE_DEC(b, e)
]
phase[1]
principal Mallory[
	leaks s1, s3
]
scenarios[
	Alice[gpeer = gb]
	Alice[gpeer = gm]
]
queries[
	confidentiality? m
]

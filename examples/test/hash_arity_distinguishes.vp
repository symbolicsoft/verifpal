//
// Expected: e1e1c0 — HASH is not commutative and a multi-argument hash is not
// a hash of a concatenation. Both are load-bearing invariants nothing in the
// tree stated. hashing.rs deliberately hashes DH exponents commutatively so
// that DH_KEX(PUBKEY(a), b) and DH_KEX(PUBKEY(b), a) agree; if that
// commutativity ever escaped its DH guard and reached argument lists in
// general, the first query would collapse to e0 and every transcript hash in
// every model would stop binding order.
//
// The second query is the neighbouring mistake: HASH(x, y) and HASH(CONCAT(x,
// y)) are different terms, and an engine that normalised argument lists into
// concatenations would silently identify a two-field transcript with a
// one-field one.

attacker[passive]

principal Alice[
	knows private x, y
	knows private wrap_key
	forward = HASH(x, y)
	backward = HASH(y, x)
	joined = HASH(CONCAT(x, y))
	sealed = ENC(wrap_key, CONCAT(forward, backward, joined))
]

Alice -> Bob: sealed

principal Bob[
	knows private wrap_key
	_ = SPLIT(DEC(wrap_key, sealed))
]

queries[
	equivalence? forward, backward
	equivalence? forward, joined
	confidentiality? x
]

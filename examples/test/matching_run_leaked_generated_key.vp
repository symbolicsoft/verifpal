// Expected: a1 at one session and at two.
//
// matching_run_forged_unguarded.vp with the MAC key generated by Alice and
// leaked, rather than known privately and leaked by Mallory. The attacker holds
// the key, so it forges MAC(k, nil), hands it to Bob beside nil for Carol's
// nonce, and Bob accepts a tag Alice never sent. The matching-run exemption
// asks whether the attacker could have produced the value with every read off
// the sender's runs taken away. A generated value is not something a run is
// driven into emitting: what it holds does not depend on anything the attacker
// installs, so a leak of it is the attacker's own capability and stays in that
// view, as a known constant does. Taking it away excused the forgery.

attacker[active]

principal Alice[
	generates mlg_k
	leaks mlg_k
]

principal Carol[
	generates mlg_n
]

Alice -> Bob: [mlg_k]
Carol -> Alice: mlg_n
Carol -> Bob: mlg_n

principal Alice[
	mlg_t = MAC(mlg_k, mlg_n)
]

Alice -> Bob: mlg_t

principal Bob[
	_ = ASSERT(mlg_t, MAC(mlg_k, mlg_n))?
]

queries[
	authentication? Alice -> Bob: mlg_t
]

// Expected: c1c0 at one session and at two.
//
// Alice signs once with a public nonce. The attacker recovers her share from
// that honest partial, the nonce and the public signing context, without any
// nonce reuse. The forgeable assumption must not hide this disclosure. One
// share still does not reveal the group key.
//
// This originally tested fabricated reuse pairs, but its public nonce already
// suffices for recovery. threshold_sign_nonce_reuse.vp covers two honest
// partials sharing a secret nonce; cap_forgeable_is_not_a_reuse_pair.vp covers
// the distinction between fabricated and honest reuse pairs.

attacker[active]

principal Dealer[
	knows private psk_a
	generates k
	s1, s2, s3 = THRESHOLD_SPLIT[2](k)
	ea = ENC(psk_a, s1)
]

Dealer -> Alice: [ea]

principal Carol[
	generates cl_seed
]

Carol -> Alice: cl_seed

principal Alice[
	knows private psk_a
	knows public na_pub, msg
	sa = DEC(psk_a, ea)
	pa = THRESHOLD_SIGN[forgeable](sa, na_pub, cl_seed, msg)
]

Alice -> Bob: pa

principal Bob[
	_ = HASH(pa)
]

queries[
	confidentiality? s1
	confidentiality? k
]

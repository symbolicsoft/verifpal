//
// Expected: c0c1 — offline guessing needs every sibling of the password, and
// "every sibling" is a property of the whole run rather than of the moment the
// hash was published. Both passwords are hashed with a fresh nonce in phase 0;
// one nonce is disclosed in phase 1, and the verifier that was safe becomes
// guessable retroactively against a transcript the attacker recorded earlier.
//
// The pair is the point. pw_early's nonce is never disclosed and stays a
// blocking sibling forever, so a phase-blind implementation of
// find_obtainable_passwords — one that asked whether a sibling is knowable at
// all rather than whether it is known — would take both down together.

attacker[passive]

principal Alice[
	knows password pw_early
	knows password pw_late
	generates nonce_kept
	generates nonce_shown
	guard_early = HASH(pw_early, nonce_kept)
	guard_late = HASH(pw_late, nonce_shown)
]

Alice -> Bob: guard_early, guard_late

principal Bob[
	_ = HASH(guard_early, guard_late)
]

phase[1]

principal Alice[
	leaks nonce_shown
]

queries[
	confidentiality? pw_early
	confidentiality? pw_late
]

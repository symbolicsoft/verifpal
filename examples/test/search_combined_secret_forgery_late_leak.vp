//
// Expected: a1 at one and two sessions. As search_combined_secret_forgery.vp,
// but Dave leaks s after his check. That leak comes too late to forge what
// Dave checks, so it must not stand in for the two oracles: the attacker
// still hands Bob w3 and Carol w4, learns s before Dave receives m, and
// sends Dave nil with MAC(s, nil), which no run of Alice emitted. At two
// sessions the attacker can also replay Alice's second m and t to the first
// Dave run.
attacker[active]

principal Alice[
	knows private kb, kc, s
	generates k1, k2, jb, jc
	w1 = ENC(kb, k1)
	w2 = ENC(kb, ENC(k1, s))
	w3 = ENC(kb, k2)
	w4 = ENC(kc, ENC(k2, s))
	xb = ENC(kb, jb)
	xc = ENC(kc, jc)
	leaks w1, w2, w3, w4
]
Alice -> Bob: xb
Alice -> Carol: xc

principal Bob[
	knows private kb
	y = DEC(kb, xb)
	leaks y
]

principal Carol[
	knows private kc
	z = DEC(kc, xc)
	leaks z
]

principal Alice[
	generates m
	t = MAC(s, m)
]
Alice -> Dave: m, t

principal Dave[
	knows private s
	_ = ASSERT(MAC(s, m), t)?
	leaks s
]

queries[
	authentication? Alice -> Dave: m
]

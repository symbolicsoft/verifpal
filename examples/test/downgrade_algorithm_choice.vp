// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: c1a1c0a0 at one session, c1a1c0a1 at two — a negotiated cipher
// suite with nothing binding the
// negotiation. The client offers two suites, the attacker deletes the strong
// one, and the server picks what is left. The traffic under the weak suite is
// readable because the weak suite is declared invertible; the traffic that
// would have been under the strong one never happens.
//
// The second exchange runs the identical negotiation with the offer bound into
// a transcript MAC, and the same deletion fails the server's check. Downgrade
// protection is not about the algorithms at all — it is about whether the
// choice is authenticated afterwards — and this is the model that separates
// those two things.
//
// The transcript MAC answers the deletion, not replay. Both offers are built
// from public constants alone, so every session's `offer_bound` and its tag are
// the same two values, and the server contributes nothing before checking them.
// At two sessions the attacker leaves the client unstarted and replays the other
// copy's flight, so the server accepts one offer twice against a single client
// emission: a duplicate acceptance, reported as such, not a forgery.

attacker[active]

principal Client[
	knows private psk
	knows public suite_weak, suite_strong
	knows private m_open, m_bound
	offer_open = CONCAT(suite_weak, suite_strong)
	offer_bound = CONCAT(suite_weak, suite_strong)
	offer_tag = MAC(psk, offer_bound)
	generates n_weak_open
	weak_open = AEAD_ENC[weak](psk, n_weak_open, m_open, suite_weak)
	generates n_weak_bound
	weak_bound = AEAD_ENC(psk, n_weak_bound, m_bound, suite_weak)
]

Client -> Server: offer_open, n_weak_open, weak_open, offer_bound, offer_tag, n_weak_bound, weak_bound

principal Server[
	knows private psk
	knows public suite_weak, suite_strong
	chosen_open, _ = SPLIT(offer_open)?
	_ = ASSERT(MAC(psk, offer_bound), offer_tag)?
	chosen_bound, _ = SPLIT(offer_bound)?
	got_open = AEAD_DEC(psk, n_weak_open, weak_open, chosen_open)?
	got_bound = AEAD_DEC(psk, n_weak_bound, weak_bound, chosen_bound)?
	_ = HASH(got_open, got_bound)
]

queries[
	confidentiality? m_open
	authentication? Client -> Server: offer_open
	confidentiality? m_bound
	authentication? Client -> Server: offer_bound
]

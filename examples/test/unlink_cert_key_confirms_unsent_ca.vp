//
// Expected: u1u0u0 at one session and at two.
//
// unlink_cert_key_confirms_pairs.vp with the CA key never sent: nothing
// checks cert, so it is tied to neither pk nor sig, while sig still verifies
// under pk.
attacker[passive]
principal Ca[
	knows private ca
	gca = PUBKEY(ca)
]
principal Alice[
	knows private sk
	knows public m1
	pk = PUBKEY(sk)
]
Alice -> Ca: pk
principal Ca[
	cert = SIGN(ca, pk)
]
Ca -> Alice: cert
principal Alice[
	sig = SIGN(sk, m1)
]
Alice -> Bob: cert, sig
principal Bob[
	_ = HASH(cert, sig)
]
queries[
	unlinkability? sig, pk
	unlinkability? cert, pk
	unlinkability? sig, cert
]

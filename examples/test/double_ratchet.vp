// Expected: c0c0a0a0e0e0
//
// Every Diffie-Hellman input is guarded and no identity key leaks, so the
// attacker cannot derive a ratchet key and cannot build a ciphertext either
// side would accept. The messages stay confidential and authentic.
//
// Both equivalence queries hold for the same reason. Their right-hand sides,
// msg1_b and msg2_a, are checked AEAD_DEC applications: the only thing the
// attacker can do to e1 or e2 is corrupt them, which fails that check and
// halts the recipient. A halted recipient obtained no plaintext, and an abort
// is not a disagreement. These read e1e1 until `query_equivalence` learned to
// refuse a value whose own check failed -- see equivalence_halt_at_slot.vp.

attacker[active]

principal Alice[
	knows private a_id
	ga_id = PUBKEY(a_id)
	generates a_eph0
	ga_eph0 = PUBKEY(a_eph0)
]

principal Bob[
	knows private b_id
	gb_id = PUBKEY(b_id)
	generates b_eph0
	gb_eph0 = PUBKEY(b_eph0)
]

Alice -> Bob: [ga_id], [ga_eph0]
Bob -> Alice: [gb_id], [gb_eph0]

principal Alice[
	dh_root = HASH(DH_KEX(gb_id, a_id), DH_KEX(gb_eph0, a_eph0))
	rk1, ck_a1 = HKDF(dh_root, nil, nil)
	mk_a1, _ = HKDF(ck_a1, nil, nil)
	generates msg1
	generates n_e1
	e1 = AEAD_ENC(mk_a1, n_e1, msg1, ga_eph0)
]

Alice -> Bob: n_e1, e1

principal Bob[
	dh_root_b = HASH(DH_KEX(ga_id, b_id), DH_KEX(ga_eph0, b_eph0))
	rk1_b, ck_b1 = HKDF(dh_root_b, nil, nil)
	mk_b1, _ = HKDF(ck_b1, nil, nil)
	msg1_b = AEAD_DEC(mk_b1, n_e1, e1, ga_eph0)?
	generates b_eph1
	gb_eph1 = PUBKEY(b_eph1)
	rk2_b, ck_b2 = HKDF(rk1_b, HASH(DH_KEX(ga_eph0, b_eph1)), nil)
	mk_b2, _ = HKDF(ck_b2, nil, nil)
	generates msg2
	generates n_e2
	e2 = AEAD_ENC(mk_b2, n_e2, msg2, gb_eph1)
]

Bob -> Alice: [gb_eph1], n_e2, e2

principal Alice[
	rk2, ck_a2 = HKDF(rk1, HASH(DH_KEX(gb_eph1, a_eph0)), nil)
	mk_a2, _ = HKDF(ck_a2, nil, nil)
	msg2_a = AEAD_DEC(mk_a2, n_e2, e2, gb_eph1)?
]

queries[
	confidentiality? msg1
	confidentiality? msg2
	authentication? Alice -> Bob: e1
	authentication? Bob -> Alice: e2
	equivalence? msg1, msg1_b
	equivalence? msg2, msg2_a
]

// Expected: c1e1 at one session and at two.
//
// split_checked_partial_output.vp with a three-field first message. Swapping
// it into the second slot now passes Bob's checked split, so Bob holds the
// label Alice leaks as a: confidentiality fails, and a differs from p.
attacker[active]

principal Alice[
	knows private k, label
	generates p, q, r, n1, n2
	e1 = AEAD_ENC(k, n1, CONCAT(label, q, r), nil)
	e2 = AEAD_ENC(k, n2, CONCAT(p, q, r), nil)
	leaks label
]

Alice -> Bob: n1, e1, n2, e2

principal Bob[
	knows private k
	d1 = AEAD_DEC(k, n1, e1, nil)?
	f1, f2 = SPLIT(d1)?
	d2 = AEAD_DEC(k, n2, e2, nil)?
	a, b, c = SPLIT(d2)?
]

queries[
	confidentiality? a
	equivalence? a, p
]

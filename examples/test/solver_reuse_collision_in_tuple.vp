//
// Expected: c1 at one session and at two.
//
// Carol takes her nonce out of a tuple, so the attacker chooses it: handing her
// the nonce Alice already used under the same key makes the two ciphertexts a
// reuse pair, and both plaintexts follow.
//
// A slot whose honest value is a constant is offered every held constant, which
// is how the same collision is found when the nonce is sent on its own. Inside
// a tuple the slot is the whole tuple, and its free field was only ever filled
// with nil, the honest value, or the attacker's key. Held constants are now
// offered there too, but only at the positions a reuse rule pins and only from
// constants the protocol puts at those positions: offering every held constant
// everywhere is what makes this a blow-up rather than a search.
//
// solver_reuse_collision_guarded.vp guards the tuple and holds.
attacker[active]

principal Alice[
	knows private k, m1
	knows public n
	e1 = AEAD_ENC(k, n, m1, nil)
	leaks e1
]

principal Dave[
	knows public tg
	generates cn
	hello = CONCAT(tg, cn)
]

Dave -> Carol: hello

principal Carol[
	knows private k
	knows public tg
	_, cn_c = SPLIT(hello)?
	generates m2
	e2 = AEAD_ENC(k, cn_c, m2, nil)
	leaks e2
]

queries[
	confidentiality? m1
]

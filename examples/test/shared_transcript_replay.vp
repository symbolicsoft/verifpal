// Expected: c0 at both session counts. Replaying a shared hash transcript
// reveals no preimage and must not expand its repeated branches during search.
attacker[active]

principal Alice[
	knows private seed
	h0 = HASH(seed)
	h1 = HASH(h0, h0, h0)
	h2 = HASH(h1, h1, h1)
	h3 = HASH(h2, h2, h2)
	h4 = HASH(h3, h3, h3)
	h5 = HASH(h4, h4, h4)
	h6 = HASH(h5, h5, h5)
	h7 = HASH(h6, h6, h6)
	h8 = HASH(h7, h7, h7)
	h9 = HASH(h8, h8, h8)
	h10 = HASH(h9, h9, h9)
	h11 = HASH(h10, h10, h10)
	h12 = HASH(h11, h11, h11)
	h13 = HASH(h12, h12, h12)
	h14 = HASH(h13, h13, h13)
]

Alice -> Bob: h14

principal Bob[
	result = HASH(h14)
]

queries[
	confidentiality? seed
]

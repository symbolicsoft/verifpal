//
// Expected: c1c1c1c1 — every message additionally encrypted to a master key
// "for lawful access", and the master key is exactly as recoverable as any
// other key in the system. Three correspondents, three properly protected
// conversations, and one escrow copy each.
//
// The escrow copies do not weaken the per-conversation cryptography and do not
// need to. They stand beside it, so the system is as strong as the weakest of
// two paths to the same plaintext, and the second path terminates in a single
// value. What the model asserts is that the engine takes the cheap route: it
// never touches the conversation keys at all, and the trace should show three
// decryptions under one key rather than three broken handshakes.

attacker[passive]

principal Authority[
	knows private master_key
	leaks master_key
]

principal Alice[
	knows private master_key
	knows private key_ab, key_ac
	knows private m_to_bob, m_to_carol
	generates n_to_bob
	to_bob = AEAD_ENC(key_ab, n_to_bob, m_to_bob, nil)
	generates n_to_carol
	to_carol = AEAD_ENC(key_ac, n_to_carol, m_to_carol, nil)
	generates n_escrow_bob
	escrow_bob = AEAD_ENC(master_key, n_escrow_bob, m_to_bob, nil)
	generates n_escrow_carol
	escrow_carol = AEAD_ENC(master_key, n_escrow_carol, m_to_carol, nil)
]

Alice -> Bob: n_to_bob, to_bob, n_escrow_bob, escrow_bob
Alice -> Carol: n_to_carol, to_carol, n_escrow_carol, escrow_carol

principal Bob[
	knows private key_ab
	got_bob = AEAD_DEC(key_ab, n_to_bob, to_bob, nil)?
	_ = HASH(got_bob)
]

principal Carol[
	knows private key_ac
	got_carol = AEAD_DEC(key_ac, n_to_carol, to_carol, nil)?
	_ = HASH(got_carol)
]

queries[
	confidentiality? master_key
	confidentiality? m_to_bob
	confidentiality? m_to_carol
	confidentiality? got_bob
]

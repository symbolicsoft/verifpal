//
// Expected: a0 at one session, a1 at two.
//
// auth_withheld_static_replay.vp with Alice's ASSERT unchecked. Replacing c no
// longer halts Alice, but the attacker has no need to halt her: tag =
// MAC(k, nil) is the same in every session, so it leaves Alice unstarted and
// replays Alice#2's tag to Bob. Bob and Bob#2 both pass their checks on
// MAC(k, nil), which Alice sent once. When every session had to start, each
// Bob's receipt was matched by his own Alice's emission and this model held.
// At one session no other Alice sends the tag: a0.
attacker[active]

principal Charlie[
	generates c
	h = HASH(c)
]

Charlie -> Alice: c, [h]

principal Alice[
	knows private k
	_ = ASSERT(HASH(c), h)
	tag = MAC(k, nil)
]

Alice -> Bob: tag

principal Bob[
	knows private k
	_ = ASSERT(tag, MAC(k, nil))?
]

queries[
	authentication? Alice -> Bob: tag
]

attacker[passive]

principal Alice[
	knows private k
	generates n1
	generates n2
	tok1 = MAC(k, n1)
	tok2 = MAC(k, n2)
]

Alice -> Bob: tok1, tok2

principal Bob[
	knows private k
	_ = HASH(tok1)
	_ = HASH(tok2)
]

queries[
	unlinkability? tok1, tok2
]

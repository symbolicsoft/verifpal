//
// Expected: error — x20 is a chain of 21 hashes, each of its predecessor
// twice, so the term has 22 nodes and 2^21 occurrences of secret, and
// ASSERT(x20, nil)? fails in the honest run, which is a model error.
//
// The diagnostic once printed the failed operation fully resolved, every
// occurrence of every shared argument written out: a megabyte and a half at
// depth 16, doubling with each level (issue #71). It now spells the operation
// as the model writes it, each named argument one level out, here
// ASSERT(HASH(x19, x19), nil)?, so its size follows the source.
// honest_check_shared_chain.vp is the model whose check succeeds.
attacker[passive]

principal Alice[
	knows private secret
	x0 = HASH(secret, secret)
	x1 = HASH(x0, x0)
	x2 = HASH(x1, x1)
	x3 = HASH(x2, x2)
	x4 = HASH(x3, x3)
	x5 = HASH(x4, x4)
	x6 = HASH(x5, x5)
	x7 = HASH(x6, x6)
	x8 = HASH(x7, x7)
	x9 = HASH(x8, x8)
	x10 = HASH(x9, x9)
	x11 = HASH(x10, x10)
	x12 = HASH(x11, x11)
	x13 = HASH(x12, x12)
	x14 = HASH(x13, x13)
	x15 = HASH(x14, x14)
	x16 = HASH(x15, x15)
	x17 = HASH(x16, x16)
	x18 = HASH(x17, x17)
	x19 = HASH(x18, x18)
	x20 = HASH(x19, x19)
	_ = ASSERT(x20, nil)?
]

queries[
	confidentiality? secret
]

// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: c1 at one session and at two.
//
// The attack needs two installs in Bob's one run, and the value for the
// second is produced by the server from Bob's emission under the first. The
// attacker hands Bob PUBKEY(nil) as c, so x = DH_KEX(PUBKEY(nil), b) is its
// own to compute; the server echoes {nb, x}Kbs to Alice, which has the shape
// of Bob's ticket {nb, kab}Kbs, and the attacker delivers that echo to Bob as
// his ticket. Bob's session key is then x and secret_b leaks. When the search
// retried the stuck ticket with the execution that produced the echo, it
// merged in none of that execution's installs at Bob, whose run the proposal
// already touched, so the echo it needed was never emitted.
// search_chain_through_server_labelled.vp is the counterweight.
attacker[active]

principal Bob[
	knows private b, k_bs
	gb = PUBKEY(b)
]

Bob -> Alice: [gb]

principal Alice[
	generates a
	c = PUBKEY(a)
]

Alice -> Bob: c

principal Bob[
	x = DH_KEX(c, b)
	generates nb, n2
	t2 = AEAD_ENC(k_bs, n2, CONCAT(x, nb), nil)
]

Bob -> Server: n2, t2

principal Server[
	knows private k_bs
	d = AEAD_DEC(k_bs, n2, t2, nil)?
	x_s, nb_s = SPLIT(d)?
	generates kab, n3, n4
	t3 = AEAD_ENC(k_bs, n3, CONCAT(nb_s, kab), nil)
	t4 = AEAD_ENC(k_bs, n4, CONCAT(nb_s, x_s), nil)
]

Server -> Alice: n4, t4
Server -> Bob: n3, t3

principal Bob[
	d3 = AEAD_DEC(k_bs, n3, t3, nil)?
	nb3, key = SPLIT(d3)?
	_ = ASSERT(nb3, nb)?
	generates secret_b, n_e
	e = AEAD_ENC(key, n_e, secret_b, nil)
]

Bob -> Alice: n_e, e

principal Alice[
	_ = HASH(t4, e)
]

queries[
	confidentiality? secret_b
]

//
// Expected: c1 at one session and at two.
//
// Bob seals what he decrypts under kb behind a key from the share g2, and
// what he decrypts under kc behind a key from the share g1 salted with kk.
// Alice's ca2 carries kk under kb and her ca1 carries s under kc. The
// attacker replaces both shares with PUBKEY(nil), c2 with ca2 and c1 with
// ca1, opens e2 to learn kk, then derives k1 and opens e1.
//
// The second key needs a secret only the first decryption oracle yields,
// and that oracle is itself behind a key the attacker makes derivable by
// its own install. While the deducer solves the second key it does not try
// that oracle, whose key it does not yet hold, so the attack depends on the
// search: an execution that substitutes the share and ca2 teaches the union
// kk, and a query-source merge combines it with the substitution of ca1.
//
// solver_revealed_oracle_chain_decryption_guarded.vp guards g2 and holds.
attacker[active]

principal Alice[
	knows private kb, kc
	knows private kk
	generates s
	ca2 = ENC(kb, kk)
	ca1 = ENC(kc, s)
]

Alice -> Dave: [ca2], [ca1]

principal Dave[
	knows private kb, kc
	sd2 = DEC(kb, ca2)
	sd1 = DEC(kc, ca1)
]

principal Carol[
	knows private kb, kc
	generates x2, x1, m2, m1
	g2 = PUBKEY(x2)
	g1 = PUBKEY(x1)
	c2 = ENC(kb, m2)
	c1 = ENC(kc, m1)
]

Carol -> Bob: g2, c2, g1, c1

principal Bob[
	knows private kb, kc, kk
	knows public ad
	generates y2, n2, y1, n1
	gy2 = PUBKEY(y2)
	gy1 = PUBKEY(y1)
	d2 = DEC(kb, c2)
	k2 = HKDF(nil, DH_KEX(g2, y2), nil)
	e2 = AEAD_ENC(k2, n2, d2, ad)
	d1 = DEC(kc, c1)
	k1 = HKDF(kk, DH_KEX(g1, y1), nil)
	e1 = AEAD_ENC(k1, n1, d1, ad)
]

Bob -> Carol: gy2, n2, e2, gy1, n1, e1

queries[
	confidentiality? s
]

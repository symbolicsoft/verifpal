//
// Expected: c1 at one session and at two.
//
// cfy_x and cfy_y are hashes of public values, and cfy_e1, cfy_e2 encrypt each
// under the other. In phase 1 cfy_ep seals the forgeable partial under cfy_x.
// The attacker builds cfy_x, opens cfy_ep and opens the genuine partial for
// cfy_s1. Opening cfy_e1 and cfy_e2 in one pass recorded each key as derived
// from the other, and the provenance walk read that cycle as passing through
// the forgery. closure_forged_cyclic_records_sealed.vp is the counterweight.
attacker[passive]
principal Alice[
	knows private cfy_sk
	knows public cfy_mx, cfy_my
	generates cfy_k, cfy_na, cfy_m
	cfy_s1, cfy_s2 = THRESHOLD_SPLIT[2](cfy_k)
	cfy_ca = PUBKEY(cfy_na)
	cfy_p = THRESHOLD_SIGN[forgeable](cfy_s1, cfy_na, cfy_ca, cfy_m)
	cfy_x = HASH(cfy_mx)
	cfy_y = HASH(cfy_my)
	cfy_e1 = ENC(cfy_y, cfy_x)
	cfy_e2 = ENC(cfy_x, cfy_y)
	leaks cfy_na
]
Alice -> Bob: cfy_ca, cfy_m, cfy_e1, cfy_e2
principal Bob[
	_ = HASH(cfy_ca, cfy_m, cfy_e1, cfy_e2)
]
phase[1]
principal Alice[
	cfy_ep = ENC(cfy_x, cfy_p)
]
Alice -> Bob: cfy_ep
principal Bob[
	_ = HASH(cfy_ep)
]
queries[
	confidentiality? cfy_s1
]

//
// Expected: e0 — the ground truth behind the rebuilt-statement forgery,
// established without asking the search to find anything.
//
// Mallory is a declared principal holding its own key. It performs both
// substitutions by hand: it rewrites the request to carry gm while keeping the
// verifier's nonce, harvests the signature from the reply now sealed under a
// key it shares with the signer, and re-seals it toward the verifier under a
// key it shares with the verifier.
//
// The wire is guarded throughout, because the point is what Mallory does and
// not what the Dolev-Yao attacker can do around it. Unguarded, the attacker
// perturbs the very values being compared and the equivalence reports a
// difference that is its own doing.
//
// e0 says secret and got resolve to the same value, so the secret the verifier
// believes it shares with the signer is one Mallory holds. The model also loads
// without a sanity error, so every checked primitive — the verifier's SIGNVERIF
// included — succeeds in the honest run.
attacker[active]

principal Signer[
	knows private ssk
	knows public c_ad
	knows public c_tag
	knows public c_stmt
	generates y
	gs = PUBKEY(ssk)
	gy = PUBKEY(y)
]

Signer -> Verifier: [gs]
Signer -> Mallory: [gs]

principal Verifier[
	knows public c_ad
	knows public c_tag
	knows public c_stmt
	generates x
	generates nonce
	generates secret
	gx = PUBKEY(x)
	req = CONCAT(c_tag, gx, nonce)
]

Verifier -> Mallory: [req]

principal Mallory[
	knows private m
	knows public c_ad
	knows public c_tag
	knows public c_stmt
	gm = PUBKEY(m)
	tag_m, gx_m, nonce_m = SPLIT(req)?
	_ = ASSERT(tag_m, c_tag)?
	req2 = CONCAT(c_tag, gm, nonce_m)
]

Mallory -> Signer: [req2]

principal Signer[
	tag_s, gx_s, nonce_s = SPLIT(req2)?
	_ = ASSERT(tag_s, c_tag)?
	stmt = CONCAT(c_stmt, gs, nonce_s)
	sig = SIGN(ssk, stmt)
	k = HKDF(nil, DH_KEX(gx_s, y), nil)
	env = AEAD_ENC(k, CONCAT(gs, sig), c_ad)
]

Signer -> Mallory: [gy], [env]

principal Mallory[
	km = HKDF(nil, DH_KEX(gy, m), nil)
	dm = AEAD_DEC(km, env, c_ad)?
	iss_m, sig_m = SPLIT(dm)?
	kv_m = HKDF(nil, DH_KEX(gx_m, m), nil)
	env2 = AEAD_ENC(kv_m, CONCAT(iss_m, sig_m), c_ad)
]

Mallory -> Verifier: [gm], [env2]

principal Verifier[
	kv = HKDF(nil, DH_KEX(gm, x), nil)
	d = AEAD_DEC(kv, env2, c_ad)?
	iss_v, sig_v = SPLIT(d)?
	_ = ASSERT(iss_v, gs)?
	stmt_v = CONCAT(c_stmt, iss_v, nonce)
	_ = SIGNVERIF(iss_v, stmt_v, sig_v)?
	out = AEAD_ENC(kv, secret, c_ad)
]

Verifier -> Mallory: [out]

principal Mallory[
	got = AEAD_DEC(kv_m, out, c_ad)?
]

queries[
	equivalence? secret, got
]

// The encapsulation randomness is as sensitive as the decapsulation key:
// anyone holding it can recompute the shared secret from the public
// encapsulation key alone, without ever decapsulating.

attacker[active]

principal Bob[
	knows private dkb
	ekb = PUBKEY(dkb)
]

Bob -> Alice: [ekb]

principal Alice[
	knows private m
	generates r
	ss, ct = KEM_ENCAP(ekb, r)
	generates n_e
	e = AEAD_ENC(ss, n_e, m, nil)
	leaks r
]

Alice -> Bob: ct, n_e, e

principal Bob[
	ssb = KEM_DECAP(dkb, ct)
	d = AEAD_DEC(ssb, n_e, e, nil)?
]

queries[
	confidentiality? m
	confidentiality? ss
]

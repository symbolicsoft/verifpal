// SPDX-License-Identifier: GPL-3.0-only
//
// Expected: c1c0c1c0 — PW_HASH is the one primitive that is both a weakening
// target and a guessing barrier, and this model is where the two meet. The
// declared assumption is that this particular password hash is invertible, and
// under it the password falls even though its position is a password_hashing
// position: the barrier stops an offline GUESS, and `weak` is not a guess.
//
// The unannotated twin sits beside it under the same attacker, over a password
// of the same kind, so a can_break_weak that consulted the spec's weak_reveals
// without also consulting the call site's capabilities would take pw_sound
// down with pw_broken.
//
// The two ciphertexts are keyed on HASH of the password rather than on the
// published record itself. That is deliberate: keyed on the record, the
// attacker would open m_broken by holding the record and never need the
// password at all, and the model would pass while asserting nothing.

attacker[passive]

principal Alice[
	knows password pw_broken
	knows password pw_sound
	knows private m_broken, m_sound
	stored_broken = PW_HASH[weak](pw_broken)
	stored_sound = PW_HASH(pw_sound)
	e_broken = ENC(HASH(pw_broken), m_broken)
	e_sound = ENC(HASH(pw_sound), m_sound)
]

Alice -> Bob: stored_broken, stored_sound, e_broken, e_sound

principal Bob[
	knows password pw_broken
	knows password pw_sound
	d_broken = DEC(HASH(pw_broken), e_broken)
	d_sound = DEC(HASH(pw_sound), e_sound)
]

queries[
	confidentiality? pw_broken
	confidentiality? pw_sound
	confidentiality? m_broken
	confidentiality? m_sound
]

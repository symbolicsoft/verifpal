//
// Expected: u1 at one session and at two (GitHub issue #57).
//
// search_unlink_check_route.vp without eskone and esktwo on the wire. No
// execution reveals a signing key, so message is the only missing argument,
// and the link is the same: sending the key boxes only gives the attacker
// more options.

attacker[active]

principal Alice[
	knows private kb, kc, skone, sktwo
	generates x, y
	message = HASH(x, y)
	sigone = SIGN(skone, message)
	sigtwo = SIGN(sktwo, message)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	ex = ENC(kb, x)
	ey = ENC(kc, y)
	eskone = ENC(kb, skone)
	esktwo = ENC(kc, sktwo)
	eb = ENC(kb, nil)
	ec = ENC(kc, nil)
]

Alice -> Dave: ex, ey, pkone, pktwo, sigone, sigtwo

Alice -> Bob: eb

Alice -> Carol: ec

principal Bob[
	knows private kb
	db = DEC(kb, eb)
	leaks db
]

principal Carol[
	knows private kc
	dc = DEC(kc, ec)
	leaks dc
]

principal Dave[
	_ = HASH(ex, ey, pkone, pktwo, sigone)
	_ = HASH(sigtwo)
]

queries[
	unlinkability? sigone, sigtwo
]

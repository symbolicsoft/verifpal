//
// Expected: a0 at one session, a1 at two.
//
// cap_forgeable_executed_secret_leaked.vp with x guarded: Alice's forgeable
// call is keyed only by HASH(psk, x), and psk leaks only after Bob's check,
// so at one session nothing Bob accepts can be forged. At two sessions Bob#2
// leaks psk before Bob receives, and the attacker builds Bob's tag over md#2
// itself: Dave sent md#2 once and it is accepted twice.
attacker[active]
principal Carol[
	generates x
]
Carol -> Alice: [x]
principal Alice[
	knows private psk, al
	generates ma
	gal = PUBKEY(al)
	ta = MAC[forgeable](HASH(psk, x), CONCAT(ma, gal))
]
Alice -> Carol: ma, ta
principal Dave[
	knows private psk, dl
	generates y, md
	gdl = PUBKEY(dl)
	td = MAC(HASH(psk, y), CONCAT(md, gdl))
]
Dave -> Bob: [gdl], [y], md, td
principal Bob[
	knows private psk
	_ = ASSERT(MAC(HASH(psk, y), CONCAT(md, gdl)), td)?
	leaks psk
]
queries[
	authentication? Dave -> Bob: md
]

// Expected: c0 at one session and at two.
// The leaked tuple exposes Mallory's derived private key, so the scenario
// with Mallory as peer is corrupt and contributes no confidentiality claim.

attacker[active]

principal Bob[
	knows private scl_b
	scl_gb = PUBKEY(scl_b)
]

principal Mallory[
	knows private scl_mk
	knows public scl_pad
	scl_mk2 = HASH(scl_mk)
	scl_gm = PUBKEY(scl_mk2)
	scl_wrap = CONCAT(scl_mk2, scl_pad)
	leaks scl_wrap
]

principal Alice[
	knows public scl_gpeer
	generates scl_ni
]

Bob -> Alice: [scl_gb]
Mallory -> Alice: [scl_gm]

principal Alice[
	scl_m1 = PKE_ENC(scl_gpeer, scl_ni)
]

Alice -> Bob: scl_m1

principal Bob[
	scl_ni_b = PKE_DEC(scl_b, scl_m1)
]

scenarios[
	Alice[scl_gpeer = scl_gb]
	Alice[scl_gpeer = scl_gm]
]

queries[
	confidentiality? scl_ni
]

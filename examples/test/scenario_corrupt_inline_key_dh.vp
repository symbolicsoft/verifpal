// Expected: c0 at one session and at two.
//
// Mallory's key is PUBKEY(HASH(seed)) and she leaks seed, so a run with her
// as peer is corrupt and its secret is not the protocol's to keep, here
// under a Diffie-Hellman key agreement. Key material was once recorded only
// when a constant sat at the key position, so the inline HASH(seed) left the
// scenario honest.
attacker[active]
principal Bob[
	knows private b
	gb = PUBKEY(b)
]
principal Mallory[
	generates seed
	gm = PUBKEY(HASH(seed))
	leaks seed
]
Bob -> Alice: [gb]
Mallory -> Alice: [gm]
principal Alice[
	knows private a
	ga = PUBKEY(a)
	knows public gpeer
	generates s, n
	k = DH_KEX(gpeer, a)
	e = AEAD_ENC(k, n, s, nil)
]
Alice -> Bob: [ga], n, e
principal Bob[
	kb = DH_KEX(ga, b)
	sb = AEAD_DEC(kb, n, e, nil)
]
scenarios[
	Alice[gpeer = gb]
	Alice[gpeer = gm]
]
queries[
	confidentiality? s
]

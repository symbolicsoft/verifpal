//
// Expected: a1 at one session and at two.
//
// cap_forgeable_executed_secret.vp with Bob leaking psk after his check. The
// attack is unchanged: the attacker hands Alice y, her forgeable call keys
// itself with HASH(psk, y), and the attacker forges Bob's tag before Bob's
// leak. The leak made the forged tag honestly derivable within phase 0, so
// placement took it on trust, and the flight was stuck: the leak comes only
// after the receive that needs it. Placed again with its sources, the flight
// took the cheapest node deriving the tag by the end of phase 0, and every
// node does, through the same leak; the node that hands Alice y was never
// tried, so adding a leak lost an attack (the metamorphic `leaks` property).
// A value the honest disclosures before the receive do not derive now takes
// the cheapest node that derives it from them plus what it adds.
// cap_forgeable_executed_secret_leaked_guarded.vp is the counterweight.
attacker[active]
principal Carol[
	generates x
]
Carol -> Alice: x
principal Alice[
	knows private psk, al
	generates ma
	gal = PUBKEY(al)
	ta = MAC[forgeable](HASH(psk, x), CONCAT(ma, gal))
]
Alice -> Carol: ma, ta
principal Dave[
	knows private psk, dl
	generates y, md
	gdl = PUBKEY(dl)
	td = MAC(HASH(psk, y), CONCAT(md, gdl))
]
Dave -> Bob: [gdl], [y], md, td
principal Bob[
	knows private psk
	_ = ASSERT(MAC(HASH(psk, y), CONCAT(md, gdl)), td)?
	leaks psk
]
queries[
	authentication? Dave -> Bob: md
]

attacker[passive]

principal Alice[
	knows private a
	ga = PUBKEY(a)
]

principal Bob[
	knows private b
	gb = PUBKEY(b)
]

principal Carol[
	knows private c
	gc = PUBKEY(c)
]

Alice -> Bob: ga
Bob -> Alice: gb
Bob -> Carol: gb
Carol -> Bob: gc

principal Alice[
	generates secret
	key_ab = HASH(DH_KEX(gb, a))
	generates n_e_ab
	e_ab = AEAD_ENC(key_ab, n_e_ab, secret, nil)
]

Alice -> Bob: n_e_ab, e_ab

principal Bob[
	key_ba = HASH(DH_KEX(ga, b))
	secret_b = AEAD_DEC(key_ba, n_e_ab, e_ab, nil)?
	key_bc = HASH(DH_KEX(gc, b))
	generates n_e_bc
	e_bc = AEAD_ENC(key_bc, n_e_bc, secret_b, nil)
]

Bob -> Carol: n_e_bc, e_bc

principal Carol[
	key_cb = HASH(DH_KEX(gb, c))
	secret_c = AEAD_DEC(key_cb, n_e_bc, e_bc, nil)?
]

queries[
	confidentiality? secret
	confidentiality? secret_b
	confidentiality? secret_c
	equivalence? secret, secret_c
]

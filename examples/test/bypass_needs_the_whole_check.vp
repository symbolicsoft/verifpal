//
// Expected: a0. Knowing k does not supply the secret associated data ad. The
// attacker cannot construct a different ciphertext accepted by Bob. The
// companion with leaked ad permits a concrete forgery. Declared nonces keep
// the ciphertext identical across sessions.

attacker[active]

principal Alice[
	knows private k
	knows private ad
	leaks k
	knows private plain
	knows private n_c
	c = AEAD_ENC(k, n_c, plain, ad)
]

Alice -> Bob: n_c, c

principal Bob[
	knows private k
	knows private ad
	m = AEAD_DEC(k, n_c, c, ad)?
	generates s
	out = HASH(s, m)
]

Bob -> Alice: out

queries[
	authentication? Alice -> Bob: c
]

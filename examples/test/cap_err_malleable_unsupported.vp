//
// Sanity error: `malleable` is declared by the primitives whose ciphertexts can
// actually be mauled, and HASH is not one of them, so the engine rejects the
// annotation rather than accepting an assumption it would silently ignore. An
// annotation that does nothing reads as a check that was performed when it was
// not. See cap_malleable_enc.vp for the supported case.
attacker[active]

principal Alice[
	knows private k
	knows public m
	c = ENC(k, HASH[malleable](m))
]

Alice -> Bob: c

principal Bob[
	knows private k
	d = DEC(k, c)
	_ = HASH(d)
]

queries[
	confidentiality? m
]

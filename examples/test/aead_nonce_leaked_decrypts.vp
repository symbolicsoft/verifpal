//
// Expected: c1 — the counterweight to aead_nonce_needed_to_decrypt.vp. Leak
// the nonce beside the key and the ciphertext opens.

attacker[passive]

principal Alice[
	knows private k
	knows private n
	knows private m
	knows public ad
	leaks k, n
	e = AEAD_ENC(k, n, m, ad)
]

Alice -> Bob: e

principal Bob[
	knows private k
	knows private n
	knows public ad
	d = AEAD_DEC(k, n, e, ad)?
]

queries[
	confidentiality? m
]

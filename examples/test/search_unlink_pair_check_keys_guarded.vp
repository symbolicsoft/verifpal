//
// Expected: u0 at one session and at two.
//
// search_unlink_pair_check_keys.vp with ef guarded: PUBKEY(sktwo) stays
// hidden, so sigtwo can never be checked, and sigone alone links to nothing.

attacker[active]

principal Alice[
	knows private kb, kc, kd, kf, skone, sktwo
	generates x, y
	message = HASH(x, y)
	sigone = SIGN(skone, message)
	sigtwo = SIGN(sktwo, message)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	witness = HASH(message, pkone, pktwo)
	ex = ENC(kb, x)
	ey = ENC(kc, y)
	ekone = ENC(kd, pkone)
	ektwo = ENC(kf, pktwo)
	eb = ENC(kb, nil)
	ec = ENC(kc, nil)
	ed = ENC(kd, nil)
	ef = ENC(kf, nil)
]

Alice -> Dave: ex, ey, ekone, ektwo, sigone, sigtwo

Alice -> Bob: eb

Alice -> Carol: ec

Alice -> Erin: ed

Alice -> Frank: [ef]

principal Bob[
	knows private kb
	db = DEC(kb, eb)
	leaks db
]

principal Carol[
	knows private kc
	dc = DEC(kc, ec)
	leaks dc
]

principal Erin[
	knows private kd
	dd = DEC(kd, ed)
	leaks dd
]

principal Frank[
	knows private kf
	df = DEC(kf, ef)
	leaks df
]

principal Dave[
	_ = HASH(ex, ey, ekone, sigone)
	_ = HASH(sigtwo, ektwo)
]

queries[
	unlinkability? sigone, sigtwo
]

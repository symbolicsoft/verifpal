//
// Expected: a0 at one session, a1 at two.
//
// solver_threshold_join_inversion_unguarded_key.vp with only s3 leaked: one
// share is below the threshold, so the attacker cannot sign its own message.
// At two sessions pk is no longer guarded, so the attacker replays session
// two's msg#2, PUBKEY(k#2) and both partials to the first Coordinator: the
// Client sent msg#2 once and two Coordinators accept it, so agreement is not
// injective.
attacker[active]

principal Client[
	generates msg
]

Client -> Alice: [msg]

Client -> Coordinator: msg

principal Alice[
	generates k, na, nb
	s1, s2, s3 = THRESHOLD_SPLIT[2](k)
	pk = PUBKEY(k)
	ca = PUBKEY(na)
	cb = PUBKEY(nb)
	cl = CONCAT(ca, cb)
	leaks s3
]

Alice -> Coordinator: pk

principal Alice[
	pa = THRESHOLD_SIGN(s1, na, cl, msg)
	pb = THRESHOLD_SIGN(s2, nb, cl, msg)
]

Alice -> Coordinator: pa, pb

principal Coordinator[
	sig = THRESHOLD_JOIN(pa, pb)
	_ = SIGNVERIF(pk, msg, sig)?
]

queries[
	authentication? Client -> Coordinator: msg
]

//
// Expected: c1c0a1a0 — the shape every naive password protocol has. A server
// challenge is public by construction, so a proof computed as MAC(password,
// CONCAT(challenge, order)) hands the attacker a complete offline verifier:
// guess, recompute, compare against a transcript it already holds. Running the
// password through PW_HASH first costs the protocol nothing and removes the
// verifier entirely.
//
// The order is what makes the authentication half sharp. A proof over the
// challenge ALONE cannot be attacked even with the password in hand, because
// the only proof the server will accept is the one the client already sent and
// reproducing it is a replay. Binding a message the attacker can vary is what
// turns a recovered password into an actual forgery.

attacker[active]

principal Server[
	knows password pw_raw
	knows password pw_hard
	generates challenge
]

Server -> Client: challenge

principal Client[
	knows password pw_raw
	knows password pw_hard
	knows private order_raw, order_hard
	proof_raw = MAC(pw_raw, CONCAT(challenge, order_raw))
	proof_hard = MAC(PW_HASH(pw_hard), CONCAT(challenge, order_hard))
]

Client -> Server: order_raw, proof_raw, order_hard, proof_hard

principal Server[
	_ = ASSERT(MAC(pw_raw, CONCAT(challenge, order_raw)), proof_raw)?
	_ = ASSERT(MAC(PW_HASH(pw_hard), CONCAT(challenge, order_hard)), proof_hard)?
	_ = HASH(order_raw, order_hard)
]

queries[
	confidentiality? pw_raw
	confidentiality? pw_hard
	authentication? Client -> Server: order_raw
	authentication? Client -> Server: order_hard
]

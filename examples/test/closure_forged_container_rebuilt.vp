//
// Expected: c1 at one session and at two.
//
// cfc_e seals CONCAT(cfc_x, nil) around the forgeable partial, and its key
// leaks in phase 1. In phase 0 the attacker rebuilds the CONCAT from a forged
// partial; in phase 1 it opens the genuine one and splits out the genuine
// partial, which reveals cfc_s1. The container's first, forged record decided
// the partial's provenance and the attack was missed.
// closure_forged_container_rebuilt_sealed.vp is the counterweight.
attacker[passive]
principal Alice[
	generates cfc_k, cfc_na, cfc_m, cfc_nx
	knows private cfc_kx
	cfc_s1, cfc_s2 = THRESHOLD_SPLIT[2](cfc_k)
	cfc_ca = PUBKEY(cfc_na)
	cfc_x = THRESHOLD_SIGN[forgeable](cfc_s1, cfc_na, cfc_ca, cfc_m)
	cfc_e = AEAD_ENC(cfc_kx, cfc_nx, CONCAT(cfc_x, nil), nil)
	leaks cfc_na
]
Alice -> Bob: cfc_ca, cfc_m, cfc_nx, cfc_e
principal Bob[
	knows private cfc_kx
	_ = AEAD_DEC(cfc_kx, cfc_nx, cfc_e, nil)
]
phase[1]
principal Alice[
	leaks cfc_kx
]
queries[
	confidentiality? cfc_s1
]

//
// Expected: a0 at one session and at two.
//
// cap_forgeable_executed_secret.vp with x guarded: Alice's forgeable call is
// keyed only by HASH(psk, x), which never keys anything Bob checks, so nothing
// Bob accepts can be forged.
attacker[active]
principal Carol[
	generates x
]
Carol -> Alice: [x]
principal Alice[
	knows private psk, al
	generates ma
	gal = PUBKEY(al)
	ta = MAC[forgeable](HASH(psk, x), CONCAT(ma, gal))
]
Alice -> Carol: ma, ta
principal Dave[
	knows private psk, dl
	generates y, md
	gdl = PUBKEY(dl)
	td = MAC(HASH(psk, y), CONCAT(md, gdl))
]
Dave -> Bob: [gdl], [y], md, td
principal Bob[
	knows private psk
	_ = ASSERT(MAC(HASH(psk, y), CONCAT(md, gdl)), td)?
]
queries[
	authentication? Dave -> Bob: md
]

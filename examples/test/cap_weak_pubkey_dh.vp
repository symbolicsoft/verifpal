//
// Expected: c1 — PUBKEY[weak] is discrete log. The attacker takes ga off the
// wire, recovers a, and reconstructs DH_KEX(gb, a) through the EXISTING
// can_reconstruct_primitive. This model pins that no DH-specific rule is
// involved in the cascade.
attacker[passive]

principal Alice[
	generates a
	ga = PUBKEY[weak](a)
]

principal Bob[
	generates b
	gb = PUBKEY(b)
]

Alice -> Bob: ga
Bob -> Alice: gb

principal Alice[
	knows private m
	k = DH_KEX(gb, a)
	generates n_e
	e = AEAD_ENC(k, n_e, m, nil)
]

Alice -> Bob: n_e, e

principal Bob[
	kb = DH_KEX(ga, b)
	mb = AEAD_DEC(kb, n_e, e, nil)
]

queries[
	confidentiality? m
]

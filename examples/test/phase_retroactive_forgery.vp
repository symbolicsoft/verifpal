attacker[active]

principal Alice[
	knows private a
	ga = PUBKEY(a)
]

principal Bob[
	knows private b
	gb = PUBKEY(b)
	generates s
	gs = PUBKEY(s)
	sig = SIGN(b, gs)
]

Bob -> Alice: [gb], gs, sig

principal Alice[
	generates m
	_ = SIGNVERIF(gb, gs, sig)?
	k = DH_KEX(gs, a)
	generates n_c
	c = AEAD_ENC(k, n_c, m, nil)
]

Alice -> Bob: ga, n_c, c

phase[1]

principal Bob[leaks b]

queries[
	confidentiality? m
	authentication? Bob -> Alice: gs
]

//
// Expected: a0 at one session, a1 at two.
//
// remote_aa_bound_leaked_signature.vp with Phone's last message also sent to
// an Auditor that does nothing with it. The attack on resp is the same
// execution: Auditor receives whatever Phone sends, or waits when Phone halts,
// and no query reads its state.
//
// The search kept every run holding an authentication subject in its install
// maps up to that run's last step, so Auditor's receive was relevant. Whenever
// Phone halted, Auditor's four slots were withheld and filled together with
// Bank's in every combination: the search ran for minutes over seventy
// thousand fills and never reached the merge that finds the attack. A run
// that holds an authentication or freshness subject but never uses it cannot
// accept it, so only its sends and leaks are relevant. The counterweight is
// search_inert_recipient_private_nfc.vp.
//
// Bank discloses each challenge as it makes it, as if challenges were
// predictable. The attack needs that: two challenges sealed under ck#2 and
// nChal give the attacker their XOR and the tag key, and only a known
// plaintext under that key and nonce gives the keystream that forging a
// chosen chalMsg takes. examples/epassport/remote_aa_bound.vp, whose
// challenges stay secret, holds at both counts.

attacker[active]

principal Passport[
	knows private aaKey
	dg15 = PUBKEY(aaKey)
]

Passport -> Issuer: [dg15]

principal Issuer[
	knows private dsKey, persoKey, dg1
	dsPub = PUBKEY(dsKey)
	sodSig = SIGN(dsKey, HASH(dg1, dg15))
	perso = ENC(persoKey, sodSig)
]

Issuer -> Bank: [dsPub]
Issuer -> Passport: [perso]

principal Evil[
	knows private evilKey
	evilPub = PUBKEY(evilKey)
	leaks evilKey
]

principal Bank[
	knows private bankKey
	bankPub = PUBKEY(bankKey)
]

Bank -> Phone: [bankPub]
Evil -> Phone: [evilPub]

principal Phone[
	knows private nfcKey
	knows public rpPub, nChal, nResp
	generates ck
	ckMsg = PKE_ENC(rpPub, ck)
]

Phone -> Bank: ckMsg

principal Bank[
	knows public nChal, nResp
	ck_b = PKE_DEC(bankKey, ckMsg)
	generates chal
	leaks chal
	chalMsg = AEAD_ENC(ck_b, nChal, chal, nil)
]

Bank -> Phone: chalMsg

principal Phone[
	chal_p = AEAD_DEC(ck, nChal, chalMsg, nil)?
	toSign = HASH(rpPub, chal_p)
	nfcRequest = ENC(nfcKey, toSign)
]

Phone -> Passport: [nfcRequest]

principal Passport[
	knows private persoKey, dg1, nfcKey
	sodSig_p = DEC(persoKey, perso)
	challenge_p = DEC(nfcKey, nfcRequest)
	aaSig = SIGN(aaKey, challenge_p)
	leaks aaSig
	nfcAnswer = ENC(nfcKey, CONCAT(dg1, dg15, sodSig_p, aaSig))
]

Passport -> Phone: [nfcAnswer]

principal Phone[
	dg1_phone, dg15_phone, sodSig_phone, aaSig_phone = SPLIT(DEC(nfcKey, nfcAnswer))
	resp = AEAD_ENC(ck, nResp, aaSig_phone, nil)
]

Phone -> Bank: dg1_phone, dg15_phone, sodSig_phone, resp
Phone -> Auditor: dg1_phone, dg15_phone, sodSig_phone, resp

principal Auditor[
	knows public auditorLabel
]

principal Bank[
	_ = SIGNVERIF(dsPub, HASH(dg1_phone, dg15_phone), sodSig_phone)?
	_ = SIGNVERIF(dg15_phone, HASH(bankPub, chal), AEAD_DEC(ck_b, nResp, resp, nil))?
]

scenarios[
	Phone[rpPub = bankPub]
	Phone[rpPub = evilPub]
]

queries[
	authentication? Phone -> Bank: resp
]

//
// Expected: c0 at one session and at two.
//
// solver_nested_oracle.vp with the nonce guarded: Bob decrypts only under
// HASH(kb, nc), which opens none of Alice's ciphertexts, so s stays secret.
attacker[active]

principal Carol[
	knows private kb
	generates mc, nc
	xc = ENC(HASH(kb, nc), mc)
]

Carol -> Bob: [nc], xc

principal Alice[
	knows private kb
	generates s, na
	ca = ENC(HASH(kb, na), s)
]

Alice -> Dave: na, [ca]

principal Dave[
	knows private kb
	sd = DEC(HASH(kb, na), ca)
]

principal Bob[
	knows private kb
	knows public kp
	m = DEC(HASH(kb, nc), xc)
	e = ENC(kp, m)
]

Bob -> Carol: e

queries[
	confidentiality? s
]

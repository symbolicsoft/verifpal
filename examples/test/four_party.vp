//
// Expected: c1a0a0a0 at one session and c1a1a1a0 at two.
//
// msg is disclosed at every session count because Bob sends msg_b to Damian in
// the clear: the guard prevents its replacement, not its observation.
//
// At two sessions Carol and Bob accept envelopes replayed from the other
// session, so the two middle authentication queries fail as injective
// agreement failures. The last one holds: Damian checks audit_mac against
// msg_b, which reaches him guarded from his own Bob run, so the only value he
// accepts is the MAC that Bob run computed. A replay of Bob#2's audit_mac
// passes only when Bob's msg_b was itself replayed from session 2, and then
// Bob's own run sent exactly that MAC, so each Damian run accepts what its own
// Bob run sent.

attacker[active]

principal Alice[
	knows private a
	ga = PUBKEY(a)
]

principal Bob[
	knows private b
	gb = PUBKEY(b)
]

principal Carol[
	knows private c
	gc = PUBKEY(c)
]

principal Damian[
	knows private d
	gd = PUBKEY(d)
]

Alice -> Carol: [ga]
Alice -> Bob: [ga]
Bob -> Carol: [gb]
Carol -> Alice: [gc]
Carol -> Bob: [gc]
Damian -> Bob: [gd]
Bob -> Damian: [gb]

principal Alice[
	generates msg
	sig = SIGN(a, msg)
	shared_ac = DH_KEX(gc, a)
	generates n_envelope
	envelope = AEAD_ENC(shared_ac, n_envelope, CONCAT(msg, sig), ga)
]

Alice -> Carol: n_envelope, envelope

principal Carol[
	inner = AEAD_DEC(DH_KEX(ga, c), n_envelope, envelope, ga)?
	msg_c, sig_c = SPLIT(inner)?
	shared_cb = DH_KEX(gb, c)
	generates n_re_envelope
	re_envelope = AEAD_ENC(shared_cb, n_re_envelope, CONCAT(msg_c, sig_c), gc)
]

Carol -> Bob: n_re_envelope, re_envelope

principal Bob[
	inner_b = AEAD_DEC(DH_KEX(gc, b), n_re_envelope, re_envelope, gc)?
	msg_b, sig_b = SPLIT(inner_b)?
	_ = SIGNVERIF(ga, msg_b, sig_b)?
	audit_mac = MAC(DH_KEX(gd, b), msg_b)
]

Bob -> Damian: [msg_b], audit_mac

principal Damian[
	_ = ASSERT(MAC(DH_KEX(gb, d), msg_b), audit_mac)?
]

queries[
	confidentiality? msg
	authentication? Alice -> Carol: envelope
	authentication? Carol -> Bob: re_envelope
	authentication? Bob -> Damian: audit_mac
]

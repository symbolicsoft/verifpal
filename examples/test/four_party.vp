// Four-party protocol: Alice sends a signed+encrypted message through
// a relay (Carol) to Bob, who forwards a MAC to Damian for auditing.
// Tests multi-hop message flow and cross-principal authentication.
//
// Expected: c1a0a0a0.  `msg` is not confidential because Bob puts it on the
// wire himself in `Bob -> Damian: [msg_b], audit_mac`: a guard stops the
// attacker replacing a value, not seeing it.
//
// All three authentication queries hold for one reason — every DH public is
// guarded, so the attacker never obtains a pairwise secret and can only forward
// the real message.  `re_envelope` would need AEAD_ENC(G^c^b, ...), `audit_mac`
// MAC(G^b^d, ...).
//
// Two of them used to report a1, by two different false shapes:
//
//   - `re_envelope`: a relay credited to the attacker because another slot of
//     the same proposal carried a genuine substitution.
//   - `audit_mac`: sending Carol `nil` leaves Bob's AEAD_DEC(gc^b, ...)? stuck,
//     so `msg_b` never reduces.  Damian's state cannot see that Bob halted, so
//     handing that same stuck term back made his ASSERT compare two identical
//     dead computations and pass.

attacker[active]

principal Alice[
	knows private a
	ga = G^a
]

principal Bob[
	knows private b
	gb = G^b
]

principal Carol[
	knows private c
	gc = G^c
]

principal Damian[
	knows private d
	gd = G^d
]

Alice -> Carol: [ga]
Alice -> Bob: [ga]
Bob -> Carol: [gb]
Carol -> Alice: [gc]
Carol -> Bob: [gc]
Damian -> Bob: [gd]
Bob -> Damian: [gb]

// Alice encrypts a message for Carol, signed, routed through Carol to Bob
principal Alice[
	generates msg
	sig = SIGN(a, msg)
	shared_ac = gc^a
	envelope = AEAD_ENC(shared_ac, CONCAT(msg, sig), ga)
]

Alice -> Carol: envelope

// Carol re-encrypts for Bob
principal Carol[
	inner = AEAD_DEC(ga^c, envelope, ga)?
	msg_c, sig_c = SPLIT(inner)?
	shared_cb = gb^c
	re_envelope = AEAD_ENC(shared_cb, CONCAT(msg_c, sig_c), gc)
]

Carol -> Bob: re_envelope

// Bob decrypts, verifies Alice's signature, and MACs for Damian
principal Bob[
	inner_b = AEAD_DEC(gc^b, re_envelope, gc)?
	msg_b, sig_b = SPLIT(inner_b)?
	_ = SIGNVERIF(ga, msg_b, sig_b)?
	audit_mac = MAC(gd^b, msg_b)
]

Bob -> Damian: [msg_b], audit_mac

principal Damian[
	_ = ASSERT(MAC(gb^d, msg_b), audit_mac)?
]

queries[
	confidentiality? msg
	authentication? Alice -> Carol: envelope
	authentication? Carol -> Bob: re_envelope
	authentication? Bob -> Damian: audit_mac
]

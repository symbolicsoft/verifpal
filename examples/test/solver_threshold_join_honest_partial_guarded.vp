//
// Expected: a0 at one session and at two.
//
// solver_threshold_join_honest_partial.vp with the Client's message to Alice
// guarded. Alice still signs under a commitment list the attacker chooses, so
// the attacker can join her partial with one of its own under the leaked
// share, but only over the Client's message: the Coordinator accepts nothing
// the Client did not send.
attacker[active]

principal Dealer[
	knows private psk_a
	knows private psk_b
	generates k
	pk = PUBKEY(k)
	s1, s2, s3 = THRESHOLD_SPLIT[2](k)
	generates nd_a
	ea = AEAD_ENC(psk_a, nd_a, s1, pk)
	generates nd_b
	eb = AEAD_ENC(psk_b, nd_b, s2, pk)
	leaks s3
]

Dealer -> Alice: [pk], nd_a, ea

Dealer -> Bob: [pk], nd_b, eb

Dealer -> Coordinator: [pk]

principal Alice[
	knows private psk_a
	sa = AEAD_DEC(psk_a, nd_a, ea, pk)?
	generates na
	ca = PUBKEY(na)
]

principal Bob[
	knows private psk_b
	sb = AEAD_DEC(psk_b, nd_b, eb, pk)?
	generates nb
	cb = PUBKEY(nb)
]

Alice -> Coordinator: [ca]

Bob -> Coordinator: [cb]

principal Client[
	generates m
]

Client -> Coordinator: m

Client -> Alice: [m]

Client -> Bob: [m]

Coordinator -> Alice: cb

Coordinator -> Bob: [ca]

principal Alice[
	cl_a = CONCAT(ca, cb)
	pa = THRESHOLD_SIGN(sa, na, cl_a, m)
]

principal Bob[
	cl_b = CONCAT(ca, cb)
	pb = THRESHOLD_SIGN(sb, nb, cl_b, m)
]

Alice -> Coordinator: pa

Bob -> Coordinator: pb

principal Coordinator[
	sig = THRESHOLD_JOIN(pa, pb)
	_ = SIGNVERIF(pk, m, sig)?
]

queries[
	authentication? Client -> Coordinator: m
]

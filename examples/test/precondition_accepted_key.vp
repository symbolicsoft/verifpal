//
// Expected: c1c0c0
//
// A signed Diffie-Hellman handshake in which the client derives the session
// key before verifying the server's signature, as TLS and Noise do. The
// attacker substitutes its own share for gs, so the client computes an
// attacker-known k_client and then halts at SIGNVERIF without using it. The
// plain query reports that discarded key as compromised. The gated query is
// restricted to executions in which the client goes on to send req, and in
// every such execution the signature verified, so gs was the server's and the
// key is a two-party secret. request is only encrypted after the check and
// holds on its own, which is the workaround the gated query makes unnecessary.

attacker[active]

principal Server[
	knows private server_sk
	server_pk = PUBKEY(server_sk)
]

Server -> Client: [server_pk]

principal Client[
	generates c
	gc = PUBKEY(c)
]

Client -> Server: gc

principal Server[
	generates s
	gs = PUBKEY(s)
	sig = SIGN(server_sk, gs)
	k_server = DH_KEX(gc, s)
]

Server -> Client: gs, sig

principal Client[
	k_client = DH_KEX(gs, c)
	_ = SIGNVERIF(server_pk, gs, sig)?
	generates request
	req = AEAD_ENC(k_client, request, nil)
]

Client -> Server: req

principal Server[
	_ = AEAD_DEC(k_server, req, nil)?
]

queries[
	confidentiality? k_client
	confidentiality? k_client[
		precondition[Client -> Server: req]
	]
	confidentiality? request
]

//
// Expected: a0 at one session and at two.
//
// solver_oracle_input_held_tuple.vp with Bob's tuple guarded: Bob decrypts and
// signs only Carol's message, so no signature over Frank's challenge exists
// besides Dave's.
attacker[active]

principal Frank[
	knows private kb
	generates ch, na
	ca = ENC(HASH(kb, na), ch)
]

Frank -> Dave: na, [ca]

principal Dave[
	knows private kb, skb
	sd = SIGN(skb, DEC(HASH(kb, na), ca))
]

Dave -> Frank: sd

principal Carol[
	knows private kb
	generates mc, nc
	tc = CONCAT(ENC(HASH(kb, nc), mc), nc)
]

Carol -> Bob: [tc]

principal Bob[
	knows private kb, skb
	yc, yn = SPLIT(tc)
	e = SIGN(skb, DEC(HASH(kb, yn), yc))
]

Bob -> Carol: e

principal Frank[
	knows private skb
	pkb = PUBKEY(skb)
	_ = SIGNVERIF(pkb, ch, sd)?
]

queries[
	authentication? Dave -> Frank: sd
]

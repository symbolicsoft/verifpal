//
// Expected: c1 at one session and at two.
//
// Client sends HASH[weak](pw, ga, gb), a low-entropy password proof bound to
// the transcript, under an unauthenticated Diffie-Hellman key. A
// man-in-the-middle replaces gb with its own key, opens the ciphertext and
// holds the proof Client's annotated call computed: HASH(pw, ga, PUBKEY(nil)).
// The annotation is on the call, so that term is weak and gives up pw.
//
// `weak` was looked up only for the term the honest run computes, so binding
// the proof to the transcript hid the attack that the unbound proof
// HASH[weak](pw) still showed. An execution now indexes the annotated terms
// it computed. cap_weak_executed_term_strong.vp is the counterweight.
attacker[active]
principal Client[
	knows private pw
	generates a
	ga = PUBKEY(a)
]
Client -> Server: ga
principal Server[
	knows private pw
	generates b
	gb = PUBKEY(b)
]
Server -> Client: gb
principal Client[
	k = DH_KEX(gb, a)
	proof = HASH[weak](pw, ga, gb)
	generates n
	e = AEAD_ENC(k, n, proof, nil)
]
Client -> Server: n, e
principal Server[
	ks = DH_KEX(ga, b)
	p = AEAD_DEC(ks, n, e, nil)?
	_ = ASSERT(p, HASH(pw, ga, gb))?
]
queries[
	confidentiality? pw
]

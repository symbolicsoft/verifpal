//
// Expected: a1 at one session and at two.
//
// Alice's MAC call is declared forgeable and keys itself with the nonce she
// receives. Bob verifies Dave's MAC under HASH(psk, y), and y reaches him
// guarded, so the declared secret HASH(psk, x) never keys anything Bob checks.
// The attacker hands Alice y, which it read on the wire: in that execution
// Alice's annotated call computes MAC under HASH(psk, y). The annotation is on
// the call, and forgeable applies to every MAC under the secret it used, so the
// attacker forges MAC(HASH(psk, y), CONCAT(nil, gdl)) and Bob accepts nil as
// Dave's md.
//
// Reading the declared secret alone, as `weak` once read the declared term
// alone (cap_weak_executed_term.vp), hid this. cap_forgeable_executed_secret_strong.vp
// is the counterweight.
attacker[active]
principal Carol[
	generates x
]
Carol -> Alice: x
principal Alice[
	knows private psk, al
	generates ma
	gal = PUBKEY(al)
	ta = MAC[forgeable](HASH(psk, x), CONCAT(ma, gal))
]
Alice -> Carol: ma, ta
principal Dave[
	knows private psk, dl
	generates y, md
	gdl = PUBKEY(dl)
	td = MAC(HASH(psk, y), CONCAT(md, gdl))
]
Dave -> Bob: [gdl], [y], md, td
principal Bob[
	knows private psk
	_ = ASSERT(MAC(HASH(psk, y), CONCAT(md, gdl)), td)?
]
queries[
	authentication? Dave -> Bob: md
]

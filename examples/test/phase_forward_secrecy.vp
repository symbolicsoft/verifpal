attacker[active]

principal Alice[
	knows private a
	ga = PUBKEY(a)
]

principal Bob[
	knows private b
	gb = PUBKEY(b)
]

Alice -> Bob: [ga]
Bob -> Alice: [gb]

principal Alice[
	generates ea
	gea = PUBKEY(ea)
]

principal Bob[
	generates eb
	geb = PUBKEY(eb)
]

Alice -> Bob: [gea]
Bob -> Alice: [geb]

principal Alice[
	eph_shared_a = DH_KEX(geb, ea)
	session_key_a = HASH(eph_shared_a)
	generates secret_msg
	encrypted = AEAD_ENC(session_key_a, secret_msg, nil)
]

Alice -> Bob: encrypted

principal Bob[
	eph_shared_b = DH_KEX(gea, eb)
	session_key_b = HASH(eph_shared_b)
	decrypted = AEAD_DEC(session_key_b, encrypted, nil)?
]

phase[1]

principal Alice[leaks a]
principal Bob[leaks b]

queries[
	confidentiality? secret_msg
	authentication? Alice -> Bob: encrypted
	equivalence? secret_msg, decrypted
]

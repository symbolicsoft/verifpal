// Expected: c0 at both session counts. Guarding x prevents the key and
// nonce alignment needed to make the decryption disclose secret.
attacker[active]
principal Alice[
	knows public b
	generates x
]
Alice -> Bob: [x]
principal Bob[
	knows public b
	knows private secret
	generates a
	leaks a
]
principal Alice[
	generates y
]
Alice -> Bob: y
principal Bob[
	response = AEAD_DEC(DH_KEX(PUBKEY(a), b), HASH(b), AEAD_ENC(DH_KEX(PUBKEY(x), y), HASH(x), secret, nil), nil)
]
Bob -> Carol: response
principal Carol[]
queries[
	confidentiality? secret
]

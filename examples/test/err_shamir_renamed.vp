// Expected: error — the old SHAMIR_SPLIT spelling is refused with a diagnostic
// // that names THRESHOLD_SPLIT and the bracketed threshold it now carries.

attacker[passive]

principal Dealer[
	generates k
	s1, s2, s3 = SHAMIR_SPLIT(k)
	_ = HASH(s1, s2, s3)
]

queries[
	confidentiality? k
]

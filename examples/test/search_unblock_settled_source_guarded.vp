//
// Expected: a0 at one session, a1 at two.
//
// search_unblock_settled_source.vp with both public keys guarded. Without a
// man in the middle Alice accepts only Bob's own c14 at one session. At two,
// the long-term keys give both sessions the same Diffie-Hellman key, so Bob's
// c14 from the other session is accepted as a replay.
attacker[active]

principal Alice[
	knows private a
	ga = PUBKEY(a)
]
principal Bob[
	knows private b
	gb = PUBKEY(b)
]
Alice -> Bob: [ga]
Bob -> Alice: [gb]
principal Alice[
	ssa = DH_KEX(gb, a)
	generates n1
	t2 = MAC(ssa, n1)
]
Alice -> Bob: [n1], t2
principal Bob[
	ssb = DH_KEX(ga, b)
	_ = ASSERT(MAC(ssb, n1), t2)?
	generates n3
	t4 = MAC(ssb, n3)
]
Bob -> Alice: n3, t4
principal Alice[
	_ = ASSERT(MAC(ssa, n3), t4)?
	generates n7
	t8 = MAC(ssa, n7)
	generates n11
	h12 = HASH(n11, t2)
]
Alice -> Bob: n7, t8, h12
principal Bob[
	_ = ASSERT(MAC(ssb, n7), t8)?
	generates n13
	generates nn15
	c14 = AEAD_ENC(ssb, nn15, n13, nil)
	generates n16
	leaks n16
	h17 = HASH(n16, n3)
]
Bob -> Alice: nn15, c14, [h17]
principal Alice[
	d20 = AEAD_DEC(ssa, nn15, c14, nil)?
]
queries[
	authentication? Bob -> Alice: c14
]

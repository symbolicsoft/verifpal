//
// Sanity error: a model whose only block is a phase declares no principals, so
// there is no session to run. Both attacker kinds used to seed their first
// phase from principal_states[0] and abort the process on the empty slice --
// under `verifpal lsp` that took the server down with it.
attacker[active]

phase[1]

queries[
]

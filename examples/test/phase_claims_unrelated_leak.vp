//
// Expected: f0e0 at one session and at two.
//
// phase_claims_after_compromise.vp with Carol's key also leaked in phase 1.
// Both scenarios are then corrupt from phase 1, and each answers at phase 1
// for what it held at the end of phase 0, when Alice had computed neither x
// nor y. Claims were once reinstated for every run at any phase where no
// scenario was honest, so an unrelated leak gave Alice@2 back the claims her
// own peer's compromise had removed, and this model failed both queries.
attacker[passive]

principal Carol[
	generates c
	gc = PUBKEY(c)
]

principal Bob[
	knows private b
	gb = PUBKEY(b)
]

Carol -> Alice: [gc]

Bob -> Alice: [gb]

principal Alice[
	knows public gpeer
]

phase[1]

principal Bob[
	leaks b
]

principal Carol[
	leaks c
]

principal Alice[
	x = HASH(gpeer)
	y = HASH(gc)
	z = HASH(x)
]

scenarios[
	Alice[gpeer = gc]
	Alice[gpeer = gb]
]

queries[
	freshness? x
	equivalence? x, y
]

// Holding the encapsulation key and the ciphertext is not holding the shared
// secret. Bob's key is pre-authenticated, so the attacker cannot substitute its
// own; it sees the ciphertext on the wire and owns a decapsulation key of its
// own, and still cannot open Alice's encapsulation. This pins the rule that lets
// an attacker decapsulate from firing on a key it does not hold.

attacker[active]

principal Bob[
	knows private dkb
	ekb = PUBKEY(dkb)
]

Bob -> Alice: [ekb]

principal Alice[
	knows private m
	knows private dka
	generates r
	eka = PUBKEY(dka)
	ss, ct = KEM_ENCAP(ekb, r)
	e = AEAD_ENC(ss, m, nil)
	leaks dka
	leaks eka
]

Alice -> Bob: ct, e

principal Bob[
	ssb = KEM_DECAP(dkb, ct)
	d = AEAD_DEC(ssb, e, nil)?
]

queries[
	confidentiality? dkb
	confidentiality? ss
]

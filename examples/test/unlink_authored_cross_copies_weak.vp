//
// Expected: u1 at one session and at two.
//
// unlink_authored_cross_copies.vp with Bob's ob weak: it reveals s1 on the
// wire, so replacing Alice's copy of b with PUBKEY(nil) alone turns her oa
// into an oracle for s2, and the attacker rebuilds a and b, both on the wire.
// The weak route on ob had hidden the shaped key the deducer needs to open
// oa, so weakening ob lost the attack.
// unlink_authored_cross_copies_weak_guarded.vp is the counterweight.
attacker[active]
principal Alice[
	knows private s1, s2
	generates n1
	a = HASH(s1, s2, n1)
]
Alice -> Bob: n1, a
principal Bob[
	knows private s1, s2
	generates n2
	b = HASH(s1, s2, n2)
	ob = PKE_ENC[weak](a, s1)
]
Bob -> Alice: n2, b, ob
principal Alice[
	oa = PKE_ENC(b, s2)
]
Alice -> Bob: oa
principal Bob[
	_ = HASH(oa)
]
queries[
	unlinkability? a, b
]

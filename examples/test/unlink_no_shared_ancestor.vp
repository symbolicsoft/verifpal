attacker[passive]

principal Alice[
	knows public c1
	generates sa
	toka = HASH(sa, c1)
	leaks sa
]

principal Bob[
	knows public c2
	generates sb
	tokb = HASH(sb, c2)
	leaks sb
]

Alice -> Charlie: toka
Bob -> Charlie: tokb

principal Charlie[
	_ = HASH(toka)
	_ = HASH(tokb)
]

queries[
	unlinkability? toka, tokb
]

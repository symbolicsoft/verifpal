attacker[active]

principal Alice[
	knows private ia
	gia = PUBKEY(ia)
]

principal Bob[
	knows private ib, sb
	gib = PUBKEY(ib)
	gsb = PUBKEY(sb)
	sbsig = SIGN(ib, gsb)
]

Bob -> Alice: [gib], gsb, sbsig

principal Alice[
	generates ea, m
	gea = PUBKEY(ea)
	_ = SIGNVERIF(gib, gsb, sbsig)
	master = HASH(DH_KEX(gsb, ia), DH_KEX(gib, ea), DH_KEX(gsb, ea))
	k = HKDF(master, nil, nil)
	c = AEAD_ENC(k, m, nil)
]

Alice -> Bob: [gia], gea, c

phase[1]

principal Alice[leaks ia]
principal Bob[leaks ib]

queries[
	confidentiality? m
]

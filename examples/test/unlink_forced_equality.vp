// Expected: u1 at one session and at two.
//
// Bob tags two independently generated nonces under a key nobody else holds.
// The attacker replaces both nonces with nil, and Bob's two tags come out
// equal: MAC(ufe_k, nil) twice. The attacker built neither tag, and they are
// equal only because one key made both: under two keys the same input gives
// two different tags. That equality tells one key holder from two, which is
// the RFID tracking attack (unlink_rfid_mac_tag.vp). The judge once required
// an observed equality to be an equality of the honest values as well, and
// reported u0. unlink_forced_equality_two_keys.vp tags under two keys and
// holds.

attacker[active]

principal Alice[
	generates ufe_na
]

principal Carol[
	generates ufe_nc
]

Alice -> Bob: ufe_na
Carol -> Bob: ufe_nc

principal Bob[
	knows private ufe_k
	ufe_p = MAC(ufe_k, ufe_na)
	ufe_q = MAC(ufe_k, ufe_nc)
]

Bob -> Dave: ufe_p, ufe_q

principal Dave[
	_ = HASH(ufe_p)
	_ = HASH(ufe_q)
]

queries[
	unlinkability? ufe_p, ufe_q
]

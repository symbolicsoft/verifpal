//
// Expected: a0. A leaked signing key does not supply the secret message ad.
// Constructing the signature Bob accepts requires both arguments.

attacker[active]

principal Alice[
	knows private a
	leaks a
	ga = PUBKEY(a)
	knows private ad
	sig = SIGN(a, ad)
]

Alice -> Bob: [ga], sig

principal Bob[
	knows private ad
	_ = SIGNVERIF(ga, ad, sig)?
	generates s
	out = HASH(s, ad)
]

Bob -> Alice: out

queries[
	authentication? Alice -> Bob: sig
]

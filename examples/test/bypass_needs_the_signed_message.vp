//
// Expected: a0 — the same rule for SIGNVERIF, whose rewrite pins the message.
//
// Alice's signing key is leaked, so the attacker can sign. What it cannot do
// is sign `ad`: producing SIGN(a, ad) needs the message as well as the key,
// and `ad` is a secret Alice and Bob share and never send. Bob halts on every
// substitution of `sig`.
//
// A leaked signing key is usually total impersonation, which is why this had
// to be checked rather than assumed: the bypass is sound exactly when the
// attacker can build a term the check accepts, and here it cannot.
attacker[active]

principal Alice[
	knows private a
	leaks a
	ga = PUBKEY(a)
	knows private ad
	sig = SIGN(a, ad)
]

Alice -> Bob: [ga], sig

principal Bob[
	knows private ad
	_ = SIGNVERIF(ga, ad, sig)?
	generates s
	out = HASH(s, ad)
]

Bob -> Alice: out

queries[
	authentication? Alice -> Bob: sig
]

// Expected: a0 at one session and at two.
//
// history_incompatible_knowledge.vp with a phase boundary and a phase-1 block
// that discloses nothing. The attacker learns hik_na only in the execution
// where it replaced hik_gb, and in that execution Bob cannot recover hik_n,
// so hik_c cannot be forged in any one execution. The phase boundary must not
// change that: the derivability proof for a slot delivered in phase 0 is made
// against the phase-0 archive, and that archive has to pass through the same
// history-coherence restriction as the current knowledge does. This is the
// execution_agrees route of the rule; history_phase_archive.vp is the
// forwards route.

attacker[active]

principal Alice[
	knows private hik_msg
	knows public hik_label
	generates hik_a
	generates hik_na
	hik_ga = PUBKEY(hik_a)
]

principal Bob[
	generates hik_b
	hik_gb = PUBKEY(hik_b)
]

principal Charlie[
	knows public hik_label
]

Alice -> Bob: [hik_ga]
Bob -> Alice: hik_gb

principal Alice[
	hik_ka = DH_KEX(hik_gb, hik_a)
	generates n_hik_leak
	hik_leak = AEAD_ENC(hik_ka, n_hik_leak, hik_na, hik_label)
	hik_e = ENC(hik_ka, hik_na)
	generates n_hik_c
	hik_c = AEAD_ENC(hik_na, n_hik_c, hik_msg, nil)
]

Alice -> Charlie: n_hik_leak, hik_leak
Alice -> Bob: hik_e, n_hik_c, hik_c

principal Bob[
	hik_kb = DH_KEX(hik_ga, hik_b)
	hik_n = DEC(hik_kb, hik_e)
	hik_p = AEAD_DEC(hik_n, n_hik_c, hik_c, nil)?
	hik_h = HASH(hik_p)
]

phase[1]

principal Bob[
	hik_hh = HASH(hik_h)
]

queries[
	authentication? Alice -> Bob: hik_c
]

//
// Expected: c0 at one session and at two.
//
// cap_forgeable_echoed_reuse_member.vp with a decrypting Bob, and with Alice's
// e1 leaving her only in phase 1, sealed to Bob. The attacker's minted e1,
// echoed by Bob in phase 0, is no reuse partner for e2: with e1 unforgeable the
// install it rests on could be built only from a ciphertext sent after Bob
// received.
attacker[active]

principal Bob[
	knows private skb
	gb = PUBKEY(skb)
]

Bob -> Alice: [gb]

principal Alice[
	knows private k
	knows public ad
	generates n, m1, m2
	e1 = AEAD_ENC[forgeable](k, n, m1, ad)
	e2 = AEAD_ENC(k, n, m2, ad)
	se = PKE_ENC(gb, e1)
	leaks m1
]

Alice -> Bob: n, e2

Bob -> Carol: [gb]

principal Carol[
	generates mc
	y = PKE_ENC(gb, mc)
]

Carol -> Bob: y

principal Bob[
	d = PKE_DEC(skb, y)
]

Bob -> Dave: d

principal Dave[
	_ = HASH(d)
]

phase[1]

Alice -> Dave: se

principal Dave[
	_ = HASH(se)
]

queries[
	confidentiality? m2
]

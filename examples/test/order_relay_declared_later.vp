//
// Expected: a1 at one session and at two.
//
// order_relay_declared_first.vp with Hop's `knows public label` moved from
// its own leading block into Alice's, so Alice is declared first. The model
// is the same protocol and must get the same codes, for the same reasons:
// at one session the attacker bypasses Relay, and at two it replays the
// body Relay#2 sent into Bob.
attacker[active]

principal Alice[
	knows private k
	knows public label
	body = MAC(k, label)
]

Alice -> Hop: body

principal Hop[
	_ = HASH(body)
]

Hop -> Relay: body

principal Relay[
	_ = HASH(body)
]

Relay -> Bob: body

principal Bob[
	knows private k
	knows public label
	_ = ASSERT(body, MAC(k, label))?
]

queries[
	authentication? Relay -> Bob: body
]

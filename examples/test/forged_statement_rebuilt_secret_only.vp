//
// Expected: c1 at one session and at two.
//
// forged_statement_rebuilt.vp asking only about secret. The attack is the
// same: req := CONCAT(c_tag, PUBKEY(nil), nonce) swaps the key and keeps the
// verifier's nonce, the signer seals its signature under a key the attacker
// computes, and the attacker re-seals it toward the verifier, which rebuilds
// the signed statement from its own nonce and releases secret.
//
// The search reached that request only from the Targeted goal of the other
// query, confidentiality? sig: its free positions were filled either with the
// attacker's key and nil elsewhere, or with the honest values the attacker
// holds, the honest key included, never with the attacker's key beside the
// held nonce. Free positions are now also offered that combination.
// forged_statement_bound_key_secret_only.vp is the counterweight.
attacker[active]

principal Signer[
	knows private ssk
	knows public c_ad
	knows public c_tag
	knows public c_stmt
	generates y
	gs = PUBKEY(ssk)
	gy = PUBKEY(y)
]

Signer -> Verifier: [gs]

principal Verifier[
	knows public c_ad
	knows public c_tag
	knows public c_stmt
	generates x
	generates nonce
	generates secret
	gx = PUBKEY(x)
	req = CONCAT(c_tag, gx, nonce)
]

Verifier -> Signer: req

principal Signer[
	tag_s, gx_s, nonce_s = SPLIT(req)?
	_ = ASSERT(tag_s, c_tag)?
	stmt = CONCAT(c_stmt, gs, nonce_s)
	sig = SIGN(ssk, stmt)
	k = HKDF(nil, DH_KEX(gx_s, y), nil)
	generates n_env
	env = AEAD_ENC(k, n_env, CONCAT(gs, sig), c_ad)
]

Signer -> Verifier: gy, n_env, env

principal Verifier[
	kv = HKDF(nil, DH_KEX(gy, x), nil)
	d = AEAD_DEC(kv, n_env, env, c_ad)?
	iss_v, sig_v = SPLIT(d)?
	_ = ASSERT(iss_v, gs)?
	stmt_v = CONCAT(c_stmt, iss_v, nonce)
	_ = SIGNVERIF(iss_v, stmt_v, sig_v)?
	generates n_out
	out = AEAD_ENC(kv, n_out, secret, c_ad)
]

Verifier -> Signer: n_out, out

queries[
	confidentiality? secret
]

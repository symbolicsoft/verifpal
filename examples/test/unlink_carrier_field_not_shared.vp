//
// Expected: u0 at one session and at two.
//
// unlink_forced_key_carries_no_secret.vp read through a carrier tuple. Bob seals
// two public constants under a key derived from a seed only he can open, and the
// seed, a second ciphertext and a public nonce all travel in one tuple. The
// attacker can force the seed to a value it knows by handing Bob the other
// ciphertext, but a key it made up is not a secret the two tokens share, so the
// pair is not linked: that is what the flat version of this model already says.
//
// A witness has to carry a secret leaf the two queried values honestly share,
// and the leaves were read off the unreduced resolution of each value. Through a
// carrier the unreduced form mentions every field of the tuple, including the
// nonce the projection throws away, so that nonce counted as shared and the
// forced key passed the test. Resolving projections before reading the leaves
// drops the discarded fields while leaving every other construction unreduced,
// which is what unlink_blind_active.vp needs: a blinding factor is absent from
// the reduct and still genuinely shared.
attacker[active]

principal Alice[
	generates seed, pub_n
	knows public c1, c2
]

principal Bob[
	knows private b
	gb = PUBKEY(b)
	generates n1, n2
]

Bob -> Alice: [gb]

principal Alice[
	c = PKE_ENC(gb, seed)
	pn = PKE_ENC(gb, pub_n)
	bundle = CONCAT(pub_n, pn, c)
]

Alice -> Bob: bundle

principal Bob[
	knows public c1, c2
	pub_n_b, pn_b, c_b = SPLIT(bundle)?
	seed_b = PKE_DEC(b, c_b)
	_ = PKE_DEC(b, pn_b)
	k = HASH(seed_b)
	e1 = AEAD_ENC(k, n1, c1, nil)
	e2 = AEAD_ENC(k, n2, c2, nil)
]

Bob -> Alice: n1, n2, e1, e2

principal Alice[
	_ = HASH(e1, e2)
]

queries[
	unlinkability? e1, e2
]

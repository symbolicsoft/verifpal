attacker[active]

principal Alice[
	generates a
	ga = PUBKEY(a)
]

principal Bob[
	generates b
	gb = PUBKEY(b)
]

Alice -> Bob: [ga]
Bob -> Alice: [gb]

principal Alice[
	generates m
	e = PKE_ENC(gb, m)
	h = MAC(DH_KEX(gb, a), e)
]

Alice -> Bob: e, h

principal Bob[
	_ = ASSERT(MAC(DH_KEX(ga, b), e), h)
	d = PKE_DEC(b, e)
]

queries[
	confidentiality? m
	authentication? Alice -> Bob: e
]

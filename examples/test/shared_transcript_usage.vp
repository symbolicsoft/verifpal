// Expected: a0 at both session counts. Bob uses the guarded value after an
// unrelated private transcript. Searching that transcript for a use must visit
// its shared definitions once rather than expand three copies at each layer.

attacker[passive]

principal Alice[
	generates x
]

Alice -> Bob: [x]

principal Bob[
	knows private seed
	h0 = HASH(seed, seed, seed)
	h1 = HASH(h0, h0, h0)
	h2 = HASH(h1, h1, h1)
	h3 = HASH(h2, h2, h2)
	h4 = HASH(h3, h3, h3)
	h5 = HASH(h4, h4, h4)
	h6 = HASH(h5, h5, h5)
	h7 = HASH(h6, h6, h6)
	h8 = HASH(h7, h7, h7)
	h9 = HASH(h8, h8, h8)
	h10 = HASH(h9, h9, h9)
	h11 = HASH(h10, h10, h10)
	h12 = HASH(h11, h11, h11)
	h13 = HASH(h12, h12, h12)
	h14 = HASH(h13, h13, h13)
	h15 = HASH(h14, h14, h14)
	h16 = HASH(h15, h15, h15)
	h17 = HASH(h16, h16, h16)
	h18 = HASH(h17, h17, h17)
	h19 = HASH(h18, h18, h18)
	h20 = HASH(h19, h19, h19)
	h21 = HASH(h20, h20, h20)
	used = HASH(x)
]

queries[
	authentication? Alice -> Bob: x
]

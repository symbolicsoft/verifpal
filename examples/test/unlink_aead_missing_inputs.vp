// Expected: u0u0c0c1 at both session counts. A leaked key is insufficient to
// test these ciphertexts: the first pair withholds its nonces and the second
// withholds its associated data. No identifying decryption is executable,
// but the permutation's decompose rule still reveals m2 from the key and
// nonce alone. Missing associated data blocks authentication, not that
// plaintext recovery. The second pair's independent plaintexts reveal no
// common origin, and neither pair can be reconstructed in full.
attacker[passive]

principal Alice[
	knows private k, m1, m2, m3, ad
	leaks k
	generates n1, n2, n3, n4
	c1 = AEAD_ENC(k, n1, m1, nil)
	c2 = AEAD_ENC(k, n2, m1, nil)
	c3 = AEAD_ENC(k, n3, m2, ad)
	c4 = AEAD_ENC(k, n4, m3, ad)
]

Alice -> Bob: c1, c2, n3, n4, c3, c4

principal Bob[]

queries[
	unlinkability? c1, c2
	unlinkability? c3, c4
	confidentiality? m1
	confidentiality? m2
]

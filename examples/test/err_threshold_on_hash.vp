// Expected: error — only a primitive that shares a secret takes a threshold.

attacker[passive]

principal Alice[
	generates m
	h = HASH[2](m)
]

Alice -> Bob: h

principal Bob[
	_ = HASH(h)
]

queries[
	confidentiality? m
]

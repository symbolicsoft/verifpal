// Sanity error: core primitives carry no cryptographic guarantee to weaken.
attacker[active]

principal Alice[
	knows private m
	knows private n
	c = CONCAT[weak](m, n)
]

Alice -> Bob: c

principal Bob[
	_ = HASH(c)
]

queries[
	confidentiality? m
]

// Expected: u1 at one session and at two.
//
// search_unlink_nested_requirements.vp with both salts public. The attacker
// rebuilds both hashes from the signatures it observed without any oracle,
// and only m is missing: replacing dm with em makes Mary leak it, and
// SIGNVERIF then confirms both signatures over the same message.
attacker[active]
principal Alice[
	knows private km, ka, kb, skone, sktwo
	generates m
	knows public saltone, salttwo
	sigone = SIGN(skone, m)
	sigtwo = SIGN(sktwo, m)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	hone = HASH(sigone, saltone)
	htwo = HASH(sigtwo, salttwo)
	witness = HASH(m, saltone, salttwo)
	em = ENC(km, m)
	ea = ENC(ka, saltone)
	eb = ENC(kb, salttwo)
	dm = ENC(km, nil)
	da = ENC(ka, nil)
	db = ENC(kb, nil)
]
Alice -> Dave: em, ea, eb, sigone, sigtwo, pkone, pktwo, hone, htwo
Alice -> Mary: dm
Alice -> Bob: da
Alice -> Carol: db
principal Mary[
	knows private km
	rm = DEC(km, dm)
	leaks rm
]
principal Bob[
	knows private ka
	ra = DEC(ka, da)
	leaks ra
]
principal Carol[
	knows private kb
	rb = DEC(kb, db)
	leaks rb
]
principal Dave[
	_ = HASH(em, ea, eb, sigone, sigtwo)
	_ = HASH(pkone, pktwo, hone, htwo)
]
queries[
	unlinkability? hone, htwo
]

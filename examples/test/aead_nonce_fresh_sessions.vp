//
// Expected: c0 at --sessions 1 and at 2 — the counterweight to
// aead_nonce_reuse_sessions.vp. The nonce is generated per session and sent
// in the clear, so the two sessions' ciphertexts are under different nonces
// and nothing pairs. Naming a nonce changes nothing by itself; reusing one
// does.

attacker[passive]

principal Alice[
	knows private k
	knows public ad
	generates n, m
	e = AEAD_ENC(k, n, m, ad)
]

Alice -> Bob: n, e

principal Bob[
	knows private k
	knows public ad
	d = AEAD_DEC(k, n, e, ad)?
]

queries[
	confidentiality? m
]

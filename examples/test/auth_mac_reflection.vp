//
// Expected: a0 at one session, a1 at two.
//
// Symmetric challenge-response with no direction in the MAC: Bob answers
// Alice's challenge with MAC(k, na) and expects MAC(k, nb) back. At two
// sessions the attacker opens Bob#2 with Bob's own nb as its challenge, and
// Bob#2's answer MAC(k, nb) is exactly what Bob expects from Alice. Alice
// never sends it: the attacker makes her check fail, or never lets her run,
// so Bob accepts a response nobody but Bob#2 computed. The judge once excused
// a delivered value equal to the recipient's honest one when the sender had
// sent nothing, and the search never delivered an oracle's output into a
// receive left waiting by a halted sender. At one session Bob's only run
// computes MAC(k, na) before anyone sees nb, so there is no oracle: a0.
// auth_mac_reflection_bound.vp is the counterweight.
attacker[active]

principal Alice[
	knows private k
	generates na
]

Alice -> Bob: na

principal Bob[
	knows private k
	generates nb
	tb = MAC(k, na)
]

Bob -> Alice: nb, tb

principal Alice[
	_ = ASSERT(MAC(k, na), tb)?
	ta = MAC(k, nb)
]

Alice -> Bob: ta

principal Bob[
	_ = ASSERT(MAC(k, nb), ta)?
]

queries[
	authentication? Alice -> Bob: ta
]

//
// Expected: c0 at one session and at two.
//
// solver_revealed_oracle_keyed_tuple.vp with the share guarded. Bob still
// decrypts ca from a tuple the attacker sends, but seals s under a key
// derived from Carol's share, which the attacker cannot compute.
attacker[active]

principal Alice[
	knows private kab
	generates s
	ca = ENC(kab, s)
]

Alice -> Dave: [ca]

principal Dave[
	knows private kab
	sd = DEC(kab, ca)
]

principal Carol[
	knows private kab
	knows public c_t
	generates mc, x
	gx = PUBKEY(x)
	xc = CONCAT(ENC(kab, mc), c_t)
]

Carol -> Bob: [gx], xc

principal Bob[
	knows private kab
	knows public ad
	generates y, n
	gy = PUBKEY(y)
	c1, t1 = SPLIT(xc)
	m = DEC(kab, c1)
	r = HKDF(nil, DH_KEX(gx, y), nil)
	e = AEAD_ENC(r, n, m, ad)
]

Bob -> Carol: gy, n, e

queries[
	confidentiality? s
]

// Expected: c0 at one and two sessions. Bob's guarded message fixes what
// he can unblind; replaying alt cannot obtain a signature over other.

attacker[active]

principal Alice[
	knows private sk, r
	knows public other
	generates m
	sig = SIGN(sk, BLIND(r, m))
	alt = SIGN(sk, BLIND(r, other))
]

Alice -> Carol: alt

principal Carol[
]

Alice -> Bob: [m], sig

principal Bob[
	knows private r, sk
	knows public other
	unblinded = UNBLIND(r, m, sig)
	secret = SIGN(sk, other)
]

Bob -> Carol: unblinded

queries[
	confidentiality? secret
]

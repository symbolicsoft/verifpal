//
// Expected: c0 at one session and at two.
//
// Bob publishes a KEM encapsulation key, Alice encapsulates to it, and Bob
// seals his reply under the shared secret. Swapping ek for the attacker's
// own key gives up that secret, but in that execution Alice's ciphertext is
// the one she built for the attacker's key, so Bob's reply is sealed under a
// secret the attacker holds and the reply it wants to open never existed.
//
// The reply read off the wire belongs to the execution where ek is honest;
// the secret belongs to the execution where ek is swapped. Knowledge is
// global and monotone, so the closure could pair them and report a
// disclosure no single execution produces. Every learned value therefore
// carries the executions that produce it, and the pair has none in common.
attacker[active]
principal Bob[
	generates dk
	ek = PUBKEY(dk)
	knows private reply
]
Bob -> Alice: ek
principal Alice[
	generates r
	ss, ct = KEM_ENCAP(ek, r)
	_ = HASH(ss)
]
Alice -> Bob: [ct]
principal Bob[
	ssb = KEM_DECAP(dk, ct)
	generates nb
	eb = AEAD_ENC(ssb, nb, reply, nil)
]
Bob -> Alice: nb, eb
principal Alice[
	_ = HASH(nb, eb)
]
queries[
	confidentiality? reply
]

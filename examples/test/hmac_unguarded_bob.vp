attacker[active]

principal Alice[
	knows private a
	a_public = PUBKEY(a)
]
principal Bob[
	knows private b
	b_public = PUBKEY(b)
]

Alice -> Bob   : [a_public]
Bob   -> Alice : b_public

principal Alice[
	generates plaintext
	ss         = DH_KEX(b_public, a)
	key        = HASH(ss)
	ciphertext = ENC(key, plaintext)
	tag        = MAC(key, ciphertext)
]

Alice -> Bob : ciphertext, tag

principal Bob[
	ss_        = DH_KEX(a_public, b)
	key_       = HASH(ss_)
	_          = ASSERT(tag, MAC(key_, ciphertext))?
	plaintext_ = DEC(key_, ciphertext)
]

queries[
	confidentiality? plaintext
	authentication? Alice -> Bob : ciphertext
]

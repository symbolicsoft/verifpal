// Expected: c0 at both session counts. The guarded first exponent is fresh
// and cannot be replaced with either a or b. Neither commutative ordering
// lets Bob's oracle emit the queried tag.
attacker[active]

principal Alice[
	knows public b
	generates x
]

Alice -> Bob: [x]

principal Bob[
	knows public b
	generates a
	leaks a
]

principal Alice[
	generates y
]

Alice -> Bob: y

principal Bob[
	knows private k
	tag = MAC(k, DH_KEX(PUBKEY(x), y))
	secret = MAC(k, DH_KEX(PUBKEY(a), b))
]

Bob -> Carol: tag

principal Carol[]

queries[
	confidentiality? secret
]

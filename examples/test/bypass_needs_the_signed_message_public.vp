//
// Expected: a1 — the counterweight to bypass_needs_the_signed_message.vp.
//
// The same protocol with the signed message public instead of shared-secret.
// The attacker holds the signing key and can now also build the message, so
// SIGN(a, ad) really is constructible and Bob really does accept a signature
// Alice never produced. Without this, the a0 of the other model could equally
// have been "never bypass a signature check".

attacker[active]

principal Alice[
	knows private a
	leaks a
	ga = PUBKEY(a)
	knows public ad
	sig = SIGN(a, ad)
]

Alice -> Bob: [ga], sig

principal Bob[
	knows public ad
	_ = SIGNVERIF(ga, ad, sig)?
	generates s
	out = HASH(s, ad)
]

Bob -> Alice: out

queries[
	authentication? Alice -> Bob: sig
]

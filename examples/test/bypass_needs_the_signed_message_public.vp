//
// Expected: a0. The attacker can reconstruct the honest signature from the
// leaked key and public message. The guarded verification key and fixed
// message leave no different accepted signature. The wire-message companion
// permits a forgery by changing the message too.

attacker[active]

principal Alice[
	knows private a
	leaks a
	ga = PUBKEY(a)
	knows public ad
	sig = SIGN(a, ad)
]

Alice -> Bob: [ga], sig

principal Bob[
	knows public ad
	_ = SIGNVERIF(ga, ad, sig)?
	generates s
	out = HASH(s, ad)
]

Bob -> Alice: out

queries[
	authentication? Alice -> Bob: sig
]

// A long-term KEM key buys no forward secrecy: compromising it after the fact
// lets the attacker decapsulate a ciphertext it recorded earlier, even though
// no principal ever decapsulated that particular ciphertext.

attacker[active]

principal Bob[
	knows private dkb
	ekb = PUBKEY(dkb)
]

Bob -> Alice: [ekb]

principal Alice[
	knows private m1, m2
	generates r1, r2
	ss1, ct1 = KEM_ENCAP(ekb, r1)
	ss2, ct2 = KEM_ENCAP(ekb, r2)
	e1 = AEAD_ENC(ss1, m1, nil)
	e2 = AEAD_ENC(ss2, m2, nil)
]

Alice -> Bob: ct1, e1, ct2, e2

principal Bob[
	ssb1 = KEM_DECAP(dkb, ct1)
	d1 = AEAD_DEC(ssb1, e1, nil)?
]

phase[1]

principal Bob[leaks dkb]

queries[
	confidentiality? m1
	confidentiality? m2
]

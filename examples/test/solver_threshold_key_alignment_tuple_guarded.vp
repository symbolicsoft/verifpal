//
// Expected: c0 at one session and at two.
//
// solver_threshold_key_alignment_tuple.vp with the tuple guarded: Bob signs
// Alice's fresh x under a key no partial signature was made with, so the
// partials never combine into wrapping.
attacker[active]

principal Dealer[
	knows private root
	knows public a, b
	key = HASH(root, DH_KEX(PUBKEY(a), b))
	s1, s2 = THRESHOLD_SPLIT[2](key)
	generates n1, n2
	cl = CONCAT(PUBKEY(n1), PUBKEY(n2))
	p1 = THRESHOLD_SIGN(s1, n1, cl, b)
	p2 = THRESHOLD_SIGN(s2, n2, cl, b)
]

Dealer -> Carol: p1, p2

principal Alice[
	generates x, y
	xy = CONCAT(x, y)
]

Alice -> Bob: [xy]

principal Bob[
	x_b, y_b = SPLIT(xy)
	knows private root
	generates secret
	requested = HASH(root, DH_KEX(PUBKEY(x_b), y_b))
	wrapping = SIGN(requested, x_b)
	sealed = ENC(wrapping, secret)
]

Bob -> Carol: sealed

principal Carol[
]

queries[
	confidentiality? secret
]

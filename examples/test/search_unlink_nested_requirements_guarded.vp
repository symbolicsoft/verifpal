// Expected: u0 at one session and at two.
//
// search_unlink_nested_requirements.vp with dm guarded. Mary decrypts only
// Alice's ENC(km, nil), so m is never disclosed: the attacker still learns
// both salts and rebuilds both hashes from the signatures it observed, but it
// cannot run SIGNVERIF on either signature, and two signatures under
// different keys show nothing in common without the message they sign.
attacker[active]
principal Alice[
	knows private km, ka, kb, skone, sktwo
	generates m, saltone, salttwo
	sigone = SIGN(skone, m)
	sigtwo = SIGN(sktwo, m)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	hone = HASH(sigone, saltone)
	htwo = HASH(sigtwo, salttwo)
	witness = HASH(m, saltone, salttwo)
	em = ENC(km, m)
	ea = ENC(ka, saltone)
	eb = ENC(kb, salttwo)
	dm = ENC(km, nil)
	da = ENC(ka, nil)
	db = ENC(kb, nil)
]
Alice -> Dave: em, ea, eb, sigone, sigtwo, pkone, pktwo, hone, htwo
Alice -> Mary: [dm]
Alice -> Bob: da
Alice -> Carol: db
principal Mary[
	knows private km
	rm = DEC(km, dm)
	leaks rm
]
principal Bob[
	knows private ka
	ra = DEC(ka, da)
	leaks ra
]
principal Carol[
	knows private kb
	rb = DEC(kb, db)
	leaks rb
]
principal Dave[
	_ = HASH(em, ea, eb, sigone, sigtwo)
	_ = HASH(pkone, pktwo, hone, htwo)
]
queries[
	unlinkability? hone, htwo
]

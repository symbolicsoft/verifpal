// Expected: c1 at both session counts. Opening the public-keyed carrier
// must preserve the causally valid second alignment of the shared key.
attacker[active]

principal Alice[
	knows public b, wrapping
	generates x
]

Alice -> Bob: x

principal Bob[
	knows public b, wrapping
	generates a
	leaks a
]

principal Alice[
	generates y
]

Alice -> Bob: y

principal Bob[
	knows private k
	tag = ENC(wrapping, MAC(k, DH_KEX(PUBKEY(x), y)))
	secret = MAC(k, DH_KEX(PUBKEY(a), b))
]

Bob -> Carol: tag

principal Carol[]

queries[
	confidentiality? secret
]

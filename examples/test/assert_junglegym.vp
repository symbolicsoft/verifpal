attacker[active]

principal Alice[
	knows private Ka
]

principal Bob[
	knows private Ka
	knows private Kb

	generates Kab

	Kab_bob = ENC(Kb, Kab)
	tag = HASH(Kab, Kab_bob)
	enctag = ENC(Ka, tag)
	Kab_alice = ENC(Ka, Kab)
	Kab_bob_alice = ENC(Ka, Kab_bob)
]

Bob -> Alice: enctag, Kab_alice, Kab_bob_alice

principal Alice[
	tag_ = DEC(Ka, enctag)
	Kab_ = DEC(Ka, Kab_alice)
	Kab_bob_ = DEC(Ka, Kab_bob_alice)

	_ = ASSERT(tag_, HASH(Kab_, Kab_bob_))?
	leaks Kab_bob_
]

queries[
	confidentiality? Kab
]

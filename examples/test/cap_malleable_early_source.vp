// Expected: a1a1 at one and two sessions. Disclosing the malleable source
// before Bob accepts early permits a reshape for that first delivery too.

attacker[active]

principal Alice[
	knows private k
	knows public lo, hi
	early = ENC(k, CONCAT(lo, lo))
	late = ENC[malleable](k, CONCAT(hi, hi))
]

Alice -> Bob: early

Alice -> Eve: late

principal Eve[
]

principal Bob[
	knows private k
	x, y = SPLIT(DEC(k, early))?
	ack = MAC(k, x)
]

Bob -> Alice: [ack]

principal Alice[
	checked = ASSERT(ack, MAC(k, lo))?
]

Alice -> Bob: late

principal Bob[
	a, b = SPLIT(DEC(k, late))?
	receipt = MAC(k, a)
]

queries[
	authentication? Alice -> Bob: early
	authentication? Alice -> Bob: late
]

attacker[passive]

principal Alice[
	knows public m
	generates r
	b = BLIND(r, m)
]

Alice -> Bob: b

principal Bob[
	generates sk
	gb = PUBKEY(sk)
	sb = SIGN(sk, b)
]

Bob -> Alice: gb, sb

principal Alice[
	sig = UNBLIND(r, m, sb)
	leaks sig
]

queries[
	unlinkability? b, sig
]

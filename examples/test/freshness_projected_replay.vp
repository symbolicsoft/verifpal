//
// Expected: f0a0 at one session, f1a1 at two.
//
// freshness_replayed_across_sessions.vp with the nonce inside a signed bundle
// that Bob projects. At two sessions the attacker replays Alice#2's bundle
// into Bob, so Bob and Bob#2 both use na#2 as na_b. A replay was recognized
// only on the received slot itself, so the projected value read as fresh. A
// value a run computes from a replayed slot is replayed too.
// freshness_projected_bound.vp is the counterweight.
attacker[active]

principal Alice[
	knows private ska
	knows public tag
	gka = PUBKEY(ska)
	generates na
	bundle = CONCAT(na, tag)
	s1 = SIGN(ska, bundle)
]

Alice -> Bob: [gka], bundle, s1

principal Bob[
	knows public tag
	_ = SIGNVERIF(gka, bundle, s1)?
	na_b, tag_b = SPLIT(bundle)?
	u = HASH(na_b)
]

queries[
	freshness? na_b
	authentication? Alice -> Bob: bundle
]

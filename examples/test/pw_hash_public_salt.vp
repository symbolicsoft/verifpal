//
// Expected: c0c1c0c1 — a salt is not a secret and was never meant to be one.
// Alice publishes two stored password records built with the same public salt,
// the way a breached database would expose them; only the record that went
// through PW_HASH survives, because password_hashing marks every PW_HASH
// position as unguessable while HASH marks none. Salting stops precomputation,
// not guessing, and this model is where that distinction is written down.
//
// The two message queries are the consequence: the session keys are derived
// from the same passwords under a different public label, so they are not the
// stored records and cannot be read off them. Recovering the password is the
// only route to m_fast, and it is a route that exists.
//
// Every other PW_HASH model in the tree calls it with a single argument, so
// the multi-argument form — the only one anybody actually deploys — had no
// coverage at all.

attacker[passive]

principal Alice[
	knows password pw_slow
	knows password pw_fast
	knows public salt, label
	knows private m_slow, m_fast
	stored_slow = PW_HASH(pw_slow, salt)
	stored_fast = HASH(pw_fast, salt)
	e_slow = ENC(PW_HASH(pw_slow, label), m_slow)
	e_fast = ENC(HASH(pw_fast, label), m_fast)
]

Alice -> Bob: stored_slow, stored_fast, e_slow, e_fast

principal Bob[
	knows password pw_slow
	knows password pw_fast
	knows public label
	d_slow = DEC(PW_HASH(pw_slow, label), e_slow)
	d_fast = DEC(HASH(pw_fast, label), e_fast)
]

queries[
	confidentiality? pw_slow
	confidentiality? pw_fast
	confidentiality? m_slow
	confidentiality? m_fast
]

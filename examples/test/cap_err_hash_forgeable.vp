//
// Sanity error: HASH has no secret argument, so there is nothing to forge
// without.
attacker[active]

principal Alice[
	knows private m
	h = HASH[forgeable](m)
]

Alice -> Bob: h

principal Bob[
	_ = HASH(h)
]

queries[
	confidentiality? m
]

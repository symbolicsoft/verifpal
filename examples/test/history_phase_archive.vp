// Expected: a0 at one session and at two.
//
// incompatible_histories.vp with a phase boundary after Bob's run and a
// statement in phase 1 that discloses nothing. The two executions of Alice
// still exclude each other: only delivering PUBKEY(nil) as gb reveals na, and
// in that execution Bob's DEC does not recover na, so no single execution
// lets the attacker forge c. A phase boundary adds nothing the attacker can
// spend, and the verdict must not move.
//
// The engine used to report the phase-0 attack while running at phase 1: a
// slot delivered in an earlier phase is proven derivable against that
// phase's archived knowledge, and the archive was read raw, without the
// history-coherence restriction the current-phase knowledge goes through.
// The restriction now applies to whichever snapshot the proof is made
// against. history_phase_archive_third_party.vp is the same rule where the
// revealing message went to a third principal.

attacker[active]

principal Alice[
	knows private msg
	generates a
	generates na
	ga = PUBKEY(a)
]

principal Bob[
	generates b
	gb = PUBKEY(b)
]

Alice -> Bob: [ga]
Bob -> Alice: gb

principal Alice[
	ka = DH_KEX(gb, a)
	e = ENC(ka, na)
	generates n_c
	c = AEAD_ENC(na, n_c, msg, nil)
]

Alice -> Bob: e, n_c, c

principal Bob[
	kb = DH_KEX(ga, b)
	n = DEC(kb, e)
	p = AEAD_DEC(n, n_c, c, nil)?
	h = HASH(p)
]

phase[1]

principal Bob[
	hh = HASH(h)
]

queries[
	authentication? Alice -> Bob: c
]

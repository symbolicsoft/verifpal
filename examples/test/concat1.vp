attacker[active]

principal Alice[
	knows private a
	knows private b
	knows private m
	generates n_e
	e = AEAD_ENC(b, n_e, m, nil)
	c = CONCAT(a, b)
]

Alice -> Bob: n_e, e, c

principal Bob[
	aa, bb = SPLIT(c)
	_ = AEAD_DEC(bb, n_e, e, nil)?
]

queries[
	confidentiality? m
]

//
// Expected: c1c0 — the ciphertext is recorded in phase 0 and only opened by
// its recipient in phase 2, with the key surrendered in between. Whether the
// attacker wins does not depend on when Bob got around to decrypting; it
// depends on whether the key ever became reachable, and phases are the only
// way the model can say "later".
//
// The second flight is the counterweight and uses a key that is never
// surrendered, so the two differ in the leak and in nothing else. A phase
// implementation that scoped a leak to the phase it appears in — rather than
// to that phase onward — would report c0 for both and silently un-break every
// delayed-compromise model in the tree.

attacker[passive]

principal Alice[
	knows private k_lost, k_held
	knows private m_lost, m_held
	e_lost = AEAD_ENC(k_lost, m_lost, nil)
	e_held = AEAD_ENC(k_held, m_held, nil)
]

Alice -> Bob: e_lost, e_held

phase[1]

principal Alice[
	leaks k_lost
]

phase[2]

principal Bob[
	knows private k_lost, k_held
	d_lost = AEAD_DEC(k_lost, e_lost, nil)?
	d_held = AEAD_DEC(k_held, e_held, nil)?
	_ = HASH(d_lost, d_held)
]

queries[
	confidentiality? m_lost
	confidentiality? m_held
]

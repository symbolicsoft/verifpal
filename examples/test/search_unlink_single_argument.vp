//
// Expected: u1 at one session and at two.
//
// Alice signs message = HASH(x, y) under skone and sktwo. Replacing eb with
// ex makes Bob leak x, and replacing ec with ey makes Carol leak y, so the
// attacker rebuilds message in one execution, and SIGNVERIF confirms it for
// both signatures under the public keys on the wire. Neither signing key is
// needed.
//
// Alice also sends eskone and esktwo, so the same oracles can leak skone or
// sktwo instead, and the union derives both secret arguments of each
// signature. A query-source merge once targeted them only together, but
// skone needs eskone at Bob's input and x needs ex there, so at one session
// no execution supplied both, the merge tried nothing, and the link was
// missed (GitHub issue #57). At two sessions one Bob run took eskone and the
// other ex. Each missing argument is now also a target on its own.
//
// search_unlink_single_argument_guarded.vp guards eb and holds;
// _unsent_keys and _message_query are the issue's other two controls.
attacker[active]

principal Alice[
	knows private kb, kc, skone, sktwo
	generates x, y
	message = HASH(x, y)
	sigone = SIGN(skone, message)
	sigtwo = SIGN(sktwo, message)
	pkone = PUBKEY(skone)
	pktwo = PUBKEY(sktwo)
	ex = ENC(kb, x)
	ey = ENC(kc, y)
	eskone = ENC(kb, skone)
	esktwo = ENC(kc, sktwo)
	eb = ENC(kb, nil)
	ec = ENC(kc, nil)
]

Alice -> Dave: ex, ey, pkone, pktwo, sigone, sigtwo, eskone, esktwo
Alice -> Bob: eb
Alice -> Carol: ec

principal Bob[
	knows private kb
	db = DEC(kb, eb)
	leaks db
]

principal Carol[
	knows private kc
	dc = DEC(kc, ec)
	leaks dc
]

principal Dave[
	_ = HASH(ex, ey, pkone, pktwo, sigone)
	_ = HASH(sigtwo, eskone, esktwo)
]

queries[
	unlinkability? sigone, sigtwo
]

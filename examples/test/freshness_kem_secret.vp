//
// Expected: f0f1 — a KEM shared secret is fresh only if the encapsulation
// randomness is. Both encapsulations go to the same public key; one is fed a
// generated value and one a long-term one, and the difference propagates into
// the secret.
//
// KEM_ENCAP's first output is where the secret lives, so the freshness descent
// has to pass through a multi-output primitive to a specific argument. Every
// other KEM model in the tree encapsulates with a generated value, so a
// descent that answered "fresh" for any KEM output would look correct
// everywhere except here.

attacker[active]

principal Bob[
	knows private dk
	ek = PUBKEY(dk)
]

Bob -> Alice: [ek]

principal Alice[
	generates r_fresh
	knows private r_static
	ss_fresh, ct_fresh = KEM_ENCAP(ek, r_fresh)
	ss_static, ct_static = KEM_ENCAP(ek, r_static)
	_ = HASH(ss_fresh, ss_static)
]

Alice -> Bob: ct_fresh, ct_static

principal Bob[
	_ = HASH(ct_fresh, ct_static)
]

queries[
	freshness? ss_fresh
	freshness? ss_static
]

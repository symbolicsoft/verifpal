// Expected: a1 at one session and at two.
//
// Alice checks the nonce against a guarded digest of it before she tags it, so
// the one substitution that would make her emit MAC(k, nil) halts her at that
// check and she never reaches the send. Mallory leaks the shared key, so the
// attacker forges the tag anyway and Bob accepts it. A run that halts before
// its send emitted nothing, so it cannot be the matching run the exemption
// needs.

attacker[active]

principal Alice[
	knows private mrh_k
]

principal Carol[
	generates mrh_n
	mrh_hn = HASH(mrh_n)
]

principal Bob[
	knows private mrh_k
]

principal Mallory[
	knows private mrh_k
	leaks mrh_k
]

Carol -> Alice: mrh_n, [mrh_hn]
Carol -> Bob: mrh_n

principal Alice[
	_ = ASSERT(mrh_hn, HASH(mrh_n))?
	mrh_t = MAC(mrh_k, mrh_n)
]

Alice -> Bob: mrh_t

principal Bob[
	_ = ASSERT(mrh_t, MAC(mrh_k, mrh_n))?
]

queries[
	authentication? Alice -> Bob: mrh_t
]

//
// Expected: c0 at one session and at two.
//
// forged_statement_rebuilt_secret_only.vp with the requester's key in the
// signed statement. The signer signs over the key it received, so a request
// whose key the attacker swapped yields a signature over the attacker's key,
// and the verifier rebuilds the statement with its own gx: no signature the
// attacker can obtain passes SIGNVERIF, and secret stays sealed.
attacker[active]

principal Signer[
	knows private ssk
	knows public c_ad
	knows public c_tag
	knows public c_stmt
	generates y
	gs = PUBKEY(ssk)
	gy = PUBKEY(y)
]

Signer -> Verifier: [gs]

principal Verifier[
	knows public c_ad
	knows public c_tag
	knows public c_stmt
	generates x
	generates nonce
	generates secret
	gx = PUBKEY(x)
	req = CONCAT(c_tag, gx, nonce)
]

Verifier -> Signer: req

principal Signer[
	tag_s, gx_s, nonce_s = SPLIT(req)?
	_ = ASSERT(tag_s, c_tag)?
	stmt = CONCAT(c_stmt, gs, nonce_s, gx_s)
	sig = SIGN(ssk, stmt)
	k = HKDF(nil, DH_KEX(gx_s, y), nil)
	generates n_env
	env = AEAD_ENC(k, n_env, CONCAT(gs, sig), c_ad)
]

Signer -> Verifier: gy, n_env, env

principal Verifier[
	kv = HKDF(nil, DH_KEX(gy, x), nil)
	d = AEAD_DEC(kv, n_env, env, c_ad)?
	iss_v, sig_v = SPLIT(d)?
	_ = ASSERT(iss_v, gs)?
	stmt_v = CONCAT(c_stmt, iss_v, nonce, gx)
	_ = SIGNVERIF(iss_v, stmt_v, sig_v)?
	generates n_out
	out = AEAD_ENC(kv, n_out, secret, c_ad)
]

Verifier -> Signer: n_out, out

queries[
	confidentiality? secret
]

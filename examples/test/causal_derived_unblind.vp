// Expected: a0 at one session, a1 at two. Public unblinding needs its
// derived factor, whose ingredients leak only after the attacked check.
// The factor is reconstructed in place, not held as a named known term.
attacker[active]

principal Alice[
	knows private sk, left, right
	ga = PUBKEY(sk)
	blindsig = SIGN(sk, BLIND(HASH(left, right), nil))
	generates n
	sig = SIGN(sk, n)
]

Alice -> Carol: blindsig

principal Carol[]

Alice -> Bob: [ga], n, sig

principal Bob[
	_ = SIGNVERIF(ga, n, sig)?
	generates ack
]

Bob -> Alice: ack

principal Alice[
	_ = HASH(ack)
	leaks left, right
]

queries[
	authentication? Alice -> Bob: sig
]

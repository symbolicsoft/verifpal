// Expected: c0 at one session and at two.
//
// broadcast_consistent_replacement.vp with ga guarded on its way to Carol.
// Carol hashes Alice's real ga, so any replacement at Bob fails his ASSERT.
attacker[active]
principal Alice[
	generates a
	ga = PUBKEY(a)
]
Alice -> Bob: ga
Alice -> Carol: [ga]
principal Bob[
	generates b, sb
	gb = PUBKEY(b)
	hb = HASH(ga)
]
principal Carol[
	hc = HASH(ga)
]
Bob -> Carol: [hb]
Carol -> Bob: [hc]
principal Bob[
	_ = ASSERT(hb, hc)?
	kb = DH_KEX(ga, b)
	generates n
	e = AEAD_ENC(kb, n, sb, nil)
]
Bob -> Alice: gb, n, e
queries[
	confidentiality? sb
]

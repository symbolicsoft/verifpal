// Expected: c1c1c1 at one session and at two.
//
// Alice sends n and s in the clear, so the attacker can build HASH(n) and
// HASH(s) before Bob's receive. Handing Bob s := HASH(n) makes his m1 the MAC
// inside z1; handing either slot HASH(s) makes one of his tags the MAC inside
// z2. z needs both tags from one run of Bob, and that run exists too: hand him
// n := HASH(s) and s := HASH(n) at once, and he emits MAC(k, HASH(n)) and
// MAC(k, HASH(s)). The installed terms name the nonces Alice sent, not Bob's
// slots, so nothing is defined in terms of itself; reading the installed `s`
// as Bob's own slot `s` would see a cycle that no execution has.

attacker[active]

principal Alice[
	knows private k
	generates n
	generates s
	z1 = HASH(MAC(k, HASH(n)))
	z2 = HASH(MAC(k, HASH(s)))
	z = HASH(MAC(k, HASH(n)), MAC(k, HASH(s)))
]

Alice -> Bob: n, s

principal Bob[
	knows private k
	m1 = MAC(k, s)
	m2 = MAC(k, n)
]

Bob -> Alice: m1, m2

queries[
	confidentiality? z1
	confidentiality? z2
	confidentiality? z
]

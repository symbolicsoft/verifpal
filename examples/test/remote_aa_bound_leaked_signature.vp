//
// Expected: a0 at one session, a1 at two (GitHub issue #50).
//
// examples/epassport/remote_aa_bound_private_nfc.vp, where the chip also
// leaks aaSig. The chip signs HASH(rpPub, chal_p) and Bank checks a
// signature over HASH(bankPub, chal), so only a phone that trusts Bank can
// produce one Bank accepts. Bank opens resp under the key in ckMsg, so the
// attacker must replace ckMsg with a key of its own. At one session that
// halts Phone, the only phone whose signature Bank accepts: a0.
//
// At two sessions the attacker replaces Bank's ckMsg with PKE_ENC(bankPub,
// nil), reads chal, and replays Phone#2's ckMsg#2 to Bank@2, so Bank#2 and
// Bank@2 both encrypt under ck#2 and the fixed nChal. That pair lets it
// forge chal under ck#2 for Phone#2, whose chip signs HASH(bankPub, chal)
// and leaks it. Sealed under nil, the signature is a resp that Bank accepts
// and no Phone sent: a1.
//
// The search reaches this through a merge in which Bank's receive of resp
// also waits on dg1_phone, dg15_phone and sodSig_phone, which the halted
// Phone never sends. That receive counted as stuck although its resp install
// was derivable, so the merge was dropped instead of having those slots
// filled. The stuck candidate also spent its one supplier per round on
// suppliers whose merge it had already tried, and never reached this one.
//
// remote_aa_bound_private_nfc.vp, without the leak, holds.

attacker[active]

principal Passport[
	knows private aaKey
	dg15 = PUBKEY(aaKey)
]

Passport -> Issuer: [dg15]

principal Issuer[
	knows private dsKey, persoKey, dg1
	dsPub = PUBKEY(dsKey)
	sodSig = SIGN(dsKey, HASH(dg1, dg15))
	perso = ENC(persoKey, sodSig)
]

Issuer -> Bank: [dsPub]
Issuer -> Passport: [perso]

principal Evil[
	knows private evilKey
	evilPub = PUBKEY(evilKey)
	leaks evilKey
]

principal Bank[
	knows private bankKey
	bankPub = PUBKEY(bankKey)
]

Bank -> Phone: [bankPub]
Evil -> Phone: [evilPub]

principal Phone[
	knows private nfcKey
	knows public rpPub, nChal, nResp
	generates ck
	ckMsg = PKE_ENC(rpPub, ck)
]

Phone -> Bank: ckMsg

principal Bank[
	knows public nChal, nResp
	ck_b = PKE_DEC(bankKey, ckMsg)
	generates chal
	chalMsg = AEAD_ENC(ck_b, nChal, chal, nil)
]

Bank -> Phone: chalMsg

principal Phone[
	chal_p = AEAD_DEC(ck, nChal, chalMsg, nil)?
	toSign = HASH(rpPub, chal_p)
	nfcRequest = ENC(nfcKey, toSign)
]

Phone -> Passport: [nfcRequest]

principal Passport[
	knows private persoKey, dg1, nfcKey
	sodSig_p = DEC(persoKey, perso)
	challenge_p = DEC(nfcKey, nfcRequest)
	aaSig = SIGN(aaKey, challenge_p)
	leaks aaSig
	nfcAnswer = ENC(nfcKey, CONCAT(dg1, dg15, sodSig_p, aaSig))
]

Passport -> Phone: [nfcAnswer]

principal Phone[
	dg1_phone, dg15_phone, sodSig_phone, aaSig_phone = SPLIT(DEC(nfcKey, nfcAnswer))
	resp = AEAD_ENC(ck, nResp, aaSig_phone, nil)
]

Phone -> Bank: dg1_phone, dg15_phone, sodSig_phone, resp

principal Bank[
	_ = SIGNVERIF(dsPub, HASH(dg1_phone, dg15_phone), sodSig_phone)?
	_ = SIGNVERIF(dg15_phone, HASH(bankPub, chal), AEAD_DEC(ck_b, nResp, resp, nil))?
]

scenarios[
	Phone[rpPub = bankPub]
	Phone[rpPub = evilPub]
]

queries[
	authentication? Phone -> Bank: resp
]

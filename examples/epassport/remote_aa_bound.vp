// SPDX-License-Identifier: GPL-3.0-only
//
// remote_aa.vp with one change on each side. The phone no longer hands the
// chip the challenge as received: it hands it a hash of the public key of
// the service it actually opened its channel to, together with the
// challenge, as WebAuthn binds an assertion to the origin the browser
// reached. The bank checks the chip's signature over a hash of its own key
// and its challenge. The chip is unchanged; Active Authentication signs
// whatever bytes it is given, and these bytes now say to whom.
//
// Expected: a0 at one session, a1 at two. At one session the dishonest
// verifier can still pass the bank's challenge to the holder's phone, but
// the phone hashes it with the verifier's key, and the chip's signature over
// that is useless at the bank. remote_aa.vp is the attack this closes.
//
// The attack at two sessions is not that relay, and the binding cannot stop
// it, because it goes through the phone's own channel to the bank. The bank
// contributes nothing to the channel key and the record nonces are fixed
// labels, so the attacker replays the phone's ckMsg into a second bank run,
// and two bank runs encrypt different challenges under the same key and
// nChal. That nonce reuse lets it forge a chalMsg on the phone's channel
// carrying the challenge of a third bank run, one it opened with its own
// channel key. The phone, which is connected to the bank, hashes bankPub
// with that challenge, and the chip signs. The attacker then reads aaSig
// from the guarded NFC exchange and encrypts it for its own bank run,
// where the bank accepts it. This trace requires the attacker to learn the
// plaintext aaSig from the modeled NFC link, in addition to exploiting
// nonce reuse on the phone-bank connection. A TLS server contributes fresh
// values to the channel keys, so a replayed key message wouldn't give two
// server runs the same keys; this channel is weaker than TLS.

attacker[active]

principal Passport[
	knows private aaKey
	dg15 = PUBKEY(aaKey)
]

Passport -> Issuer: [dg15]

principal Issuer[
	knows private dsKey, persoKey, dg1
	dsPub = PUBKEY(dsKey)
	sodSig = SIGN(dsKey, HASH(dg1, dg15))
	perso = ENC(persoKey, sodSig)
]

Issuer -> Bank: [dsPub]
Issuer -> Passport: [perso]

principal Evil[
	knows private evilKey
	evilPub = PUBKEY(evilKey)
	leaks evilKey
]

principal Bank[
	knows private bankKey
	bankPub = PUBKEY(bankKey)
]

Bank -> Phone: [bankPub]
Evil -> Phone: [evilPub]

principal Phone[
	knows public rpPub, nChal, nResp
	generates ck
	ckMsg = PKE_ENC(rpPub, ck)
]

Phone -> Bank: ckMsg

principal Bank[
	knows public nChal, nResp
	ck_b = PKE_DEC(bankKey, ckMsg)
	generates chal
	chalMsg = AEAD_ENC(ck_b, nChal, chal, nil)
]

Bank -> Phone: chalMsg

principal Phone[
	chal_p = AEAD_DEC(ck, nChal, chalMsg, nil)?
	toSign = HASH(rpPub, chal_p)
]

Phone -> Passport: [toSign]

principal Passport[
	knows private persoKey, dg1
	sodSig_p = DEC(persoKey, perso)
	aaSig = SIGN(aaKey, toSign)
]

Passport -> Phone: [dg1], [dg15], [sodSig_p], [aaSig]

principal Phone[
	resp = AEAD_ENC(ck, nResp, aaSig, nil)
]

Phone -> Bank: dg1, dg15, sodSig_p, resp

principal Bank[
	_ = SIGNVERIF(dsPub, HASH(dg1, dg15), sodSig_p)?
	_ = SIGNVERIF(dg15, HASH(bankPub, chal), AEAD_DEC(ck_b, nResp, resp, nil))?
]

scenarios[
	Phone[rpPub = bankPub]
	Phone[rpPub = evilPub]
]

queries[
	authentication? Phone -> Bank: resp
]

// SPDX-License-Identifier: GPL-3.0-only
//
// remote_aa.vp with one change on each side. The phone no longer hands the
// chip the challenge as received: it hands it a hash of the public key of
// the service it actually opened its channel to, together with the
// challenge, as WebAuthn binds an assertion to the origin the browser
// reached. The bank checks the chip's signature over a hash of its own key
// and its challenge. The chip is unchanged; Active Authentication signs
// whatever bytes it is given, and these bytes now say to whom.
//
// Expected: a0 at one session and at two. At one session the dishonest
// verifier can still pass the bank's challenge to the holder's phone, but the
// phone hashes it with the verifier's key, and the chip's signature over that
// is useless at the bank. remote_aa.vp is the attack this closes.
//
// The channel to the bank is still weaker than TLS. The bank contributes
// nothing to the channel key and the record nonces are fixed labels, so at
// two sessions the attacker can replay the phone's ckMsg into a second bank
// run, and two bank runs then encrypt different challenges under the same
// key and nChal. Against AES-GCM or ChaCha20-Poly1305 that nonce reuse gives
// the attacker the XOR of the two challenges and the tag key for that nonce,
// but neither challenge, so it cannot seal a challenge of its choosing for
// the phone: that takes a known plaintext under the key and nonce. Verifpal
// once granted both plaintexts and that forgery to every reused pair, and
// reported a1 at two sessions here. If the attacker can predict the bank's
// challenges, the forgery is real: it seals the challenge of a bank run it
// opened with its own channel key, reads the chip's signature over that
// challenge from the readable NFC link, and hands it to that bank run
// (examples/test/remote_aa_bound_leaked_signature.vp and its siblings). A TLS
// server contributes fresh values to the channel keys, so a replayed key
// message wouldn't give two server runs the same keys.

attacker[active]

principal Passport[
	knows private aaKey
	dg15 = PUBKEY(aaKey)
]

Passport -> Issuer: [dg15]

principal Issuer[
	knows private dsKey, persoKey, dg1
	dsPub = PUBKEY(dsKey)
	sodSig = SIGN(dsKey, HASH(dg1, dg15))
	perso = ENC(persoKey, sodSig)
]

Issuer -> Bank: [dsPub]
Issuer -> Passport: [perso]

principal Evil[
	knows private evilKey
	evilPub = PUBKEY(evilKey)
	leaks evilKey
]

principal Bank[
	knows private bankKey
	bankPub = PUBKEY(bankKey)
]

Bank -> Phone: [bankPub]
Evil -> Phone: [evilPub]

principal Phone[
	knows public rpPub, nChal, nResp
	generates ck
	ckMsg = PKE_ENC(rpPub, ck)
]

Phone -> Bank: ckMsg

principal Bank[
	knows public nChal, nResp
	ck_b = PKE_DEC(bankKey, ckMsg)
	generates chal
	chalMsg = AEAD_ENC(ck_b, nChal, chal, nil)
]

Bank -> Phone: chalMsg

principal Phone[
	chal_p = AEAD_DEC(ck, nChal, chalMsg, nil)?
	toSign = HASH(rpPub, chal_p)
]

Phone -> Passport: [toSign]

principal Passport[
	knows private persoKey, dg1
	sodSig_p = DEC(persoKey, perso)
	aaSig = SIGN(aaKey, toSign)
]

Passport -> Phone: [dg1], [dg15], [sodSig_p], [aaSig]

principal Phone[
	resp = AEAD_ENC(ck, nResp, aaSig, nil)
]

Phone -> Bank: dg1, dg15, sodSig_p, resp

principal Bank[
	_ = SIGNVERIF(dsPub, HASH(dg1, dg15), sodSig_p)?
	_ = SIGNVERIF(dg15, HASH(bankPub, chal), AEAD_DEC(ck_b, nResp, resp, nil))?
]

scenarios[
	Phone[rpPub = bankPub]
	Phone[rpPub = evilPub]
]

queries[
	authentication? Phone -> Bank: resp
]

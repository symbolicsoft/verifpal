// SPDX-License-Identifier: GPL-3.0-only
//
// Terminal Authentication version 1 on a passport that uses Basic Access
// Control (BSI TR-03110 version 2.05 §4.4, ICAO Doc 9303 Part 11 §7), against
// an attacker who knows the MRZ. With BAC, ID_PICC is the document number,
// which is printed in the MRZ.
//
// Basic Access Control is left out: every key it produces is a function of
// the MRZ and of values the attacker sees, so against this attacker its
// Secure Messaging is a channel it opens and reseals at will, and DG14 and
// the Chip Authentication messages might as well be in clear. The model
// starts at Chip Authentication. Under its keys, the chip sends a
// challenge, the terminal answers with its certificate and a signature over
// ID_PICC, the challenge and its Chip Authentication ephemeral key, and the
// chip releases DG3, the fingerprints, if both verify. The terminal does
// not check DG14 against EF.SOD before Terminal Authentication, which gives
// the attacker more, not less; see inspect_ca.vp for that check.
//
// Abstractions as in inspect_ta.vp.
//
// Expected: c0, at one session and at two. The attacker can hold the chip's
// Chip Authentication keys, by running it with its own ephemeral key, and
// the terminal's, by offering the terminal its own key as DG14. It can carry
// the chip's challenge into the terminal's channel and the signature back.
// The signature covers the terminal's ephemeral key, and the chip compares
// it with the key it was given, which was the attacker's.
// eac_bac_unbound.vp removes that key from the signature.

attacker[active]

principal Hotel[
	knows public docNumber
	knows private mrz
	leaks mrz
]

principal Terminal[
	knows private termKey
	termPub = PUBKEY(termKey)
]

Terminal -> Cvca: [termPub]

principal Cvca[
	knows private cvcaKey
	cvcaPub = PUBKEY(cvcaKey)
	termCert = SIGN(cvcaKey, termPub)
]

Cvca -> Terminal: [termCert]
Cvca -> Passport: [cvcaPub]

principal Passport[
	knows private caKey, dg3
	knows public docNumber, sscR, sscTa, sscDg3
	dg14 = PUBKEY(caKey)
]

Passport -> Terminal: dg14

principal Terminal[
	knows public docNumber, sscR, sscTa, sscDg3
	generates caSkT
	caPkT = PUBKEY(caSkT)
	caEnc_t, caMac_t = HKDF(nil, DH_KEX(dg14, caSkT), nil)
]

Terminal -> Passport: caPkT

principal Passport[
	caEnc, caMac = HKDF(nil, DH_KEX(caPkT, caKey), nil)
	generates rPicc
	smR = ENC(caEnc, rPicc)
	tagR = MAC(caMac, CONCAT(sscR, smR))
]

Passport -> Terminal: smR, tagR

principal Terminal[
	_ = ASSERT(MAC(caMac_t, CONCAT(sscR, smR)), tagR)?
	rPicc_t = DEC(caEnc_t, smR)
	taSig = SIGN(termKey, CONCAT(docNumber, rPicc_t, caPkT))
	smTa = ENC(caEnc_t, CONCAT(termPub, termCert, taSig))
	tagTa = MAC(caMac_t, CONCAT(sscTa, smTa))
]

Terminal -> Passport: smTa, tagTa

principal Passport[
	_ = ASSERT(MAC(caMac, CONCAT(sscTa, smTa)), tagTa)?
	termPub_p, termCert_p, taSig_p = SPLIT(DEC(caEnc, smTa))
	_ = SIGNVERIF(cvcaPub, termPub_p, termCert_p)?
	_ = SIGNVERIF(termPub_p, CONCAT(docNumber, rPicc, caPkT), taSig_p)?
	smDg3 = ENC(caEnc, dg3)
	tagDg3 = MAC(caMac, CONCAT(sscDg3, smDg3))
]

Passport -> Terminal: smDg3, tagDg3

principal Terminal[
	_ = ASSERT(MAC(caMac_t, CONCAT(sscDg3, smDg3)), tagDg3)?
	dg3_t = DEC(caEnc_t, smDg3)
]

queries[
	confidentiality? dg3
]

//
// remote_aa_bound.vp with the private NFC exchange of
// remote_aa_private_nfc.vp. The phone encrypts the value to sign and the
// chip encrypts its answer under nfcKey, known only to Phone and Passport.
// Guards prevent replacement. This is an ideal private local link; it
// doesn't implement BAC or PACE Secure Messaging.
//
// Expected: a0, at one session and at two. No attack is found in these
// searches, with the session count applying per principal, per scenario.
// The search misses known attacks in related weakened or leaking variants,
// so this is not a security proof even within those bounds. The signature
// obtained by a dishonest verifier covers that verifier's key, while the
// bank expects its own key. The relay in remote_aa_private_nfc.vp no longer
// answers the bank's challenge.
//
// The reported attack at two sessions in remote_aa_bound.vp obtains aaSig
// from NFC after exploiting nonce reuse on the internet connection. Here
// that local exchange is private. The internet connection still uses the
// original key transport and fixed record nonces, so these results don't
// establish the security of that connection.
//
// Active Authentication accepts a challenge of eight bytes. The HASH used
// for the service binding has no length limit in this model; a concrete
// encoding would need its own analysis.

attacker[active]

principal Passport[
	knows private aaKey
	dg15 = PUBKEY(aaKey)
]

Passport -> Issuer: [dg15]

principal Issuer[
	knows private dsKey, persoKey, dg1
	dsPub = PUBKEY(dsKey)
	sodSig = SIGN(dsKey, HASH(dg1, dg15))
	perso = ENC(persoKey, sodSig)
]

Issuer -> Bank: [dsPub]
Issuer -> Passport: [perso]

principal Evil[
	knows private evilKey
	evilPub = PUBKEY(evilKey)
	leaks evilKey
]

principal Bank[
	knows private bankKey
	bankPub = PUBKEY(bankKey)
]

Bank -> Phone: [bankPub]
Evil -> Phone: [evilPub]

principal Phone[
	knows private nfcKey
	knows public rpPub, nChal, nResp
	generates ck
	ckMsg = PKE_ENC(rpPub, ck)
]

Phone -> Bank: ckMsg

principal Bank[
	knows public nChal, nResp
	ck_b = PKE_DEC(bankKey, ckMsg)
	generates chal
	chalMsg = AEAD_ENC(ck_b, nChal, chal, nil)
]

Bank -> Phone: chalMsg

principal Phone[
	chal_p = AEAD_DEC(ck, nChal, chalMsg, nil)?
	toSign = HASH(rpPub, chal_p)
	nfcRequest = ENC(nfcKey, toSign)
]

Phone -> Passport: [nfcRequest]

principal Passport[
	knows private persoKey, dg1, nfcKey
	sodSig_p = DEC(persoKey, perso)
	challenge_p = DEC(nfcKey, nfcRequest)
	aaSig = SIGN(aaKey, challenge_p)
	nfcAnswer = ENC(nfcKey, CONCAT(dg1, dg15, sodSig_p, aaSig))
]

Passport -> Phone: [nfcAnswer]

principal Phone[
	dg1_phone, dg15_phone, sodSig_phone, aaSig_phone = SPLIT(DEC(nfcKey, nfcAnswer))
	resp = AEAD_ENC(ck, nResp, aaSig_phone, nil)
]

Phone -> Bank: dg1_phone, dg15_phone, sodSig_phone, resp

principal Bank[
	_ = SIGNVERIF(dsPub, HASH(dg1_phone, dg15_phone), sodSig_phone)?
	_ = SIGNVERIF(dg15_phone, HASH(bankPub, chal), AEAD_DEC(ck_b, nResp, resp, nil))?
]

scenarios[
	Phone[rpPub = bankPub]
	Phone[rpPub = evilPub]
]

queries[
	authentication? Phone -> Bank: resp
]

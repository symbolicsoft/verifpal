// SPDX-License-Identifier: GPL-3.0-only
//
// Two sightings of one passport, each a Basic Access Control run as in
// bac.vp (ICAO Doc 9303 Part 11 §4.3), one with a terminal at a hotel desk
// and one with a terminal at an airport gate. An eavesdropper near both
// readers records the two runs, and holds the MRZ: the hotel kept a copy of
// the data page and it leaked. Can it tell that the two recordings came
// from the same passport?
//
// The queried values are the chip's MACs from each sighting. Each is
// computed under K_MAC, which the MRZ alone determines, over that run's
// ciphertext, which is on the wire.
//
// Expected: u1, at one session and at two. With the MRZ the eavesdropper
// recomputes both MACs from what it recorded: the two values are tied to
// the same static key, so the sightings link. Nothing in the run needs to
// be active for this; it is a passive attacker. track_pace.vp asks the same
// question of PACE, and track_bac_unknown_mrz.vp asks it without the leak.

attacker[passive]

principal Hotel[
	knows private mrz
	leaks mrz
]

principal Passport[
	knows private mrz
	kEnc, kMac = HKDF(nil, mrz, nil)
	generates rndIC_a, rndIC_b
]

Passport -> HotelDesk: rndIC_a

principal HotelDesk[
	knows private mrz
	generates rndIFD_a, kIFD_a
	kEnc_a, kMac_a = HKDF(nil, mrz, nil)
	eIFD_a = ENC(kEnc_a, CONCAT(rndIFD_a, rndIC_a, kIFD_a))
	mIFD_a = MAC(kMac_a, eIFD_a)
]

HotelDesk -> Passport: eIFD_a, mIFD_a

principal Passport[
	_ = ASSERT(MAC(kMac, eIFD_a), mIFD_a)?
	rndIFD_pa, rndIC_pa, kIFD_pa = SPLIT(DEC(kEnc, eIFD_a))
	_ = ASSERT(rndIC_pa, rndIC_a)?
	generates kIC_a
	eIC_a = ENC(kEnc, CONCAT(rndIC_a, rndIFD_pa, kIC_a))
	mIC_a = MAC(kMac, eIC_a)
]

Passport -> HotelDesk: eIC_a, mIC_a

principal HotelDesk[
	_ = ASSERT(MAC(kMac_a, eIC_a), mIC_a)?
]

Passport -> Gate: rndIC_b

principal Gate[
	knows private mrz
	generates rndIFD_b, kIFD_b
	kEnc_b, kMac_b = HKDF(nil, mrz, nil)
	eIFD_b = ENC(kEnc_b, CONCAT(rndIFD_b, rndIC_b, kIFD_b))
	mIFD_b = MAC(kMac_b, eIFD_b)
]

Gate -> Passport: eIFD_b, mIFD_b

principal Passport[
	_ = ASSERT(MAC(kMac, eIFD_b), mIFD_b)?
	rndIFD_pb, rndIC_pb, kIFD_pb = SPLIT(DEC(kEnc, eIFD_b))
	_ = ASSERT(rndIC_pb, rndIC_b)?
	generates kIC_b
	eIC_b = ENC(kEnc, CONCAT(rndIC_b, rndIFD_pb, kIC_b))
	mIC_b = MAC(kMac, eIC_b)
]

Passport -> Gate: eIC_b, mIC_b

principal Gate[
	_ = ASSERT(MAC(kMac_b, eIC_b), mIC_b)?
]

queries[
	unlinkability? mIC_a, mIC_b
]

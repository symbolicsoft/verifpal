// PLACEHOLDER HEADER

attacker[active]

principal CA[
	knows private caKey
	caPk = PUBKEY(caKey)
]

principal Server[
	knows private sigKey
	knows public serverName
	gSigKey = PUBKEY(sigKey)
]

principal Client[
	knows private clientSigKey
	knows private clientId
	clientPk = PUBKEY(clientSigKey)
]

principal Mallory[
	knows private mkey
	knows public mallName
	gmSigKey = PUBKEY(mkey)
	leaks mkey
]

Server -> CA: [gSigKey]
Client -> CA: [clientPk]
Mallory -> CA: [gmSigKey]

principal CA[
	knows public serverName, mallName
	knows private clientId
	serverCertSig = SIGN(caKey, CONCAT(serverName, gSigKey))
	clientCertSig = SIGN(caKey, CONCAT(clientId, clientPk))
	mallCertSig = SIGN(caKey, CONCAT(mallName, gmSigKey))
]

CA -> Server: [caPk], [serverCertSig]
CA -> Client: [caPk], [clientCertSig]
CA -> Mallory: [mallCertSig]

principal Server[
	serverCert = CONCAT(serverName, gSigKey, serverCertSig)
]

principal Mallory[
	mallCert = CONCAT(mallName, gmSigKey, mallCertSig)
]

Server -> Client: [serverCert]
Mallory -> Client: [mallCert]

principal Client[
	knows public peerCert
	knows public hdr, updateNotRequested
	knows public labelDerived, labelFinished
	knows public labelSHsTraffic, labelCHsTraffic
	knows public labelSApTraffic, labelCApTraffic
	knows public labelExpMaster, labelResMaster
	knows public labelResumption, labelTrafficUpd
	knows public ctxServerCV, ctxClientCV
	generates cr, ce
	gce = PUBKEY(ce)
]

Client -> Server: cr, gce

principal Server[
	knows public hdr, updateNotRequested
	knows public noExtensions, certReqCtx
	knows public labelDerived, labelFinished
	knows public labelSHsTraffic, labelCHsTraffic
	knows public labelSApTraffic, labelCApTraffic
	knows public labelExpMaster, labelResMaster
	knows public labelResumption, labelTrafficUpd
	knows public ctxServerCV, ctxClientCV
	generates sr, se
	gse = PUBKEY(se)
	dhe = DH_KEX(gce, se)
	earlySecret = HKDF(nil, nil, nil)
	derivedES = HKDF(earlySecret, labelDerived, nil)
	handshakeSecret = HKDF(derivedES, dhe, nil)
	transcriptSH = HASH(cr, gce, sr, gse)
	sHsTraffic = HKDF(handshakeSecret, labelSHsTraffic, transcriptSH)
	cHsTraffic = HKDF(handshakeSecret, labelCHsTraffic, transcriptSH)
	derivedHS = HKDF(handshakeSecret, labelDerived, nil)
	mainSecret = HKDF(derivedHS, nil, nil)
	transcriptCert = HASH(transcriptSH, noExtensions, certReqCtx, serverCert)
	serverCV = SIGN(sigKey, CONCAT(ctxServerCV, transcriptCert))
	sFinishedKey = HKDF(sHsTraffic, labelFinished, nil)
	transcriptCV = HASH(transcriptCert, serverCV)
	serverFinished = MAC(sFinishedKey, transcriptCV)
	serverFlight = AEAD_ENC(sHsTraffic, CONCAT(noExtensions, certReqCtx, serverCert, serverCV, serverFinished), hdr)
	transcriptSFin = HASH(transcriptCV, serverFinished)
	sApTraffic = HKDF(mainSecret, labelSApTraffic, transcriptSFin)
	cApTraffic = HKDF(mainSecret, labelCApTraffic, transcriptSFin)
	exporterSecret = HKDF(mainSecret, labelExpMaster, transcriptSFin)
]

Server -> Client: sr, gse, serverFlight

principal Client[
	dhe_c = DH_KEX(gse, ce)
	earlySecret_c = HKDF(nil, nil, nil)
	derivedES_c = HKDF(earlySecret_c, labelDerived, nil)
	handshakeSecret_c = HKDF(derivedES_c, dhe_c, nil)
	transcriptSH_c = HASH(cr, gce, sr, gse)
	sHsTraffic_c = HKDF(handshakeSecret_c, labelSHsTraffic, transcriptSH_c)
	cHsTraffic_c = HKDF(handshakeSecret_c, labelCHsTraffic, transcriptSH_c)
	derivedHS_c = HKDF(handshakeSecret_c, labelDerived, nil)
	mainSecret_c = HKDF(derivedHS_c, nil, nil)
	serverFlightDec = AEAD_DEC(sHsTraffic_c, serverFlight, hdr)?
	ee_c, certReqCtx_c, serverCert_c, serverCV_c, serverFinished_c = SPLIT(serverFlightDec)?
	certName_c, certKey_c, certSig_c = SPLIT(serverCert_c)?
	_ = SIGNVERIF(caPk, CONCAT(certName_c, certKey_c), certSig_c)?
	expName, _, _ = SPLIT(peerCert)
	_ = ASSERT(certName_c, expName)?
	transcriptCert_c = HASH(transcriptSH_c, ee_c, certReqCtx_c, serverCert_c)
	_ = SIGNVERIF(certKey_c, CONCAT(ctxServerCV, transcriptCert_c), serverCV_c)?
	sFinishedKey_c = HKDF(sHsTraffic_c, labelFinished, nil)
	transcriptCV_c = HASH(transcriptCert_c, serverCV_c)
	expectedSF = MAC(sFinishedKey_c, transcriptCV_c)
	_ = ASSERT(serverFinished_c, expectedSF)?
	transcriptSFin_c = HASH(transcriptCV_c, serverFinished_c)
	sApTraffic_c = HKDF(mainSecret_c, labelSApTraffic, transcriptSFin_c)
	cApTraffic_c = HKDF(mainSecret_c, labelCApTraffic, transcriptSFin_c)
	exporterSecret_c = HKDF(mainSecret_c, labelExpMaster, transcriptSFin_c)
	clientCert = CONCAT(certReqCtx_c, clientId, clientPk, clientCertSig)
	transcriptCCert = HASH(transcriptSFin_c, clientCert)
	clientCV = SIGN(clientSigKey, CONCAT(ctxClientCV, transcriptCCert))
	transcriptCCV = HASH(transcriptCCert, clientCV)
	cFinishedKey_c = HKDF(cHsTraffic_c, labelFinished, nil)
	clientFinished = MAC(cFinishedKey_c, transcriptCCV)
	clientFlight = AEAD_ENC(cHsTraffic_c, CONCAT(clientCert, clientCV, clientFinished), hdr)
	transcriptCFin_c = HASH(transcriptCCV, clientFinished)
	resumptionSecret_c = HKDF(mainSecret_c, labelResMaster, transcriptCFin_c)
	generates appMsg1
	appData1 = AEAD_ENC(cApTraffic_c, appMsg1, hdr)
]

Client -> Server: clientFlight, appData1

principal Server[
	clientFlightDec = AEAD_DEC(cHsTraffic, clientFlight, hdr)?
	clientCert_s, clientCV_s, clientFinished_s = SPLIT(clientFlightDec)?
	ctx_s, clientId_s, clientPk_s, clientCertSig_s = SPLIT(clientCert_s)?
	_ = ASSERT(ctx_s, certReqCtx)?
	_ = SIGNVERIF(caPk, CONCAT(clientId_s, clientPk_s), clientCertSig_s)?
	transcriptCCert_s = HASH(transcriptSFin, clientCert_s)
	_ = SIGNVERIF(clientPk_s, CONCAT(ctxClientCV, transcriptCCert_s), clientCV_s)?
	transcriptCCV_s = HASH(transcriptCCert_s, clientCV_s)
	cFinishedKey_s = HKDF(cHsTraffic, labelFinished, nil)
	expectedCF = MAC(cFinishedKey_s, transcriptCCV_s)
	_ = ASSERT(clientFinished_s, expectedCF)?
	transcriptCFin = HASH(transcriptCCV_s, clientFinished_s)
	resumptionSecret = HKDF(mainSecret, labelResMaster, transcriptCFin)
	appMsg1_s = AEAD_DEC(cApTraffic, appData1, hdr)?
	generates ticketNonce1, ticketNonce2
	resPsk1 = HKDF(resumptionSecret, labelResumption, ticketNonce1)
	resPsk2 = HKDF(resumptionSecret, labelResumption, ticketNonce2)
	nst1 = AEAD_ENC(sApTraffic, ticketNonce1, hdr)
	nst2 = AEAD_ENC(sApTraffic, ticketNonce2, hdr)
	generates appMsg2
	appData2 = AEAD_ENC(sApTraffic, appMsg2, hdr)
	keyUpdate = AEAD_ENC(sApTraffic, updateNotRequested, hdr)
	sApTraffic1 = HKDF(sApTraffic, labelTrafficUpd, nil)
	generates appMsg3
	appData3 = AEAD_ENC(sApTraffic1, appMsg3, hdr)
]

Server -> Client: nst1, nst2, appData2, keyUpdate, appData3

principal Client[
	ticketNonce1_c = AEAD_DEC(sApTraffic_c, nst1, hdr)?
	ticketNonce2_c = AEAD_DEC(sApTraffic_c, nst2, hdr)?
	resPsk1_c = HKDF(resumptionSecret_c, labelResumption, ticketNonce1_c)
	resPsk2_c = HKDF(resumptionSecret_c, labelResumption, ticketNonce2_c)
	appMsg2_c = AEAD_DEC(sApTraffic_c, appData2, hdr)?
	keyUpdate_c = AEAD_DEC(sApTraffic_c, keyUpdate, hdr)?
	_ = ASSERT(keyUpdate_c, updateNotRequested)?
	sApTraffic1_c = HKDF(sApTraffic_c, labelTrafficUpd, nil)
	appMsg3_c = AEAD_DEC(sApTraffic1_c, appData3, hdr)?
]

phase[1]

principal Server[
	leaks sigKey
]

principal Client[
	leaks clientSigKey
]

phase[2]

principal Server[
	leaks sApTraffic1, resPsk1
]

scenarios[
	Client[peerCert = serverCert]
	Client[peerCert = mallCert]
]

queries[
	confidentiality? sHsTraffic
	confidentiality? sHsTraffic[
		precondition[Server -> Client: appData2]
	]
	confidentiality? cHsTraffic_c[
		precondition[Client -> Server: clientFlight]
	]
	confidentiality? sApTraffic[
		precondition[Server -> Client: appData2]
	]
	confidentiality? cApTraffic_c[
		precondition[Client -> Server: clientFlight]
	]
	confidentiality? exporterSecret[
		precondition[Server -> Client: appData2]
	]
	equivalence? sApTraffic, sApTraffic_c[
		precondition[Server -> Client: appData2]
		precondition[Client -> Server: clientFlight]
	]
	confidentiality? appMsg1
	confidentiality? appMsg2
	confidentiality? appMsg3
	confidentiality? resPsk2
	confidentiality? clientId
	authentication? Server -> Client: serverFlight
	authentication? Client -> Server: clientFlight
	authentication? Client -> Server: appData1
	authentication? Server -> Client: appData2
	authentication? Server -> Client: appData3
	freshness? sApTraffic
	freshness? cApTraffic_c
]

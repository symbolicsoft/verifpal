attacker[active]
principal Alice[
	knows private sk
	pk = PUBKEY(sk)
	generates m
	s = SIGN(sk, m)
]
Alice -> Bob: [pk], m, s
principal Bob[
	_ = HASH(m)
]
Bob -> Carol: [m]
phase[1]
principal Bob[
	_ = SIGNVERIF(pk, m, s)?
]
principal Carol[
	h = HASH(m)
]
queries[
	authentication? Bob -> Carol: m
]
